		        if VM.Enabled then
		            local b = base[weld]
		            if not b then b = weld.C1; base[weld] = b end
		            weld.C1 = b * CFrame.new(-(VM.R - VM.L), -(VM.U - VM.D), -(VM.F - VM.B))
		        elseif base[weld] then

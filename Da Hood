-- shared state between the hook below and the Da Hood features further down (the FaZeWare code calls it _RG)
local DH = { tracer = nil }

do
	-- the game's log watcher: its connections to LogService.MessageOut get their reporting function neutered.
	-- remembered by function (getconnections hands out new connection objects on every call, so remembering those
	-- re-hooked the same function again every second), and only looked for every few seconds
	local seen = setmetatable({}, { __mode = "k" })
	local function neuter()
		pcall(function()
			for _, c in ipairs(getconnections(game:GetService("LogService").MessageOut)) do
				local fn = c.Function
				if type(fn) == "function" and not seen[fn] then
					seen[fn] = true
					local ok, ups = pcall(getupvalues, fn)
					ups = ok and ups or {}
					if #ups >= 9 and type(ups[9]) == "table" and type(ups[9][1]) == "function" then
						pcall(setupvalue, ups[9][1], 14, function() return function(d)
							if type(d) == "table" then
								for e = 1, 4 do
									local f = d[e]
									if type(f) == "userdata" and f.Disconnect then pcall(f.Disconnect, f) end
								end
							end
						end end)
						pcall(setupvalue, ups[9][1], 1, function() task.wait(200) end)
						pcall(hookfunction, ups[9][1], function() return {} end)
					end
				end
			end
		end)
	end
	if getconnections and getupvalues then
		neuter()
		task.spawn(function()
			while true do
				task.wait(3)
				neuter()
			end
		end)
	end

	local rs = game:GetService("ReplicatedStorage")
	local main = rs:WaitForChild("MainEvent", 30)
	local BLOCK = { CHECKER_1 = true, TeleportDetect = true, OneMoreTime = true, CHECKER_4 = true }
	if hookmetamethod and getnamecallmethod and main then
		-- the crash() check reads the calling script's environment: done once per script, not on every call it makes
		local checked = setmetatable({}, { __mode = "k" })
		local callingScript = getcallingscript
		local old
		old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			if self ~= main or getnamecallmethod() ~= "FireServer" then
				-- the game's crash() trap: swapped for a function that does nothing (same check FaZeWare does)
				if not checkcaller() then
					local scr
					if callingScript then
						local okc, r = pcall(callingScript)
						if okc and typeof(r) == "Instance" then scr = r end
					end
					if scr == nil or not checked[scr] then
						if scr ~= nil then checked[scr] = true end
						if getfenv(2).crash then
							local env = getfenv(2)
							env.crash = function() end
							setfenv(2, env)
						end
					end
				end
				return old(self, ...)
			end
			local args = table.pack(...)
			local name = args[1]
			if BLOCK[name] then return end
			if name == "ShootGun" then
				-- the shot keeps the muzzle position the gun script worked its aim out from (moving it to the root part
				-- bent every pellet's direction, which the server's spread check rejects at close range)
				-- csync strafe: the server thinks we are at the strafe spot, so the shot has to start there too
				if DH._CSyncActive and DH._CSyncRoot and DH._CSyncPos and typeof(args[3]) == "Vector3" then
					local delta = DH._CSyncPos - DH._CSyncRoot.Position
					if delta.Magnitude > 1 then args[3] = args[3] + delta end
				end
				local tracer = DH.tracer
				if tracer and typeof(args[3]) == "Vector3" and typeof(args[4]) == "Vector3" then
					task.spawn(pcall, tracer, args[3], args[4])
				end
			elseif name == "UpdateMousePosI2" and typeof(args[2]) == "Vector3" and DH._TA_ServerAimPos then
				-- server aim mode: the aim is the mouse position we report, so report the target's position
				local ok, p = pcall(DH._TA_ServerAimPos)
				if ok and p then args[2] = p end
			end
			return old(self, table.unpack(args, 1, args.n))
		end))
	end
end


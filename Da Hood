		        local now = os.clock()
		        if now - lastAmmoBuy > 6 and not B.Busy then
		            local entry = ammo[gun]
		            if entry and Money() >= entry.price then
		                lastAmmoBuy = now
		                BuyAmmo(entry, B.AmmoAmount)
		            end
		        end
		    end))

		    boxArmor:AddToggle('misc_auto_armour', { Text = 'auto armour', Default = false, Tooltip = 'Buys a new set of armour when yours is nearly gone.' })
		    library.Toggles.misc_auto_armour:OnChanged(function(V) B.ArmorAuto = V end)

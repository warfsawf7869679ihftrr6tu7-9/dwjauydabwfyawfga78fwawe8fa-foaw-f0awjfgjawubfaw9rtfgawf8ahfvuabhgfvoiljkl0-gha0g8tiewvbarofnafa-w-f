		if tool:GetAttribute("AureliaOrigTex") == nil then
			tool:SetAttribute("AureliaOrigTex", base:IsA("MeshPart") and base.TextureID or "")
			tool:SetAttribute("AureliaOrigTrans", base.Transparency)

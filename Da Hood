		    -- ---------- spawn vehicle: csync to the car spawner, use it, sit in the car, and end up back where we were ----------
		    local spawning = false
		    local function SpawnVehicleTrip()
		        if spawning then return end
		        local B = _RG._Buy
		        if B and B.Busy then return end
		        local char = lp.Character
		        local root = char and char:FindFirstChild('HumanoidRootPart')
		        local hum = char and char:FindFirstChildOfClass('Humanoid')
		        local spawner = workspace:FindFirstChild('VehicleSpawner')
		        if not root or not hum or hum.Health <= 0 or not spawner then
		            library:Notify('spawn vehicle: car spawner not found', 3)
		            return
		        end
		        if type(fireproximityprompt) ~= 'function' then
		            library:Notify('spawn vehicle: your executor has no fireproximityprompt', 4)
		            return
		        end
		        -- nearest spawner sign; every prompt on that part gets used, not just one
		        local bestPart, bestD
		        for _, d in ipairs(spawner:GetDescendants()) do
		            if d:IsA('ProximityPrompt') and d.Parent and d.Parent:IsA('BasePart') then
		                local dist = (d.Parent.Position - root.Position).Magnitude
		                if not bestD or dist < bestD then bestPart, bestD = d.Parent, dist end
		            end
		        end
		        if not bestPart then library:Notify('spawn vehicle: no spawner prompt found', 3) return end
		        local prompts = {}
		        for _, d in ipairs(bestPart:GetChildren()) do
		            if d:IsA('ProximityPrompt') then prompts[#prompts + 1] = d end
		        end

		        local origCF = root.CFrame
		        spawning = true
		        if B then B.Busy = true end
		        task.spawn(function()
		            local prevMode = _RG._CSyncReliable
		            _RG._CSyncReliable = true                    -- the server has to see us in the seat for it to sit us down
		            local vehicles = workspace:FindFirstChild('Vehicles')
		            local before = {}
		            if vehicles then for _, v in ipairs(vehicles:GetChildren()) do before[v] = true end end
		            -- a vehicle is named after its skin; its owner is stored in the VehicleOwner attribute
		            local function Mine()
		                vehicles = vehicles or workspace:FindFirstChild('Vehicles')
		                if not vehicles then return nil end
		                for _, v in ipairs(vehicles:GetChildren()) do
		                    if v:GetAttribute('VehicleOwner') == lp.Name then return v end
		                end
		                for _, v in ipairs(vehicles:GetChildren()) do
		                    if not before[v] then return v end
		                end
		            end
		            local stage = 'could not reach the spawner'
		            local ok = false
		            local drivenPart
		            pcall(function()
		                -- 1. csync to the spawner and hold its prompt for the real hold time, then ask for the vehicle
		                _RG._BuyPos = bestPart.Position + Vector3.new(0, 3, 0)
		                _RG._BuyUntil = os.clock() + 25
		                RunService.Heartbeat:Wait()
		                stage = 'the spawner did nothing (not enough money, or the prompt is not what spawns it)'
		                local t0, sent = os.clock(), 0
		                while os.clock() - t0 < 9 and not Mine() do
		                    for _, pr in ipairs(prompts) do
		                        pr.Enabled = true
		                        local hd = pr.HoldDuration
		                        pcall(fireproximityprompt, pr)
		                        pcall(function() pr:InputHoldBegin() end)
		                        task.wait(math.max(hd, 0) + 0.2)
		                        pcall(function() pr:InputHoldEnd() end)
		                    end
		                    if sent < 3 then
		                        sent = sent + 1
		                        mainEvent = mainEvent or ReplicatedStorage:FindFirstChild('MainEvent')
		                        if mainEvent then mainEvent:FireServer('SpawnVehicle') end
		                    end
		                    task.wait(0.2)
		                end
		                local veh = Mine()
		                if not veh then return end

		                -- 2. csync onto the vehicle and use its door prompt until we are the driver
		                stage = 'the vehicle spawned but getting in did not work'
		                local vpart = veh:IsA('BasePart') and veh or veh.PrimaryPart or veh:FindFirstChildWhichIsA('BasePart')
		                if not vpart then return end
		                drivenPart = vpart
		                local doors = {}
		                for _, d in ipairs(veh:GetDescendants()) do
		                    if d:IsA('ProximityPrompt') then doors[#doors + 1] = d end
		                end
		                local function Driving()
		                    if hum.SeatPart ~= nil then return true end
		                    local dv = veh:FindFirstChild('Driver')
		                    local v = dv and dv.Value
		                    if v == nil then return false end
		                    return v == lp or v == lp.Character or (typeof(v) == 'Instance' and lp.Character ~= nil and v:IsDescendantOf(lp.Character))
		                end
		                local t1 = os.clock()
		                while os.clock() - t1 < 9 and not Driving() do
		                    _RG._BuyPos = vpart.Position + Vector3.new(0, 2, 0)
		                    for _, pr in ipairs(doors) do
		                        pr.Enabled = true
		                        local hd = pr.HoldDuration
		                        pcall(fireproximityprompt, pr)
		                        pcall(function() pr:InputHoldBegin() end)
		                        task.wait(math.max(hd, 0) + 0.15)
		                        pcall(function() pr:InputHoldEnd() end)
		                    end
		                    task.wait(0.1)
		                end
		                ok = Driving()
		            end)
		            -- 3. csync released: the restore puts us back where we started, and the seat weld brings the car along
		            _RG._BuyUntil = 0
		            _RG._CSyncReliable = prevMode
		            task.wait(0.15)
		            if ok and drivenPart and drivenPart.Parent then
		                -- bring the vehicle (with us in it) back to where we stood when the button was pressed
		                for _ = 1, 10 do
		                    pcall(function() drivenPart.CFrame = origCF + Vector3.new(0, 2, 0) end)
		                    RunService.Heartbeat:Wait()
		                end
		            end
		            if B then B.Busy = false end
		            spawning = false
		            library:Notify(ok and 'spawn vehicle: done, you are in your car' or ('spawn vehicle: ' .. stage), 4)
		        end)
		    end
		    mb:AddButton({ Text = 'spawn vehicle', Func = SpawnVehicleTrip })

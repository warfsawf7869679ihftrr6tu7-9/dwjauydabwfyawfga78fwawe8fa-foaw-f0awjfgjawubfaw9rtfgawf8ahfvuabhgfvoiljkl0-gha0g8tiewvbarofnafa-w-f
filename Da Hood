	local title = function(s)
		s = tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")
		return (s:gsub("(%a[%w']*)", function(w)
			local up = UPPER[w:lower()]
			if up then return up end
			if w:match("^%l") then return w:sub(1, 1):upper() .. w:sub(2) end

		-- ============================================================
		-- legit: fov (drawing) + silent aim + target hud
		-- ============================================================
		do
		    local Players          = game:GetService('Players')
		    local RunService       = game:GetService('RunService')
		    local UserInputService = game:GetService('UserInputService')
		    local lp               = Players.LocalPlayer
		    local DR               = _RG._ESPDraw
		    local C                = Color3.fromRGB
		    local BLACK, WHITE     = C(0, 0, 0), C(255, 255, 255)

		    -- ---------- fov: the Rivals legitbot circles, one for aimbot and one for silent aim ----------
		    -- the size slider sits in each box, everything about the look is in that toggle's >> menu
		    local fovGui = Instance.new('ScreenGui')
		    fovGui.Name = 'AureliaLegitFOV'
		    fovGui.DisplayOrder = 990
		    fovGui.ResetOnSpawn = false
		    fovGui.IgnoreGuiInset = true
		    fovGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		    pcall(function() fovGui.Parent = (gethui and gethui()) or game:GetService('CoreGui') end)
		    if not fovGui.Parent then fovGui.Parent = game:GetService('CoreGui') end

		    local function round(inst)
		        local c = Instance.new('UICorner')
		        c.CornerRadius = UDim.new(1, 0)
		        c.Parent = inst
		    end
		    local function NewCfg()
		        return {
		            show = false, c1 = WHITE, c2 = WHITE, thick = 1.5, alpha = 0, fillOn = false, fill1 = WHITE, fill2 = BLACK,
		            fillAlpha = 0.7, spin = false, spinSpeed = 1, fillAnim = false, glowOn = false, glowColor = C(57, 114, 236),
		            glowOpacity = 0.5, pos = 'Mouse',
		        }
		    end
		    local function BuildFov()
		        local container = Instance.new('Frame')
		        container.AnchorPoint = Vector2.new(0.5, 0.5)
		        container.BackgroundTransparency = 1
		        container.BorderSizePixel = 0
		        container.Visible = false
		        container.Parent = fovGui

		        local glowImg = Instance.new('ImageLabel')
		        glowImg.AnchorPoint = Vector2.new(0.5, 0.5)
		        glowImg.Position = UDim2.new(0.5, 0, 0.5, 0)
		        glowImg.Size = UDim2.new(1, 24, 1, 24)
		        glowImg.BackgroundTransparency = 1
		        glowImg.Image = 'rbxassetid://110204605000367'
		        glowImg.ScaleType = Enum.ScaleType.Slice
		        glowImg.SliceCenter = Rect.new(Vector2.new(21, 21), Vector2.new(79, 79))
		        glowImg.ImageTransparency = 1
		        glowImg.ZIndex = 0
		        glowImg.Visible = false
		        glowImg.Parent = container

		        local fill = Instance.new('Frame')
		        fill.Size = UDim2.new(1, 0, 1, 0)
		        fill.BackgroundColor3 = WHITE
		        fill.BorderSizePixel = 0
		        fill.Visible = false
		        fill.ZIndex = 1
		        fill.Parent = container
		        round(fill)
		        local fillGrad = Instance.new('UIGradient')
		        fillGrad.Parent = fill

		        local outline = Instance.new('Frame')
		        outline.Size = UDim2.new(1, 0, 1, 0)
		        outline.BackgroundTransparency = 1
		        outline.BorderSizePixel = 0
		        outline.ZIndex = 2
		        outline.Parent = container
		        round(outline)
		        local stroke = Instance.new('UIStroke')
		        stroke.Color = WHITE
		        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		        stroke.Parent = outline
		        local strokeGrad = Instance.new('UIGradient')
		        strokeGrad.Parent = stroke

		        local shadow
		        pcall(function()
		            shadow = Instance.new('UIShadow')
		            shadow.Enabled = false
		            shadow.BlurRadius = UDim.new(0.45, 0)
		            shadow.Spread = UDim2.new(0.15, 0, 0.15, 0)
		            shadow.ZIndex = -1
		            shadow.Parent = outline
		        end)

		        local function ring(size, z)
		            local r = Instance.new('Frame')
		            r.Size = size
		            r.Position = UDim2.new(0.5, 0, 0.5, 0)
		            r.AnchorPoint = Vector2.new(0.5, 0.5)
		            r.BackgroundTransparency = 1
		            r.BorderSizePixel = 0
		            r.ZIndex = z
		            r.Parent = container
		            round(r)
		            local s = Instance.new('UIStroke')
		            s.Color = BLACK
		            s.Thickness = 1
		            s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		            s.Parent = r
		        end
		        ring(UDim2.new(1, 2, 1, 2), 1)
		        ring(UDim2.new(1, -2, 1, -2), 3)
		        return {
		            container = container, fill = fill, fillGrad = fillGrad, stroke = stroke, strokeGrad = strokeGrad,
		            glowImg = glowImg, shadow = shadow, dirty = true, shown = false, x = -1, y = -1, r = -1,
		        }
		    end
		    local function ApplyFov(fov, cfg)
		        fov.strokeGrad.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, cfg.c1), ColorSequenceKeypoint.new(1, cfg.c2) })
		        fov.fillGrad.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, cfg.fill1), ColorSequenceKeypoint.new(1, cfg.fill2) })
		        fov.stroke.Thickness, fov.stroke.Transparency = cfg.thick, cfg.alpha
		        fov.fill.Visible = cfg.fillOn
		        fov.fill.BackgroundTransparency = cfg.fillAlpha
		        if fov.shadow then
		            fov.shadow.Enabled = cfg.glowOn
		            fov.shadow.Color = cfg.glowColor
		            fov.shadow.Transparency = 1 - cfg.glowOpacity
		            fov.glowImg.Visible = false
		        else
		            fov.glowImg.Visible = cfg.glowOn
		            fov.glowImg.ImageColor3 = cfg.glowColor
		            fov.glowImg.ImageTransparency = 1 - cfg.glowOpacity
		        end
		        fov.dirty = false
		    end

		    local aimCfg, silCfg = NewCfg(), NewCfg()
		    local aimFov, silFov = BuildFov(), BuildFov()
		    local AIMF, SILF = { Radius = 150 }, { Radius = 150 }

		    local function Center(cfg)
		        local cam = workspace.CurrentCamera
		        if cfg.pos == 'Centre' and cam then
		            return Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
		        elseif cfg.pos == 'Muzzle' and cam then
		            local char = lp.Character
		            local tool = char and char:FindFirstChildOfClass('Tool')
		            local handle = tool and (tool:FindFirstChild('Handle') or tool:FindFirstChildWhichIsA('BasePart'))
		            if handle then
		                local sp, on = cam:WorldToViewportPoint(handle.Position)
		                if on and sp.Z > 0 then return Vector2.new(sp.X, sp.Y) end
		            end
		        end
		        return UserInputService:GetMouseLocation()
		    end
		    _RG._FovFor = function(which)
		        if which == 'aim' then return AIMF, Center(aimCfg) end
		        return SILF, Center(silCfg)
		    end
		    _RG._Fov = SILF
		    _RG._FovCenter = function() return Center(silCfg) end
		    _RG._FovSet = function(which, r)
		        if which == 'aim' then AIMF.Radius = r else SILF.Radius = r end
		    end

		    local function UpdateFov(fov, cfg, radius, wanted)
		        if not wanted then
		            if fov.shown then fov.shown = false; fov.container.Visible = false end
		            return
		        end
		        if not fov.shown then fov.shown = true; fov.container.Visible = true; fov.dirty = true end
		        if fov.dirty then ApplyFov(fov, cfg) end
		        if cfg.spin then fov.strokeGrad.Rotation = (fov.strokeGrad.Rotation + cfg.spinSpeed) % 360 end
		        if cfg.fillAnim then fov.fillGrad.Rotation = (fov.fillGrad.Rotation + cfg.spinSpeed) % 360 end
		        local c = Center(cfg)
		        if math.abs(c.X - fov.x) > 0.4 or math.abs(c.Y - fov.y) > 0.4 or radius ~= fov.r then
		            fov.x, fov.y, fov.r = c.X, c.Y, radius
		            fov.container.Position = UDim2.fromOffset(c.X, c.Y)
		            fov.container.Size = UDim2.fromOffset(radius * 2, radius * 2)
		        end
		    end
		    RunService.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function()
		        local abT = library.Toggles.aimbot_enabled
		        local aimWanted = abT ~= nil and abT.Value and aimCfg.show
		        local silWanted = _RG._SilentAim.Enabled and silCfg.show
		        if aimWanted or aimFov.shown then UpdateFov(aimFov, aimCfg, AIMF.Radius, aimWanted) end
		        if silWanted or silFov.shown then UpdateFov(silFov, silCfg, SILF.Radius, silWanted) end
		    end))

		    -- the look of one circle, drawn into its toggle's >> menu (the same rows as the Rivals legitbot)
		    local function FovPanel(p, prefix, cfg, fov)
		        local f = 'dh_' .. prefix
		        p:toggle({ name = 'Show FOV', flag = f .. '_showfov', callback = function(on) cfg.show = on end })
		            :addcolor(cfg.c1, f .. '_c1', function(c) cfg.c1 = c; fov.dirty = true end)
		            :addcolor(cfg.c2, f .. '_c2', function(c) cfg.c2 = c; fov.dirty = true end)
		        p:dropdown({ name = 'Position', flag = f .. '_pos', options = { 'Mouse', 'Centre', 'Muzzle' }, default = 'Mouse', callback = function(v) cfg.pos = v end })
		        p:slider({ name = 'Outline Thickness', flag = f .. '_thick', min = 0.5, max = 5, step = 0.1, default = 1.5, callback = function(v) cfg.thick = v; fov.dirty = true end })
		        p:slider({ name = 'Outline Alpha', flag = f .. '_alpha', min = 0, max = 1, step = 0.01, default = 0, callback = function(v) cfg.alpha = v; fov.dirty = true end })
		        p:toggle({ name = 'Spin', flag = f .. '_spin', callback = function(on)
		            cfg.spin = on
		            if not on then fov.strokeGrad.Rotation = 0 end
		        end })
		        p:slider({ name = 'Spin Speed', flag = f .. '_spinspeed', min = 0.1, max = 10, step = 0.1, default = 1, callback = function(v) cfg.spinSpeed = v end })
		        p:toggle({ name = 'FOV Fill', flag = f .. '_fill', callback = function(on)
		            cfg.fillOn = on
		            fov.fill.Visible = on and fov.shown
		            fov.dirty = true
		        end })
		            :addcolor(cfg.fill1, f .. '_fill1', function(c) cfg.fill1 = c; fov.dirty = true end)
		            :addcolor(cfg.fill2, f .. '_fill2', function(c) cfg.fill2 = c; fov.dirty = true end)
		        p:slider({ name = 'Fill Alpha', flag = f .. '_fillalpha', min = 0, max = 1, step = 0.01, default = 0.7, callback = function(v) cfg.fillAlpha = v; fov.dirty = true end })
		        p:toggle({ name = 'Animated Fill', flag = f .. '_fillanim', callback = function(on)
		            cfg.fillAnim = on
		            if not on then fov.fillGrad.Rotation = 0 end
		        end })
		        p:toggle({ name = 'FOV Glow', flag = f .. '_glow', callback = function(on) cfg.glowOn = on; fov.dirty = true end })
		            :addcolor(cfg.glowColor, f .. '_glowcolor', function(c) cfg.glowColor = c; fov.dirty = true end)
		        p:slider({ name = 'Glow Opacity', flag = f .. '_glowop', min = 0, max = 1, step = 0.01, default = 0.5, callback = function(v) cfg.glowOpacity = v; fov.dirty = true end })
		    end
		    library.panelExtra.aimbot_enabled = function(p) FovPanel(p, 'aim', aimCfg, aimFov) end
		    library.panelExtra.silent_aim_enabled = function(p) FovPanel(p, 'silent', silCfg, silFov) end

		    -- the open menu's rectangle (read by the esp and the fov so they stay out from under it)
		    _RG._Menu = { on = false, x1 = 0, y1 = 0, x2 = 0, y2 = 0 }
		    RunService.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function()
		        local M, mf = _RG._Menu, library.MainFrame
		        if library.Visible and mf and mf.Parent then
		            local ap, sz = mf.AbsolutePosition, mf.AbsoluteSize
		            -- the gui is inset by the top bar, drawings are not
		            local inset = game:GetService('GuiService'):GetGuiInset()
		            M.on, M.x1, M.y1, M.x2, M.y2 = true, ap.X, ap.Y + inset.Y, ap.X + sz.X, ap.Y + sz.Y + inset.Y
		        else
		            M.on = false
		        end
		    end))

		    -- ---------- ui ----------
		    -- ---------- aimbot: uses the same fov (radius + position) as silent aim ----------
		    local AB = {
		        Smooth = 60, XS = 10, YS = 10, HitPart = 'UpperTorso', RandomPart = false,
		        Sticky = true, Prediction = true, Deadzone = 1, MaxSpeed = 0,
		        cur = nil, rollAt = 0, rollName = nil,
		    }
		    _RG._Aimbot = AB
		    local AbParts = { 'Head', 'UpperTorso', 'LowerTorso', 'HumanoidRootPart', 'LeftUpperArm', 'RightUpperArm', 'LeftLowerArm', 'RightLowerArm', 'LeftUpperLeg', 'RightUpperLeg', 'LeftFoot', 'RightFoot' }

		    local function AbArmed()
		        local T, K = library.Toggles.aimbot_enabled, library.Options.aimbot_key
		        if not T or not T.Value then return false end
		        local kv = K.Value
		        local hasKey = kv ~= nil and kv ~= '...' and kv ~= 'None'
		        if hasKey then return K:GetState() end
		        return true
		    end

		    RunService.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function(dt)
		        if not AbArmed() then AB.cur = nil; return end
		        local cam = workspace.CurrentCamera
		        local fov, center = _RG._FovFor('aim')
		        if not cam or not center then return end

		        -- keep the current target while it is still valid and inside the fov (sticky), otherwise pick a new one
		        local char = AB.cur
		        if char then
		            local hrp = char:FindFirstChild('HumanoidRootPart')
		            local hum = char:FindFirstChildOfClass('Humanoid')
		            local pl = Players:GetPlayerFromCharacter(char)
		            local ok = AB.Sticky and hrp ~= nil and hum ~= nil and hum.Health > 0 and pl ~= nil
		                and _RG._TA_PassesChecks(pl, char, hrp)
		            if ok then
		                local sp, on = cam:WorldToViewportPoint(hrp.Position)
		                ok = on and sp.Z > 0 and (Vector2.new(sp.X, sp.Y) - center).Magnitude <= fov.Radius * 1.5
		            end
		            if not ok then char = nil end
		        end
		        if not char then char = _RG._SilentTarget('aim') end
		        AB.cur = char
		        if not char then return end
		        _RG._AimbotTarget = { char = char, t = os.clock() }

		        -- which part: the chosen one, or a random one that is re-rolled every 0.6s
		        local name = AB.HitPart
		        if AB.RandomPart then
		            if os.clock() - AB.rollAt > 0.6 or not AB.rollName then
		                AB.rollAt, AB.rollName = os.clock(), AbParts[math.random(1, #AbParts)]
		            end
		            name = AB.rollName
		        end
		        local part = char:FindFirstChild(name) or char:FindFirstChild('UpperTorso') or char:FindFirstChild('HumanoidRootPart')
		        if not part then return end
		        local pos = part.Position
		        if AB.Prediction then
		            local tv = _RG._TA_Velocity(char, part)
		            if tv.Magnitude > 2 and tv.Magnitude < 250 then
		                pos = pos + _RG._TA_Predict(char, part, _RG._TA_Lead() * ((_RG._TargetAim and _RG._TargetAim.Prediction) or 0.5))
		            end
		        end
		        local sp, on = cam:WorldToViewportPoint(pos)
		        if not on or sp.Z <= 0 then return end

		        local cursor = UserInputService:GetMouseLocation()
		        local dx, dy = sp.X - cursor.X, sp.Y - cursor.Y
		        if math.sqrt(dx * dx + dy * dy) < AB.Deadzone then return end


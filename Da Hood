		        local root = me and me:FindFirstChild('HumanoidRootPart')
		        if not root then return nil end
		        local TA = _RG._TargetAim
		        local forced = _RG._Forced
		        local rage = forced ~= nil and forced.char ~= nil and forced.char.Parent ~= nil and (os.clock() - forced.t) < 0.3
		        local target, cfg, src
		        if rage then
		            target, src = forced.char, 'rage'
		        elseif TA.Enabled and TA.LockedTarget and TA.LockedTarget.Parent then
		            target, cfg, src = TA.LockedTarget, TA, 'ta'
		        elseif _RG._SilentAim.Enabled then
		            target, cfg, src = _RG._SilentTarget('silent'), _RG._SilentAim, 'silent'
		        end
		        local M = _RG._Mods
		        if not target and M and M.NoSpread then
		            target, src = _NearMouse(160), 'spread'
		        end
		        if not target or not target.Parent then return nil end
		        if target:FindFirstChildOfClass('ForceField') or _TA_IsKnocked(target) then return nil end     -- built in: never at spawn protection or a knocked body
		        local hum = target:FindFirstChildOfClass('Humanoid')
		        if not hum or hum.Health <= 0 then return nil end

		        local part
		        if rage then
		            part = target:FindFirstChild(forced.part or 'UpperTorso')
		        elseif src == 'spread' then
		            part = target:FindFirstChild('UpperTorso')
		        else
		            part = _TA_ResolvePart(target, cfg)
		        end
		        part = part or target:FindFirstChild('UpperTorso') or target:FindFirstChild('Torso') or target:FindFirstChild('HumanoidRootPart')
		        if not part then return nil end

		        local tool = me:FindFirstChildOfClass('Tool')
		        local range = _RG._GunRange(tool)
		        local pos = part.Position
		        local resolved = _RG._TA_Resolved(target)
		        local hrpT = target:FindFirstChild('HumanoidRootPart')
		        if resolved and hrpT then pos = pos + (resolved - hrpT.Position) end
		        -- past the gun's own range the shot is left alone: the game's limit, nothing is stretched
		        if (pos - root.Position).Magnitude - part.Size.Magnitude * 0.5 > range + 3 then return nil end

		        local plan = { char = target, part = part, pos = pos, range = range, src = src }
		        local isShotgun = tool ~= nil and _SpreadScale[tool.Name] ~= nil
		        plan.fit = isShotgun and (src == 'rage' or src == 'spread' or _RG._TANoSpread or (M and M.NoSpread)) or false
		        plan.magic = src == 'silent' and _RG._SilentAim.Magic and not isShotgun

		        -- kill aura / sentry use their own hit chance (so they are not a perfect 100% either), no spread always hits
		        local chance = src == 'spread' and 100 or (src == 'rage' and ((forced and forced.chance) or (_RG._Rage and _RG._Rage.HitChance) or 100)) or (cfg.HitChance or 100)
		        if chance < 100 and not (chance > 0 and math.random() * 100 < chance) then
		            -- miss: aim a few studs beside the target
		            local fwd = (pos - root.Position).Unit
		            local side = fwd:Cross(Vector3.yAxis)
		            if side.Magnitude < 0.01 then side = fwd:Cross(Vector3.xAxis) end
		            side = side.Unit
		            local up = side:Cross(fwd).Unit
		            local a = math.random() * math.pi * 2
		            plan.pos = pos + (side * math.cos(a) + up * math.sin(a)) * (3.5 + math.random() * 2.5)
		            plan.fit, plan.magic, plan.miss = false, false, true
		        else
		            _RG._LastTAPart = { char = target, name = part.Name, t = os.clock() }
		        end
		        return plan
		    end
		    local planFrame, planCache = -1, nil
		    local function _ShotPlan()
		        if planFrame ~= frameNo then
		            planFrame = frameNo
		            local ok, p = pcall(_BuildPlan)
		            planCache = ok and p or nil
		        end
		        return planCache
		    end
		    _RG._ShotPlan = _ShotPlan

		    -- how many pellets of this volley hit the target when the pattern is centred on `base`
		    local fitParams = RaycastParams.new()
		    fitParams.FilterType = Enum.RaycastFilterType.Include
		    local function _PelletHits(origin, base, offsets, plan)
		        local n = 0
		        for i = 1, #offsets do
		            local off = offsets[i]
		            if typeof(off) == 'Vector3' then
		                if workspace:Raycast(origin, (base + off).Unit * plan.range, fitParams) then n = n + 1 end
		            end
		        end
		        return n
		    end
		    local function _BestBase(origin, u, offsets, plan)
		        fitParams.FilterDescendantsInstances = { plan.char }
		        local mean = Vector3.zero
		        for i = 1, #offsets do mean = mean + offsets[i] end
		        mean = mean / math.max(#offsets, 1)
		        local best, bestN = (u - mean).Unit, -1
		        bestN = _PelletHits(origin, best, offsets, plan)
		        if bestN >= #offsets then return best end
		        -- one pellet dead on the part each time, keep whichever placement lands the most
		        for i = 1, #offsets do
		            local cand = (u - offsets[i]).Unit
		            -- two pellets sharing the middle of the part works better than one dead on and the rest wide
		            for j = i + 1, #offsets do
		                local mid = ((u - offsets[i]) + (u - offsets[j])).Unit
		                local nm = _PelletHits(origin, mid, offsets, plan)
		                if nm > bestN then best, bestN = mid, nm end
		            end
		            if bestN >= #offsets then return best end
		            local n = _PelletHits(origin, cand, offsets, plan)
		            if n > bestN then best, bestN = cand, n end
		        end
		        return best
		    end

		    local function Rebuild(args, aimPos, hit, range, normal)
		        return {
		            Shooter      = args.Shooter,
		            Handle       = args.Handle,
		            ForcedOrigin = args.ForcedOrigin,
		            AimPosition  = aimPos,
		            Hit          = hit,
		            Normal       = hit and (normal or Vector3.new(0, 1, 0)) or nil,
		            Range        = range,
		            IsLeftHand   = args.IsLeftHand,
		            isReflecting = args.isReflecting,
		            TrailOnly    = args.TrailOnly,
		        }
		    end

		    local function _TryHookGun()
		        if _GunHooked then return end
		        local ok, gh = pcall(function()
		            return require(ReplicatedStorage:WaitForChild('Modules', 5):WaitForChild('GunHandler', 5))
		        end)
		        if not ok or type(gh) ~= 'table' or type(gh.getAim) ~= 'function' or type(gh.shoot) ~= 'function' then return end
		        _GunHandler = gh
		        _GunHooked  = true

		        pcall(function()
		            local sm = ReplicatedStorage.Modules.GunHandler:FindFirstChild('Spread')
		            local m = sm and require(sm)
		            if m and type(m.Scale) == 'table' then _SpreadScale = m.Scale end
		        end)

		        local origAim, origSpread = gh.getAim, gh.shotgunSpread
		        _OrigShoot = gh.shoot
		        local volley = nil     -- the pellet offsets the game just rolled for this shot (it asks for them before the aim)

		        if type(origSpread) == 'function' then
		            gh.shotgunSpread = function(...)
		                local offsets, counter = origSpread(...)
		                -- full no spread: the counter still advances like normal, but every pellet goes dead straight
		                local M = _RG._Mods
		                if M and M.NoSpread and M.Full and type(offsets) == 'table' then
		                    local flat = {}
		                    for i = 1, #offsets do flat[i] = Vector3.zero end
		                    offsets = flat
		                end
		                volley =type(offsets) == 'table' and { offsets = offsets, t = os.clock(), base = nil } or nil
		                return offsets, counter
		            end
		        end

		        gh.getAim = function(origin, range, ...)
		            local d, m = origAim(origin, range, ...)
		            if typeof(origin) ~= 'Vector3' then return d, m end
		            local plan = _ShotPlan()
		            if not plan then return d, m end
		            local to = plan.pos - origin
		            if to.Magnitude < 0.05 then return d, m end
		            local u = to.Unit
		            local v = volley
		            if plan.fit and v and os.clock() - v.t < 0.05 then
		                if not v.base then
		                    local okb, b = pcall(_BestBase, origin, u, v.offsets, plan)
		                    v.base = okb and b or u
		                end
		                u = v.base
		            end
		            return u, to.Magnitude
		        end

		        gh.shoot = function(args)
		            if type(args) ~= 'table' or args.ReplicatedShot then return _OrigShoot(args) end
		            local lp = Players.LocalPlayer
		            if args.Shooter ~= lp.Character then return _OrigShoot(args) end
		            -- any local shot: keep the rep desync synced for a moment so the server sees where the shot comes from
		            _RG._DesyncPauseUntil = os.clock() + 0.5
		            -- magic bullet (silent aim, not shotguns): a wall between the muzzle and the part does not stop the hit
		            local plan = _ShotPlan()
		            if plan and plan.magic and not args.Hit and not args.IsLeftHand then
		                local muzzle = args.ForcedOrigin or (args.Handle and args.Handle:FindFirstChild('Muzzle') and args.Handle.Muzzle.WorldPosition)
		                if muzzle and _RG._LOS(muzzle, plan.part.Position, plan.char) then
		                    local rp = RaycastParams.new()
		                    rp.FilterType = Enum.RaycastFilterType.Include
		                    rp.FilterDescendantsInstances = { plan.part }
		                    local to = plan.part.Position - muzzle
		                    local res = workspace:Raycast(muzzle, to.Unit * (to.Magnitude + 3), rp)
		                    local range = args.Range or plan.range
		                    if res and (res.Position - muzzle).Magnitude <= range then
		                        args = Rebuild(args, res.Position, plan.part, range, res.Normal)
		                    end
		                end
		            end
		            return _OrigShoot(args)
		        end
		    end
		    _RG._TryHookGun = _TryHookGun

		    -- pulling the trigger for auto fire / kill aura / sentry / triggerbot. semi-auto guns get a click; automatic guns
		    -- are held down while shots keep being asked for (a click that is released in the same frame never fires them)
		    local held = {}
		    _RG._Pull = function(tool)
		        if not tool then return end
		        if tool:FindFirstChild('GunClientAutomatic') then
		            if not held[tool] then pcall(function() tool:Activate() end) end
		            held[tool] = os.clock() + 0.3
		        else
		            pcall(function() tool:Activate() end)
		            pcall(function() tool:Deactivate() end)
		        end
		    end
		    -- let go of every held trigger right now (an automatic gun kept firing for up to 0.3s after its target went down)
		    _RG._Release = function()
		        for tool in pairs(held) do
		            held[tool] = nil
		            pcall(function() tool:Deactivate() end)
		        end
		    end
		    RunService.Heartbeat:Connect(function()
		        if next(held) == nil then return end
		        local now = os.clock()
		        local char = Players.LocalPlayer.Character
		        for tool, t in pairs(held) do
		            if now > t or tool.Parent ~= char then
		                held[tool] = nil
		                pcall(function() tool:Deactivate() end)
		            end
		        end
		    end)

		    -- try immediately, retry if modules not loaded yet
		    task.spawn(function()
		        task.wait(2)
		        _TryHookGun()
		    end)

		    -- ── target locking ──────────────────────────────────────
		    local _TA_PassesChecks = LPH_NO_VIRTUALIZE(function(player, char, hrp, skipDistance, skipWall)
		        -- whitelist check
		        if _RG._TAChecks.Whitelist[player.Name] then return false end

		        -- knocked / grabbed checks (da hood BodyEffects)
		        if _RG._TAChecks.KnockedCheck and _TA_IsKnocked(char) then return false end
		        if _RG._TAChecks.GrabbedCheck and _TA_IsGrabbed(char) then return false end
		        if char:FindFirstChildOfClass('ForceField') then return false end     -- built in: spawn protection can't be hurt anyway
		        if (_RG._TAChecks.CrewCheck or _RG._TAChecks.FriendCheck) and _RG._TA_IsFriendly(player) then return false end

		        -- distance check
		        local lp    = Players.LocalPlayer
		        local lchar = lp and lp.Character
		        local lhrp  = lchar and lchar:FindFirstChild('HumanoidRootPart')
		        if lhrp and not skipDistance then
		            local dist = (hrp.Position - lhrp.Position).Magnitude
		            if dist > _RG._TAChecks.MaxDistance then return false end
		        end

		        -- wall check
		        if _RG._TAChecks.WallCheck and lhrp and not skipWall then
		            local origin    = lhrp.Position
		            local direction = hrp.Position - origin
		            local params    = RaycastParams.new()
		            params.FilterDescendantsInstances = { lchar, char }
		            params.FilterType = Enum.RaycastFilterType.Exclude
		            local result = (_RG._LOS(origin, hrp.Position, char) and true or nil)   -- same solid-only check the shots use, so an invisible or non-solid part no longer counts as a wall
		            if result then
		                -- something is between us and the target
		                return false
		            end
		        end

		        return true
		    end)

		    _RG._TA_PassesChecks = _TA_PassesChecks

		    _RG._TA_ResolvePart = _TA_ResolvePart
		    _RG._TA_Lead = _TA_Lead

		    -- the target the visuals show: the target aim lock, the aimbot target, or (silent aim on) whoever is inside the fov
		    local visCache, visAt = nil, 0
		    _RG._VisualTarget = LPH_NO_VIRTUALIZE(function()
		        local t = _RG._TargetAim.LockedTarget
		        if t and t.Parent then return t end
		        local ab = _RG._AimbotTarget
		        if ab and ab.char and ab.char.Parent and os.clock() - ab.t < 0.3 then return ab.char end
		        if _RG._SilentAim.Enabled and _RG._SilentTarget then
		            local now = os.clock()
		            if now - visAt > 0.1 then
		                visAt = now
		                visCache = _RG._SilentTarget()
		            end
		            return visCache
		        end
		        return nil
		    end)

		    -- silent aim target: the player closest to the middle of the fov that passes every check
		    _RG._SilentTarget = LPH_NO_VIRTUALIZE(function(which)
		        local fov, center
		        if _RG._FovFor then fov, center = _RG._FovFor(which) end
		        local cam = workspace.CurrentCamera
		        if not fov or not center or not cam then return nil end
		        local lp = Players.LocalPlayer
		        local best, bestD = nil, fov.Radius
		        for _, pl in ipairs(Players:GetPlayers()) do
		            if pl ~= lp then
		                local char = pl.Character
		                local hrp = char and char:FindFirstChild('HumanoidRootPart')
		                local hum = char and char:FindFirstChildOfClass('Humanoid')
		                if hrp and hum and hum.Health > 0 then
		                    local sp, on = cam:WorldToViewportPoint(hrp.Position)
		                    if on and sp.Z > 0 then
		                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
		                        if d < bestD and _TA_PassesChecks(pl, char, hrp, nil, _RG._SilentAim.Magic) then best, bestD = char, d end
		                    end
		                end
		            end
		        end
		        return best
		    end)

		    -- crew mates (same DataFolder.Information.Crew) and roblox friends, for the crew check / friend check
		    local friendCache = {}
		    local function CrewOf(pl)
		        local df = pl:FindFirstChild('DataFolder')
		        local info = df and df:FindFirstChild('Information')
		        local cr = info and info:FindFirstChild('Crew')
		        local v = cr and tonumber(cr.Value)
		        return (v and v > 0) and v or nil
		    end
		    _RG._TA_IsFriendly = function(pl)
		        local checks = _RG._TAChecks
		        if checks.CrewCheck then
		            local mine = CrewOf(Players.LocalPlayer)
		            if mine and CrewOf(pl) == mine then return true end
		        end
		        if checks.FriendCheck then
		            local known = friendCache[pl.UserId]
		            if known == nil then
		                friendCache[pl.UserId] = false
		                task.spawn(function()
		                    local ok, res = pcall(Players.LocalPlayer.IsFriendsWith, Players.LocalPlayer, pl.UserId)
		                    friendCache[pl.UserId] = ok and res == true
		                end)
		            elseif known then
		                return true
		            end
		        end
		        return false
		    end

		    local function _TA_PickNearest()
		        local cam = workspace.CurrentCamera
		        local mousePos = UserInputService:GetMouseLocation()
		        local mx, my = mousePos.X, mousePos.Y
		        local best, bestDist = nil, math.huge
		        local lp = Players.LocalPlayer
		        for _, player in ipairs(Players:GetPlayers()) do
		            if player == lp then continue end
		            local char = player.Character
		            if not char then continue end
		            local hrp = char:FindFirstChild('HumanoidRootPart')
		            local hum = char:FindFirstChildOfClass('Humanoid')
		            if not hrp or not hum or hum.Health <= 0 then continue end
		            if not _TA_PassesChecks(player, char, hrp) then continue end
		            local sp, on = cam:WorldToViewportPoint(hrp.Position)
		            if not on or sp.Z < 0 then continue end
		            local d = math.sqrt((sp.X - mx)^2 + (sp.Y - my)^2)
		            if d < bestDist then bestDist = d; best = char end
		        end
		        return best
		    end

		    local _lockConns = {}
		    local function _TA_ClearLock()
		        for _, c in ipairs(_lockConns) do pcall(c.Disconnect, c) end
		        table.clear(_lockConns)
		        _RG._TargetAim.LockedTarget = nil
		    end

		    local function _TA_Lock(char)
		        _TA_ClearLock()
		        _RG._TargetAim.LockedTarget = char
		        local hum = char:FindFirstChildOfClass('Humanoid')
		        if hum then
		            _lockConns[#_lockConns + 1] = hum.Died:Once(function()
		                if _RG._TargetAim.LockedTarget == char then
		                    local TA = _RG._TargetAim
		                    _TA_ClearLock()
		                    local pl = Players:GetPlayerFromCharacter(char)
		                    if TA.WaitRespawn and pl then
		                        TA.WaitFor, TA.WaitChar, TA.WaitSince = pl, char, os.clock()
		                    else
		                        TA.Lost = true
		                    end
		                end
		            end)
		        end
		        _lockConns[#_lockConns + 1] = char.AncestryChanged:Connect(function()
		            if not char:IsDescendantOf(workspace) then
		                if _RG._TargetAim.LockedTarget == char then _TA_ClearLock(); _RG._TargetAim.Lost = true end
		            end
		        end)
		    end

		    _RG._TA_Lock      = _TA_Lock
		    _RG._TA_ClearLock = _TA_ClearLock

		    -- keeps the lock honest. A target that vanished is dropped, and with auto switch on the lock moves to the player
		    -- nearest the cursor as soon as the old one dies, leaves or (unless stomp after wants the body) gets knocked
		    -- wait for respawn: after your target dies you sit in the void (server side) while they respawn with spawn
		    -- protection, and they are locked again the moment the forcefield is gone
		    RunService.Heartbeat:Connect(_RG._Safe('respawn wait', function()
		        local TA = _RG._TargetAim
		        local pl = TA.WaitFor
		        if not pl then return end
		        local now = os.clock()
		        if not TA.Enabled or not TA.WaitRespawn or not pl.Parent or now - TA.WaitSince > 25 or TA.LockedTarget then
		            TA.WaitFor, TA.WaitChar = nil, nil
		            return
		        end
		        _RG._ForceHideUntil = now + 0.3
		        local c = pl.Character
		        if not c or c == TA.WaitChar then return end
		        local h = c:FindFirstChildOfClass('Humanoid')
		        if not h or h.Health <= 0 or not c:FindFirstChild('HumanoidRootPart') then return end
		        if c:FindFirstChildOfClass('ForceField') then return end
		        TA.WaitFor, TA.WaitChar = nil, nil
		        _RG._ForceHideUntil = 0
		        _TA_Lock(c)
		    end))

		    local lockAcc = 0
		    RunService.Heartbeat:Connect(_RG._Safe('target lock', function(dt)
		        local TA = _RG._TargetAim
		        if not TA.Enabled then TA.Lost = false; return end
		        lockAcc = lockAcc + dt
		        if lockAcc < 0.15 then return end
		        lockAcc = 0
		        local lock = TA.LockedTarget
		        local switchFrom = nil
		        if lock then
		            local hum = lock.Parent and lock:FindFirstChildOfClass('Humanoid')
		            local gone = not hum or hum.Health <= 0 or not lock:FindFirstChild('HumanoidRootPart')
		            local down = TA.AutoSwitch and not TA.StompAfter and not TA.GrabAfter and _TA_IsKnocked(lock)
		            if not (gone or down) then return end
		            _TA_ClearLock()
		            switchFrom = lock
		        elseif TA.Lost then
		            switchFrom = true
		        end
		        TA.Lost = false
		        if switchFrom and TA.AutoSwitch then
		            local nxt = _TA_PickNearest()
		            if nxt and nxt ~= switchFrom then _TA_Lock(nxt) end
		        end
		    end))

		    -- ── checks ─────────────────────────────────────────────
		    _RG._TAChecks = {
		        MaxDistance = 500,
		        WallCheck   = false,
		        Whitelist   = {},

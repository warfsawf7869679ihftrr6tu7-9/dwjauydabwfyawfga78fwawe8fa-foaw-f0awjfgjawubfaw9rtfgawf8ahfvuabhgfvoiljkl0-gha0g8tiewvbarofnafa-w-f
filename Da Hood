					d.CFrame = target * rel
					d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.Massless = false, false, false, false, true
					local wc = Instance.new("WeldConstraint")
					wc.Part0, wc.Part1 = m, d
					wc.Parent = d

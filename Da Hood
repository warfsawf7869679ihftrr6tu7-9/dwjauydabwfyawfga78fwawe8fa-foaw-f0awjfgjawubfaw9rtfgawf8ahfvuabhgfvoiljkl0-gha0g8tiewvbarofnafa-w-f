		    -- moves the weapon by changing the grip weld between the hand and the handle (NOT Tool.Grip: the gun script
		    -- reports every change of that property to the server)
		    local VM = { Enabled = false, L = 0, R = 0, B = 0, F = 0, D = 0, U = 0 }
		    local base = setmetatable({}, { __mode = 'k' })      -- [weld] = original C1

		    local function Weld()
		        local char = lp.Character

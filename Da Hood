		        local fy = math.min(1, 1 / (1 + (AB.Smooth - 1) * 0.25 * AB.YS / 10))
		        local k = dt * 60
		        fx = 1 - (1 - fx) ^ k
		        fy = 1 - (1 - fy) ^ k

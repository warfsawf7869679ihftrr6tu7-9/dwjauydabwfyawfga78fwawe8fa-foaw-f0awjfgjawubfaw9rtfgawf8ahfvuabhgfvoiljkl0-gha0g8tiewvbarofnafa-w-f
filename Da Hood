		-- ============================================================
		-- misc: auto buy / auto armour / auto ammo / auto food (csync trips to the shop, one purchase after the other)
		-- ============================================================
		do
		    local Players    = game:GetService('Players')
		    local RunService = game:GetService('RunService')
		    local lp         = Players.LocalPlayer

		    local B = {
		        Auto = false, Items = {}, ExtraAmmo = 2, AmmoAmount = 1,
		        ArmorAuto = false, ArmorOnDamage = false, ArmorType = 'High-Medium Armor',
		        Busy = false, LastBuy = 0, LastDamage = 0, Fails = 0, BlockedUntil = 0,
		        Speed = 1, ArmorBelow = 5,      -- always the safe way: one click, then wait for the server to answer
		    }
		    _RG._Buy = B

		    -- guns, melee and throwables that exist in the shop (names + prices from the game dump; live prices replace them)
		    local Known = {
		        AK47 = 2532, AR = 1126, AUG = 2195, Deagle = 11255, ['Double-Barrel SG'] = 1519, ['Drum-Shotgun'] = 1238,
		        DrumGun = 3377, Flamethrower = 10130, Flintlock = 1463, Glock = 338, GrenadeLauncher = 11255, LMG = 4221,
		        P90 = 1126, RPG = 6753, Revolver = 1463, Rifle = 1745, SMG = 844, Shotgun = 1407, SilencerAR = 1407,
		        Silencer = 450, TacticalShotgun = 1970,
		        Bat = 281, Knife = 169, Pitchfork = 360, Shovel = 360, SledgeHammer = 394, StopSign = 338, Whip = 281,
		        Grenade = 788, Molotov = 4502, Flashbang = 619, TearGas = 5628, PepperSpray = 84, Taser = 1126, ['Money Gun'] = 875,
		    }
		    local WeaponNames = {}
		    for k in pairs(Known) do WeaponNames[k] = true end

		    local live, ammo = {}, {}      -- live[name] = { name, price, model } (cheapest copy), ammo[gun] = same

		    local function Parse(m)
		        local n = m.Name
		        local _, gun, ap = n:match('^(%d+) %[(.+) Ammo%] %- %$(%d+)$')
		        if gun then
		            -- only pads that can really be bought from: a cheaper copy without a ClickDetector (a display model)
		            -- used to win, and the trip then gave up silently, which is why buying ammo did nothing
		            if not (m:FindFirstChild('ClickDetector') and m:FindFirstChild('Head')) then return end
		            ap = tonumber(ap)
		            if not ammo[gun] or ap < ammo[gun].price then ammo[gun] = { name = gun, price = ap, model = m } end
		            WeaponNames[gun] = true             -- anything with ammo is a gun
		            return
		        end
		        local name, price = n:match('^%[(.+)%] %- %$(%d+)$')
		        if name and m:FindFirstChild('ClickDetector') and m:FindFirstChild('Head') then
		            price = tonumber(price)
		            if not live[name] or price < live[name].price then
		                live[name] = { name = name, price = price, model = m }
		            end
		        end
		    end

		    local function Scan()
		        live, ammo = {}, {}
		        local ign = workspace:FindFirstChild('Ignored')
		        if not ign then return false end
		        local shop = ign:FindFirstChild('Shop')
		        if shop then
		            for _, m in ipairs(shop:GetChildren()) do Parse(m) end
		        end
		        -- other shop pads that are not in the main folder
		        for _, m in ipairs(ign:GetDescendants()) do
		            if m:IsA('Model') and m.Parent ~= shop and m.Name:find('%$%d+$') then Parse(m) end
		        end
		        return next(live) ~= nil
		    end

		    local function Armor(name) return name:find('Armor') ~= nil end

		    local function Labels()
		        local t, seen = {}, {}
		        for name, it in pairs(live) do
		            if WeaponNames[name] and not Armor(name) then t[#t + 1] = name .. ' - $' .. it.price; seen[name] = true end
		        end
		        for name, price in pairs(Known) do
		            if not seen[name] then t[#t + 1] = name .. ' - $' .. price end
		        end
		        -- grouped instead of alphabetical: pistols, rifles and smgs, shotguns, heavy, melee, then throwables; cheap first
		        local CAT = {
		            Glock = 1, Revolver = 1, Deagle = 1, Flintlock = 1, Silencer = 1, Taser = 1,
		            SMG = 2, P90 = 2, AR = 2, SilencerAR = 2, AK47 = 2, AUG = 2, Rifle = 2, LMG = 2, DrumGun = 2,
		            Shotgun = 3, ['Double-Barrel SG'] = 3, TacticalShotgun = 3, ['Drum-Shotgun'] = 3,
		            RPG = 4, GrenadeLauncher = 4, Flamethrower = 4,
		            Bat = 5, Knife = 5, Pitchfork = 5, Shovel = 5, SledgeHammer = 5, StopSign = 5, Whip = 5,
		            Grenade = 6, Molotov = 6, Flashbang = 6, TearGas = 6, PepperSpray = 6, ['Money Gun'] = 6,
		        }
		        table.sort(t, function(a, b)
		            local na, pa = a:match('^(.+) %- %$(%d+)$')
		            local nb, pb = b:match('^(.+) %- %$(%d+)$')
		            local ca, cb = CAT[na] or 9, CAT[nb] or 9
		            if ca ~= cb then return ca < cb end
		            return (tonumber(pa) or 0) < (tonumber(pb) or 0)
		        end)
		        return t
		    end

		    local function Money()
		        local df = lp:FindFirstChild('DataFolder')
		        local cur = df and df:FindFirstChild('Currency')
		        return cur and tonumber(cur.Value) or 0
		    end

		    local function Has(name)
		        local tag = '[' .. name .. ']'
		        local bp = lp:FindFirstChild('Backpack')
		        return ((bp and bp:FindFirstChild(tag)) or (lp.Character and lp.Character:FindFirstChild(tag))) ~= nil
		    end

		    local function ArmorValue(name)
		        local be = lp.Character and lp.Character:FindFirstChild('BodyEffects')
		        local v = be and be:FindFirstChild(name == 'Fire Armor' and 'FireArmor' or 'Armor')
		        return v and tonumber(v.Value) or 0
		    end

		    local pingStat
		    pcall(function() pingStat = game:GetService('Stats').Network.ServerStatsItem['Data Ping'] end)
		    -- one click per round trip: the money only drops after the server answered, clicking faster than that would
		    -- just buy extra copies before the first answer comes back
		    local function ClickGap()
		        local ping = 0.08
		        if pingStat then
		            local ok, ms = pcall(pingStat.GetValue, pingStat)
		            if ok and ms then ping = ms / 1000 end
		        end
		        if B.Speed == 3 then return 0 end
		        if B.Speed == 2 then return math.clamp(ping * 0.5 + 0.02, 0.05, 0.2) end
		        return math.clamp(ping + 0.06, 0.12, 0.4)
		    end
		    -- how long to wait on the pad before the first click, so the server has us there
		    local function PadWait(gap)
		        if B.Speed == 3 then return 0 end
		        if B.Speed == 2 then return 0.03 end
		        return math.clamp(gap * 0.3, 0.02, 0.1)
		    end

		    -- ONE trip, blocking (always called from inside a task): csync to the pad, buy `count` copies, come back.
		    -- a purchase counts when the money went down (or `verify` says so). returns how many went through.
		    -- the trip runs with the "server reliable" csync timing so the server has us on the pad immediately.
		    local function Trip(entry, count, verify)
		        if not entry then return 0 end
		        if not entry.model or not entry.model.Parent then
		            local nm = entry.name
		            Scan()
		            entry = live[nm] or ammo[nm]
		            if not entry then return 0 end
		        end
		        local head = entry.model:FindFirstChild('Head')
		        local cd = entry.model:FindFirstChild('ClickDetector')
		        local root = lp.Character and lp.Character:FindFirstChild('HumanoidRootPart')
		        if not head or not cd or not root then return 0 end
		        if type(fireclickdetector) ~= 'function' then
		            library:Notify('auto buy: your executor has no fireclickdetector', 4)
		            return 0
		        end
		        local prevMode = _RG._CSyncReliable
		        _RG._BuyPos = head.Position + Vector3.new(0, 3, 0)
		        _RG._BuyUntil = os.clock() + 6 + count * 3.5
		        RunService.Heartbeat:Wait()
		        local gap = ClickGap()
		        task.wait(PadWait(gap))        -- the server needs a moment to have us on the pad
		        local bought = 0
		        local price = entry.price
		        local burst = B.Speed ~= 1 and price ~= nil and price > 0
		        if burst then
		            -- fast / instant: all the clicks of one batch go out back to back, then the money is checked once for the
		            -- whole batch (a batch never sends more clicks than copies still wanted, so nothing is bought twice)
		            local remaining, deadline = count, os.clock() + 3 + count
		            while remaining > 0 and os.clock() < deadline do
		                local before = Money()
		                for k = 1, remaining do
		                    pcall(fireclickdetector, cd)
		                    if k < remaining then
		                        local t = os.clock()
		                        repeat RunService.Heartbeat:Wait() until os.clock() - t >= gap
		                    end
		                end
		                local got, t1 = 0, os.clock()
		                while os.clock() - t1 < 1.2 do
		                    RunService.Heartbeat:Wait()
		                    got = math.floor((before - Money()) / price + 0.5)
		                    if got >= remaining or (verify and verify()) then break end
		                end
		                if got <= 0 and verify and verify() then got = 1 end
		                if got <= 0 then break end
		                got = math.min(got, remaining)
		                bought = bought + got
		                remaining = remaining - got
		            end
		        end
		        for _ = 1, burst and 0 or count do
		            local m0, t0, last = Money(), os.clock(), -1
		            local ok = false
		            while os.clock() - t0 < 3 do
		                local now = os.clock()
		                if now - last >= gap then
		                    pcall(fireclickdetector, cd)
		                    last = now
		                end
		                RunService.Heartbeat:Wait()
		                if Money() < m0 or (verify and verify()) then ok = true break end
		            end
		            if not ok then break end                  -- a purchase did not go through: stop instead of looping on
		            bought = bought + 1
		            RunService.Heartbeat:Wait()
		        end
		        _RG._BuyUntil = 0
		        _RG._CSyncReliable = prevMode
		        return bought
		    end

		    local function ItemEntry(name)
		        if live[name] then return live[name] end
		        if Known[name] then return { name = name, price = Known[name] } end
		    end

		    -- buy every item in the list, one after the other, each followed by `ExtraAmmo` boxes of ammo for it
		    local function BuyList(names, force)
		        if B.Busy or #names == 0 then return end
		        B.Busy = true
		        task.spawn(function()
		            local total = 0
		            pcall(function()
		                for _, name in ipairs(names) do
		                    if force or not Has(name) then
		                        local it = ItemEntry(name)
		                        if it and Money() >= it.price then
		                            local n = Trip(it, 1, function() return Has(name) end)
		                            total = total + n
		                            if n > 0 and (B.ExtraAmmo or 0) > 0 then
		                                local am = ammo[name]
		                                if am and Money() >= am.price then Trip(am, B.ExtraAmmo) end
		                            end
		                        end
		                    end
		                end
		            end)
		            B.Busy = false
		            B.LastBuy = os.clock()
		            if total == 0 then
		                B.Fails = B.Fails + 1
		                if B.Fails >= 2 then B.BlockedUntil = os.clock() + 20; B.Fails = 0 end    -- stop walking back and forth
		            else
		                B.Fails = 0
		            end
		        end)
		    end

		    local function BuyAmmo(entry, n, loud)
		        if not entry then return end
		        if B.Busy then
		            if loud then library:Notify('buy ammo: another purchase is still going, try again in a second', 2) end
		            return
		        end
		        B.Busy = true
		        task.spawn(function()
		            local ok, got = pcall(Trip, entry, n)
		            B.Busy = false
		            B.LastBuy = os.clock()
		            if loud then
		                if ok and (got or 0) > 0 then
		                    library:Notify('bought ' .. got .. 'x ' .. entry.name .. ' ammo', 2)
		                else
		                    library:Notify('buy ammo: the shop did not take it (full on ammo, no money, or the pad is out of reach)', 3)
		                end
		            end
		        end)
		    end

		    local function SelectedNames()
		        local list = {}
		        for label, on in pairs(B.Items) do
		            if on then
		                local nm = label:match('^(.+) %- %$%d+$')
		                if nm then list[#list + 1] = nm end
		            end
		        end
		        table.sort(list)
		        return list
		    end

		    local function BuyArmor()
		        if B.Busy then return end
		        local it = live[B.ArmorType]
		        if not it then Scan(); it = live[B.ArmorType] end
		        if not it then library:Notify('buy armour: ' .. B.ArmorType .. ' not found in the shop', 3) return end
		        B.Busy = true
		        task.spawn(function()
		            local before = ArmorValue(B.ArmorType)
		            pcall(function() Trip(it, 1, function() return ArmorValue(B.ArmorType) > before end) end)
		            B.Busy = false
		            B.LastBuy = os.clock()
		        end)
		    end

		    -- remember when we last took damage (for "buy on damage")
		    local function HookHealth(char)
		        local hum = char:WaitForChild('Humanoid', 10)
		        if not hum then return end
		        local last = hum.Health
		        hum.HealthChanged:Connect(function(h)
		            if h < last - 0.5 then B.LastDamage = os.clock() end
		            last = h
		        end)
		    end
		    if lp.Character then task.spawn(HookHealth, lp.Character) end
		    lp.CharacterAdded:Connect(HookHealth)

		    local acc = 0
		    RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
		        if not (B.Auto or B.ArmorAuto) then return end
		        acc = acc + dt
		        if acc < 0.15 then return end
		        acc = 0
		        local now = os.clock()
		        if B.Busy or now - B.LastBuy < (B.Speed == 1 and 0.6 or 0.2) or now < B.BlockedUntil then return end
		        local char = lp.Character
		        local hum = char and char:FindFirstChildOfClass('Humanoid')
		        if not hum or hum.Health <= 0 then return end

		        if B.Auto then
		            local missing = {}
		            for _, name in ipairs(SelectedNames()) do
		                local it = ItemEntry(name)
		                if it and not Has(name) and Money() >= it.price then missing[#missing + 1] = name end
		            end
		            if #missing > 0 then
		                BuyList(missing)
		                return
		            end
		        end

		        if B.ArmorAuto then
		            local it = live[B.ArmorType]
		            local damaged = now - B.LastDamage < 3
		            if it and ArmorValue(B.ArmorType) <= B.ArmorBelow and (not B.ArmorOnDamage or damaged) and Money() >= it.price then
		                BuyArmor()
		            end
		        end
		    end))

		    -- ---------- ui ----------
		    local box = _RG.tabs.misc:AddRightGroupbox('auto buy')
		    local boxAmmo = _RG.tabs.misc:AddRightGroupbox('auto ammo')
		    local boxArmor = _RG.tabs.misc:AddRightGroupbox('auto armour')
		    local boxFood = _RG.tabs.misc:AddRightGroupbox('auto food')

		do
		    local Players    = game:GetService('Players')
		    local RunService = game:GetService('RunService')

		    local PETS = {
		        cat = {
		            stand = 115679676994536,
		            walk  = { 103328038935625, 113879801624485 },
		        },
		        dog = {
		            stand = 82807942110361,
		            walk  = { 90656873875310, 127750499689087 },
		        },
		    }

		    -- base sprite size (the size slider multiplies these)
		    local BASE_WIDTH   = 3.2
		    local BASE_HEIGHT  = 3
		    -- how far below the HumanoidRootPart bottom the sprite sits (positive = lower)
		    local FLOOR_OFFSET = 2.1
		    local WALK_FPS     = 6

		    local _BC_Enabled  = false
		    local _BC_Pet      = 'cat'
		    local _BC_Size     = 1
		    local _BC_Part     = nil
		    local _BC_Conn     = nil
		    local _BC_DescConn = nil
		    local _BC_Char     = nil

		    local function _BC_Tex(id)
		        return 'rbxassetid://' .. id
		    end

		    local function _BC_HideObj(v)
		        pcall(function()
		            if v:IsA('BasePart') then
		                if v:GetAttribute('_bc_orig_trans') == nil then
		                    v:SetAttribute('_bc_orig_trans', v.Transparency)
		                    v:SetAttribute('_bc_orig_shadow', v.CastShadow)
		                end
		                v.Transparency = 1
		                v.CastShadow   = false
		            elseif v:IsA('Decal') or v:IsA('Texture') then
		                if v:GetAttribute('_bc_orig_dec') == nil then
		                    v:SetAttribute('_bc_orig_dec', v.Transparency)
		                end
		                v.Transparency = 1
		            end
		        end)
		    end

		    local function _BC_ShowChar(char)
		        if not char then return end
		        for _, v in ipairs(char:GetDescendants()) do
		            pcall(function()
		                if v:IsA('BasePart') then
		                    local t = v:GetAttribute('_bc_orig_trans')
		                    local s = v:GetAttribute('_bc_orig_shadow')
		                    if t ~= nil then v.Transparency = t; v:SetAttribute('_bc_orig_trans', nil) end
		                    if s ~= nil then v.CastShadow = s;   v:SetAttribute('_bc_orig_shadow', nil) end
		                elseif v:IsA('Decal') or v:IsA('Texture') then
		                    local t = v:GetAttribute('_bc_orig_dec')
		                    if t ~= nil then v.Transparency = t; v:SetAttribute('_bc_orig_dec', nil) end
		                end
		            end)
		        end
		    end

		    local function _BC_Stop()
		        if _BC_Conn then _BC_Conn:Disconnect(); _BC_Conn = nil end
		        if _BC_DescConn then _BC_DescConn:Disconnect(); _BC_DescConn = nil end
		        if _BC_Part then
		            pcall(function() _BC_Part:Destroy() end)
		            _BC_Part = nil
		        end
		        if _BC_Char then
		            _BC_ShowChar(_BC_Char)
		            _BC_Char = nil
		        end
		    end

		    local function _BC_Start(char)
		        _BC_Stop()

		        local hum  = char:WaitForChild('Humanoid', 10)
		        local root = char:WaitForChild('HumanoidRootPart', 10)
		        if not hum or not root then return end
		        -- toggled off / respawned while we were waiting
		        if not _BC_Enabled or Players.LocalPlayer.Character ~= char then return end

		        _BC_Char = char

		        -- hide the real character (and anything added to it later)
		        for _, v in ipairs(char:GetDescendants()) do _BC_HideObj(v) end
		        _BC_DescConn = char.DescendantAdded:Connect(function(v)
		            task.defer(_BC_HideObj, v)
		        end)

		        -- the sprite
		        local part = Instance.new('Part')
		        part.Name         = '__BecomeSprite'
		        part.Size         = Vector3.new(BASE_WIDTH * _BC_Size, BASE_HEIGHT * _BC_Size, 0.05)
		        part.Anchored     = true
		        part.CanCollide   = false
		        part.CanQuery     = false
		        part.CanTouch     = false
		        part.CastShadow   = false
		        part.Transparency = 1
		        part.Material     = Enum.Material.SmoothPlastic
		        part.Parent       = workspace
		        _BC_Part = part

		        local decalFront = Instance.new('Decal')
		        decalFront.Face   = Enum.NormalId.Front
		        decalFront.Parent = part

		        local decalBack = Instance.new('Decal')
		        decalBack.Face   = Enum.NormalId.Back
		        decalBack.Parent = part

		        local walkFrame = 1
		        local walkTimer = 0
		        local lastTex   = nil

		        _BC_Conn = RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
		            if not root.Parent or not part.Parent then return end
		            local cam = workspace.CurrentCamera
		            if not cam then return end

		            local set = PETS[_BC_Pet] or PETS.cat
		            local w   = BASE_WIDTH  * _BC_Size
		            local h   = BASE_HEIGHT * _BC_Size
		            part.Size = Vector3.new(w, h, 0.05)

		            -- position: bottom of the sprite kisses the floor
		            local footY   = root.Position.Y - (root.Size.Y * 0.5) - FLOOR_OFFSET
		            local centerY = footY + (h * 0.5)

		            -- yaw-only camera facing, stays upright
		            local rootPos = root.Position
		            local camPos  = cam.CFrame.Position
		            local lookDir = Vector3.new(camPos.X - rootPos.X, 0, camPos.Z - rootPos.Z)
		            local pos     = Vector3.new(rootPos.X, centerY, rootPos.Z)

		            if lookDir.Magnitude > 0.01 then
		                part.CFrame = CFrame.new(pos, pos + lookDir.Unit)
		            else
		                part.CFrame = CFrame.new(pos)
		            end

		            -- stand / walk animation
		            local want
		            if hum.MoveDirection.Magnitude > 0.1 then
		                walkTimer += dt
		                if walkTimer >= (1 / WALK_FPS) then
		                    walkTimer = 0
		                    walkFrame = (walkFrame % #set.walk) + 1
		                end
		                want = _BC_Tex(set.walk[walkFrame])
		            else
		                walkTimer = 0
		                walkFrame = 1

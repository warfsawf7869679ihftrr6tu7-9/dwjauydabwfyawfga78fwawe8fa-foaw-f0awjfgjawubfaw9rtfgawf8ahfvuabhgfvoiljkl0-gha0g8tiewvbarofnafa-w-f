				end
			end
			m.CFrame = target
			m.Anchored, m.CanCollide, m.CanQuery, m.CanTouch, m.Massless = false, false, false, false, true
			local weld = Instance.new("Weld")
			weld.Part0, weld.Part1, weld.C0 = base, m, offset
			weld.Parent = m
			m.Parent = base
			base.Transparency = 1

	new("TextLabel", {
		Position = UDim2.fromOffset(31, 0), Size = UDim2.new(1, -40, 0, head), Text = "Keybinds", FontFace = font(true),
		TextColor3 = theme.text_on, TextXAlignment = Enum.TextXAlignment.Left, Parent = body,
	})
	local line = new("Frame", { Position = UDim2.fromOffset(9, head), Size = UDim2.new(1, -18, 0, 1), BackgroundColor3 = theme.line, Parent = body })
	local rows = new("Frame", { Position = UDim2.fromOffset(0, head + 1), Size = UDim2.new(1, 0, 1, -head - 1), BackgroundTransparency = 1, Parent = body }, {
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }), pad(10, 3, 8, 3),
	})

	local pool = {}
	local queued, stale = false, true
	local rebuild; rebuild = LPH_NO_VIRTUALIZE(function()
		local shown = 0
		for _, bind in ipairs(library.binds) do
			if bind.name and not bind.hidden and (bind.value ~= "NONE" or bind.mode == "always") then
				shown += 1
				local on = bind.state == nil or bind.state()
				local r = pool[shown]
				if not r then
					local row = new("Frame", { Size = UDim2.new(1, 0, 0, row_h), BackgroundTransparency = 1, LayoutOrder = shown, Parent = rows })
					local name = new("TextLabel", {
						Size = UDim2.new(1, -50, 1, 0), Text = "", TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
						TextColor3 = theme.text_off, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
					})
					local box, text = value_box(row, 18, 6)
					box.AnchorPoint = Vector2.new(1, 0.5)
					box.Position = UDim2.new(1, 0, 0.5, 0)
					text.TextSize = 11
					r = { row = row, name = name, text = text, shown = true }
					pool[shown] = r
				end
				local mode: string = bind.mode
				local key = mode == "always" and "ALWAYS" or (mode == "hold" and (bind.value .. " · HOLD") or bind.value)
				if r.label ~= bind.name then
					r.label = bind.name
					r.name.Text = bind.name
				end
				if r.key ~= key then
					r.key = key
					r.text.Text = key
				end
				r.name.TextColor3 = on and theme.text_on or theme.text_off
				r.text.TextColor3 = on and theme.acc_top or theme.text_off
				if not r.shown then
					r.shown = true
					r.row.Visible = true
				end
			end
		end
		for i = shown + 1, #pool do
			local r = pool[i]
			if r.shown then
				r.shown = false
				r.row.Visible = false
			end
		end
		line.Visible = shown > 0
		outer.Size = UDim2.fromOffset(width, head + 2 + (shown > 0 and (shown * row_h + 7) or 0))
	end)
	library.refresh_binds = LPH_NO_VIRTUALIZE(function()
		if queued then return end
		queued = true
		task.defer(function()
			queued = false
			if not outer.Parent then return end
			if outer.Visible then
				stale = false
				rebuild()
			else
				stale = true
			end
		end)
	end)
	outer:GetPropertyChangedSignal("Visible"):Connect(LPH_NO_VIRTUALIZE(function()
		if outer.Visible and stale then
			stale = false
			rebuild()
		end
	end))

	draggable(outer, outer, track_position(outer, "pos_keybinds"))
	outer.Visible = false
	bind_list = outer
end


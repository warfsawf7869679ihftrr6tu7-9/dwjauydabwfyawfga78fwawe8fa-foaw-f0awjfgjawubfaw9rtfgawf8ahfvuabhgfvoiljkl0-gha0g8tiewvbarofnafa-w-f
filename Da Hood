		    -- auto buy ammo: the held gun is empty and reloading did not help for a moment -> buy ammo for it
		    local emptySince, ammoAcc, lastAmmoBuy = nil, 0, 0
		    RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
		        if not AUTOAMMO.Enabled then emptySince = nil; return end
		        ammoAcc = ammoAcc + dt
		        if ammoAcc < 0.25 then return end
		        ammoAcc = 0
		        local char = lp.Character
		        local tool = char and char:FindFirstChildOfClass('Tool')

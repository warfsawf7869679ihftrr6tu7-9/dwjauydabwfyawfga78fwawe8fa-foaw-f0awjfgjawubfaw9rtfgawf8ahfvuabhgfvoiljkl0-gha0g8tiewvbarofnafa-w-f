		last_p[fill] = p
		tween(fill, { Size = UDim2.new(p, 0, 1, 0) }, 0.15)
	end)

	local function armor_of(char, plr)
		local be = char and char:FindFirstChild("BodyEffects")
		local a, f = be and be:FindFirstChild("Armor"), be and be:FindFirstChild("FireArmor")
		if a or f then
			return math.clamp((tonumber(a and a.Value) or 0) + (tonumber(f and f.Value) or 0), 0, ARMOR_MAX)
		end
		local df = plr and plr:FindFirstChild("DataFolder")
		local info = df and df:FindFirstChild("Information")
		local sa, sf = info and info:FindFirstChild("ArmorSave"), info and info:FindFirstChild("FireArmorSave")
		return math.clamp((tonumber(sa and sa.Value) or 0) + (tonumber(sf and sf.Value) or 0), 0, ARMOR_MAX)
	end
	local function state_of(char)
		local be = char:FindFirstChild("BodyEffects")
		local function on(name)
			local v = be and be:FindFirstChild(name)
			return v ~= nil and v.Value == true
		end
		if on("Dead") then return "dead" end
		if on("K.O") then return "knocked" end
		if char:FindFirstChild("GRABBING_CONSTRAINT") then return "grabbed" end
		if char:FindFirstChildOfClass("ForceField") then return "protected" end
		if on("Reload") then return "reloading" end
		return "alive"
	end
	local function wanted_of(plr)
		local ls = plr:FindFirstChild("leaderstats")
		local w = ls and ls:FindFirstChild("Wanted")
		if w then return tostring(w.Value) end
		local df = plr:FindFirstChild("DataFolder")
		local info = df and df:FindFirstChild("Information")
		local w2 = info and info:FindFirstChild("Wanted")
		return w2 and tostring(w2.Value) or "0"
	end
	local function crew_of(plr)
		local df = plr:FindFirstChild("DataFolder")
		local info = df and df:FindFirstChild("Information")
		local c = info and info:FindFirstChild("Crew")
		local v = c and tonumber(c.Value)
		return (v and v > 0) and tostring(v) or "none"
	end
	-- up to four of their guns: the one in their hands first, then the backpack (other tools only if there is room)
	local function weapons_of(char, plr)
		local held = char:FindFirstChildOfClass("Tool")
		local guns, other = {}, {}
		local function add(t)
			if not t:IsA("Tool") then return end
			if t:FindFirstChild("ShootingCooldown") or t:FindFirstChild("Ammo") then guns[#guns + 1] = t else other[#other + 1] = t end
		end
		if held then add(held) end
		local bp = plr:FindFirstChildOfClass("Backpack")
		for _, t in ipairs(bp and bp:GetChildren() or {}) do add(t) end
		local out = {}
		for _, t in ipairs(guns) do if #out < 4 then out[#out + 1] = t end end
		for _, t in ipairs(other) do if #out < 4 and t.Name:find("^%[") then out[#out + 1] = t end end
		return out, held
	end

	library.set_target = LPH_NO_VIRTUALIZE(function(list)
		local main = type(list) == "table" and list[1] or nil
		local char, plr = main and main.char, main and main.plr
		local has = char ~= nil and plr ~= nil and char.Parent ~= nil
		name_text.Text = has and plr.DisplayName or "None"
		local accent = tohex(theme.acc_top)
		local function val(v) return string.format("<font color=\"%s\">%s</font>", accent, tostring(v)) end

		if has then
			local me = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
			local r = char:FindFirstChild("HumanoidRootPart")
			local d = (me and r) and math.floor((r.Position - me.Position).Magnitude + 0.5) or "?"
			stats_text.Text = string.format("wanted %s  crew %s  state %s  distance %s",
				val(wanted_of(plr)), val(crew_of(plr)), val(state_of(char)), val(d .. "m"))
		else
			stats_text.Text = "wanted -  crew -  state -  distance -"
		end

		local hum = has and char:FindFirstChildOfClass("Humanoid") or nil
		local max_health = hum and hum.MaxHealth or 0
		if hum and max_health > 0 then
			health_text.Text = math.floor(hum.Health + 0.5) .. " / " .. math.floor(max_health + 0.5)
			set_bar(health_fill, hum.Health / max_health)
		else
			health_text.Text = "-"
			set_bar(health_fill, 0)
		end

		if has then
			local ar = armor_of(char, plr)
			armor_text.Text = math.floor(ar + 0.5) .. " / " .. ARMOR_MAX
			set_bar(armor_fill, ar / ARMOR_MAX)
		else
			armor_text.Text = "-"
			set_bar(armor_fill, 0)
		end

		local weps, held = {}, nil
		if has then weps, held = weapons_of(char, plr) end
		for i, s in ipairs(slots) do
			local t = weps[i]
			s.name = t and t.Name or nil
			s.equipped = t ~= nil and t == held
			s.border.BackgroundColor3 = s.equipped and theme.accent or theme.val_border
			local img = t and icon_for(t)
			if img then
				if s.img.Image ~= img then s.img.Image = img end
				s.img.Visible, s.none.Visible = true, false
			else
				s.img.Image = ""
				s.img.Visible, s.none.Visible = false, true
			end
		end
	end)
	library.set_target(nil)
	outer.Visible = false
	target_hud = outer
end


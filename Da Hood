		    -- ── TOOL WIREFRAME ──────────────────────────────────────
		    _RG._ToolWireEnabled = false
		    _RG._ToolWireColor   = Color3.fromRGB(255, 255, 255)
		    _RG._ToolWireAdorns  = {}
		    _RG._ToolWireHBConn  = nil

		    local function _ToolWireRemovePart(part)
		        local e = _RG._ToolWireAdorns[part]
		        if not e then return end
		        pcall(function() e.adorn:Destroy() end)
		        if e.orig and part.Parent then pcall(function() part.Transparency = e.orig end) end
		        _RG._ToolWireAdorns[part] = nil
		    end

		    local function _ToolWireAddPart(part)
		        if _RG._ToolWireAdorns[part] then return end
		        if not part:IsA("BasePart") then return end
		        -- invisible helper parts (hit boxes, muzzle markers ...) are not part of the weapon's look: no wireframe for
		        -- them (that is where the big blocks around the weapon came from)
		        if part.Transparency >= 0.95 then return end
		        local origTransparency = part.Transparency
		        _wmEnsureMesh(part)
		        pcall(function() part.Transparency = 1; part.CastShadow = false end)
		        local adorn = Instance.new("WireframeHandleAdornment")
		        adorn.Name        = "__ToolCW"
		        adorn.ZIndex      = 10
		        adorn.Thickness   = 1
		        adorn.AlwaysOnTop = true
		        adorn.Color3      = _RG._ToolWireColor
		        adorn.Transparency= 0
		        adorn.Adornee     = part
		        adorn.Parent      = playerGui
		        _RG._ToolWireAdorns[part] = {
		            adorn=adorn, lastData=nil, lastSize=nil, lastScale=nil, lastOffset=nil, orig=origTransparency
		        }
		        part.Destroying:Connect(function() _ToolWireRemovePart(part) end)
		    end

		    local function _ToolWireUpdatePart(part, e)
		        local adorn = e.adorn
		        adorn.Color3 = _RG._ToolWireColor
		        local data = _wmFetchMesh(part)
		        if data == nil or data == false then
		            if part.Size ~= e.lastSize then
		                adorn:Clear()
		                adorn:AddLines(_wmBuildBoxWireframe(part.Size))
		                e.lastSize = part.Size
		            end
		            return
		        end
		        local sm     = part:FindFirstChildOfClass("SpecialMesh")
		        local scale  = sm and sm.Scale  or nil
		        local offset = sm and sm.Offset or nil
		        if data ~= e.lastData or part.Size ~= e.lastSize or scale ~= e.lastScale or offset ~= e.lastOffset then
		            adorn:Clear()
		            adorn:AddLines(_wmMeshPoints(data, part))
		            e.lastData=data; e.lastSize=part.Size; e.lastScale=scale; e.lastOffset=offset
		        end
		    end

		    local _ToolWireDescConn = nil

		    local function _ToolWireApply()
		        for part in pairs(_RG._ToolWireAdorns) do _ToolWireRemovePart(part) end
		        _RG._ToolWireAdorns = {}
		        if _RG._ToolWireHBConn then _RG._ToolWireHBConn:Disconnect(); _RG._ToolWireHBConn = nil end
		        if _ToolWireDescConn then _ToolWireDescConn:Disconnect(); _ToolWireDescConn = nil end
		        local tool = _RG._GetEquippedTool and _RG._GetEquippedTool()
		        if not tool then return end
		        task.defer(function()
		            for _, obj in ipairs(tool:GetDescendants()) do
		                if obj:IsA("BasePart") and not obj:FindFirstChildOfClass("SpecialMesh") then _ToolWireAddPart(obj) end
		            end
		            if tool:IsA("BasePart") then _ToolWireAddPart(tool) end
		            _ToolWireDescConn = tool.DescendantAdded:Connect(function(obj)
		                task.defer(function()
		                    if obj:IsA("BasePart") and not obj:FindFirstChildOfClass("SpecialMesh") and _RG._ToolWireEnabled then _ToolWireAddPart(obj) end
		                end)
		            end)
		            _RG._ToolWireHBConn = game:GetService('RunService').Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
		                -- check tool still equipped
		                local currentTool = _RG._GetEquippedTool and _RG._GetEquippedTool()
		                if not currentTool or currentTool ~= tool then
		                    -- tool unequipped or swapped
		                    for part in pairs(_RG._ToolWireAdorns) do _ToolWireRemovePart(part) end
		                    _RG._ToolWireAdorns = {}
		                    if _RG._ToolWireHBConn then _RG._ToolWireHBConn:Disconnect(); _RG._ToolWireHBConn = nil end
		                    if currentTool and _RG._ToolWireEnabled then _ToolWireApply() end
		                    return
		                end
		                for part, entry in pairs(_RG._ToolWireAdorns) do
		                    if not part.Parent then _ToolWireRemovePart(part)
		                    else pcall(_ToolWireUpdatePart, part, entry) end
		                end
		            end))
		        end)
		    end

		    local function _ToolWireDisable()
		        for part in pairs(_RG._ToolWireAdorns) do _ToolWireRemovePart(part) end
		        _RG._ToolWireAdorns = {}
		        if _RG._ToolWireHBConn then _RG._ToolWireHBConn:Disconnect(); _RG._ToolWireHBConn = nil end
		        -- (transparency of the parts was already put back by _ToolWireRemovePart)
		    end

		    -- watch for tool equip/unequip to reapply
		    local _lpChar2 = game:GetService('Players').LocalPlayer.Character
		    local function _HookCharForToolWire(char)
		        if not char then return end
		        char.ChildAdded:Connect(function(c)
		            if c:IsA('Tool') and _RG._ToolWireEnabled then

	local function after(obj, fn)
		if obj._row then fn(obj._row) else obj._later = obj._later or {}; table.insert(obj._later, fn) end
	end
	local function fire(obj, v)
		obj.Value = v
		if obj._info.Callback then task.spawn(pcall, obj._info.Callback, v) end
		for _, f in ipairs(obj._cbs) do task.spawn(pcall, f, v) end
	end
	local function newObj(kind, idx, info)
		local obj = { Type = kind, _idx = idx, _info = info or {}, _cbs = {} }
		function obj:OnChanged(fn)
			table.insert(self._cbs, fn)
			pcall(fn, self.Value)
		end
		function obj:OnClick(fn) self:OnChanged(fn) end
		function obj:GetState() return true end
		return obj
	end

	-- the logical controls (they exist and hold values before their row is drawn)
	local function makeToggle(box, idx, info)
		local obj = newObj("Toggle", idx, info)
		obj.Value = info.Default == true
		FWL.Toggles[idx] = obj
		function obj:SetValue(v) after(self, function(row) row.set(v and true or false) end) end
		function obj:AddColorPicker(cidx, cinfo)
			local opt = newObj("ColorPicker", cidx, cinfo)
			opt.Value = cinfo.Default or Color3.new(1, 1, 1)
			FWL.Options[cidx] = opt
			function opt:SetValueRGB(c) opt.Value = c; fire(opt, c) end

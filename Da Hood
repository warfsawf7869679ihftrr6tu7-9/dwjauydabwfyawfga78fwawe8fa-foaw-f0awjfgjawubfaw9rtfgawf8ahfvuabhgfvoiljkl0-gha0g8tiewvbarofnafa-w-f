		    boxArmor:AddSlider('misc_armour_below', { Text = 'buy when below', Default = 5, Min = 0, Max = 100, Rounding = 0 })
		    library.Options.misc_armour_below:OnChanged(function(V) B.ArmorBelow = V end)
		    boxArmor:AddButton({ Text = 'buy now', Func = BuyArmor })

		    -- the list refreshes itself once the map has had time to load (no button needed)
		    task.delay(8, function()
		        if Scan() then library.Options.misc_buy_item:SetValues(Labels()) end
		    end)

		    -- ---------- auto food: buy food when hurt, then eat all of it hidden in the void ----------
		    local FOOD = { Enabled = false, Item = 'Hamburger', Pct = 50, Count = 3, Hide = true, Eating = false, Last = 0 }
		    local Foods = { 'Hamburger', 'Pizza', 'Chicken', 'Taco', 'HotDog', 'Donut', 'IceCream', 'Popsicle', 'Popcorn', 'Meat', 'Lemonade', 'Da Milk', 'Cranberry', 'Lettuce' }

		    local function FoodTools(name)
		        local tag, list = '[' .. name .. ']', {}
		        for _, cont in ipairs({ lp:FindFirstChild('Backpack'), lp.Character }) do
		            if cont then
		                for _, t in ipairs(cont:GetChildren()) do
		                    if t:IsA('Tool') and t.Name == tag then list[#list + 1] = t end
		                end
		            end
		        end
		        return list
		    end

		    local function FoodTrip()
		        if FOOD.Eating or B.Busy then return end
		        local name = FOOD.Item
		        local hum = lp.Character and lp.Character:FindFirstChildOfClass('Humanoid')
		        if not hum then return end
		        FOOD.Eating = true
		        B.Busy = true
		        task.spawn(function()
		            pcall(function()
		                -- 1. buy up to the wanted amount in one trip
		                local need = FOOD.Count - #FoodTools(name)
		                if need > 0 then
		                    local entry = live[name]
		                    if not entry then Scan(); entry = live[name] end
		                    if not entry then
		                        library:Notify('auto food: ' .. name .. ' is not in the shop right now', 3)
		                    elseif Money() < entry.price then
		                        library:Notify('auto food: not enough money for ' .. name, 3)
		                    else
		                        Trip(entry, need)
		                    end
		                end
		                -- 2. eat everything, hidden in the void so nobody can get to us meanwhile
		                if FOOD.Hide then _RG._ForceHideUntil = os.clock() + 90 end
		                local t1 = os.clock()
		                while os.clock() - t1 < 60 do
		                    local tools = FoodTools(name)
		                    local c = lp.Character
		                    local h = c and c:FindFirstChildOfClass('Humanoid')
		                    if #tools == 0 or not h or h.Health <= 0 then break end
		                    local tool = tools[1]
		                    if tool.Parent ~= c then pcall(function() h:EquipTool(tool) end) end
		                    pcall(function() tool:Activate() end)
		                    task.wait(0.35)
		                end
		            end)
		            _RG._BuyUntil = 0
		            _RG._ForceHideUntil = 0
		            B.Busy = false
		            FOOD.Eating = false
		        end)
		    end

		    -- checked on every frame, so it starts the moment health crosses the line
		    RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
		        if not FOOD.Enabled or FOOD.Eating or B.Busy then return end
		        local char = lp.Character
		        local hum = char and char:FindFirstChildOfClass('Humanoid')
		        if not hum or hum.Health <= 0 or os.clock() - FOOD.Last < 3 then return end
		        if hum.Health < hum.MaxHealth * (FOOD.Pct / 100) then
		            FOOD.Last = os.clock()
		            library:Notify('auto food: health ' .. math.floor(hum.Health) .. ', getting ' .. FOOD.Item, 2)
		            FoodTrip()
		        end
		    end))

		    boxFood:AddToggle('misc_auto_food', { Text = 'auto food', Default = false })
		    library.Toggles.misc_auto_food:OnChanged(function(V) FOOD.Enabled = V end)
		    boxFood:AddDropdown('misc_food_item', { Text = 'food', Values = Foods, Default = 'Hamburger' })
		    library.Options.misc_food_item:OnChanged(function(V) FOOD.Item = V end)
		    boxFood:AddSlider('misc_food_below', { Text = 'eat below health %', Default = 50, Min = 5, Max = 95, Rounding = 0 })
		    library.Options.misc_food_below:OnChanged(function(V) FOOD.Pct = V end)
		    boxFood:AddSlider('misc_food_amount', { Text = 'food amount', Default = 3, Min = 1, Max = 10, Rounding = 0 })
		    library.Options.misc_food_amount:OnChanged(function(V) FOOD.Count = V end)
		    boxFood:AddToggle('misc_food_hide', { Text = 'eat hidden in void', Default = true })
		    library.Toggles.misc_food_hide:OnChanged(function(V) FOOD.Hide = V end)

		    -- other features (firework text) buy things through the same trip code
		    _RG._BuyApi = {

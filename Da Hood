		        Title    = 'wireframe color',
		        Callback = function(C)
		            _RG._ToolWireColor = C
		        end,
		    })
		    ToolWireToggle:OnChanged(function(V)
		        _RG._ToolWireEnabled = V
		        if V then _ToolWireApply()
		        else _ToolWireDisable() end
		    end)

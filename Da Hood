		-- [FaZeWare 17058-18643]
		-- rage: mods (no spread / no recoil)
		-- ============================================================
		do
		    local RunService        = game:GetService('RunService')
		    local ReplicatedStorage = game:GetService('ReplicatedStorage')

		    local MODS = { NoSpread = false, SpreadAmount = 0, NoRecoil = false, RecoilAmount = 0 }
		    _RG._Mods = MODS

		    -- ---------- spread ----------
		    -- GunHandler.shotgunSpread rolls the pellet offsets from the server-shared key. The original is still called
		    -- every time (so the shared counter keeps advancing), only the returned offsets are scaled.
		    local origSpread
		    local function HookSpread()
		        if _RG._TryHookGun then _RG._TryHookGun() end
		    end

		    -- ---------- recoil ----------
		    -- the server tells the client to kick the camera with MainEvent:FireClient("ShootingRecoil", multiplier).
		    -- the Framework script's OnClientEvent handler is re-connected behind a small filter that scales (or drops) that message.
		    local wrappedFns = setmetatable({}, { __mode = 'k' })
		    local ourFns     = setmetatable({}, { __mode = 'k' })

		    local function IsFrameworkHandler(f)
		        local ok, env = pcall(getfenv, f)
		        if not ok or type(env) ~= 'table' then return true end   -- can't tell, wrap it
		        local scr = rawget(env, 'script')
		        return scr == nil or scr.Name == 'Framework'
		    end

		    local function ScanRecoil()
		        local ev = ReplicatedStorage:FindFirstChild('MainEvent')
		        if not ev or type(getconnections) ~= 'function' then return end
		        for _, conn in ipairs(getconnections(ev.OnClientEvent)) do
		            local f = conn.Function
		            if type(f) == 'function' and not ourFns[f] and not wrappedFns[f] and IsFrameworkHandler(f) then
		                wrappedFns[f] = true
		                local wrapper = function(a1, ...)
		                    -- the game's own handler errors on HUD parts that do not exist (e.g. MainScreenGui.DamageIndicator);
		                    -- through this wrapper that error was ours, so it is swallowed here
		                    if a1 == 'ShootingRecoil' and MODS.NoRecoil then
		                        local k = MODS.RecoilAmount / 100
		                        if k <= 0 then return end
		                        local first = ...
		                        pcall(f, a1, (first or 1) * k, select(2, ...))
		                        return
		                    end
		                    pcall(f, a1, ...)
		                end
		                ourFns[wrapper] = true
		                local ok = pcall(function() conn:Disable() end)
		                if ok then
		                    ev.OnClientEvent:Connect(wrapper)
		                end
		            end
		        end
		    end

		    -- the Framework script is re-created on every respawn, so keep looking for new handlers while the mod is on
		    local acc = 0
		    RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
		        if not MODS.NoRecoil then return end
		        acc = acc + dt
		        if acc < 0.5 then return end
		        acc = 0
		        pcall(ScanRecoil)
		    end))

		    -- ---------- ui ----------
		    local mods = _RG.tabs.rage:AddLeftGroupbox('mods')

		    mods:AddToggle('rage_no_spread', { Text = 'no spread', Default = false, Tooltip = 'Shotguns only. Turns the pellet pattern so as many pellets as possible hit whoever you are aiming near. Every pellet keeps the offset the server expects, so the hits still count.' })
		    library.Toggles.rage_no_spread:OnChanged(function(V)
		        MODS.NoSpread = V
		        if V then task.spawn(HookSpread) end
		    end)

		    mods:AddDropdown('rage_no_spread_mode', { Text = 'no spread mode', Values = { 'full', 'turn pattern' }, Default = 'full', Tooltip = 'Full sends every pellet dead straight, works with or without a target. Turn pattern keeps the real spread and only rotates it onto your target.' })
		    library.Options.rage_no_spread_mode:OnChanged(function(V) MODS.Full = (V ~= 'turn pattern') end)

		    mods:AddToggle('rage_no_recoil', { Text = 'no recoil', Default = false })
		    library.Toggles.rage_no_recoil:OnChanged(function(V)
		        MODS.NoRecoil = V
		        if V then task.spawn(function() pcall(ScanRecoil) end) end
		    end)
		    mods:AddSlider('rage_recoil_amount', { Text = 'recoil amount', Default = 0, Min = 0, Max = 100, Rounding = 0 })
		    library.Options.rage_recoil_amount:OnChanged(function(V) MODS.RecoilAmount = V end)

		    -- rapid fire: holding the mouse keeps pulling a semi-auto gun's trigger the instant its cooldown is over. it never
		    -- goes faster than the gun's own limit (cooldown + 0.0595s in the gun script), because the server checks that too
		    -- and shots faster than it are dropped or flagged
		    local RF = { on = false, nextAt = 0 }
		    local UIS = game:GetService('UserInputService')
		    local plr = game:GetService('Players').LocalPlayer
		    RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
		        if not RF.on then return end
		        if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or UIS:GetFocusedTextBox() then return end
		        -- clicking around in the open menu must never fire the gun
		        if menu_open or (_RG._Menu and _RG._Menu.on) then return end
		        local c = plr.Character
		        local tool = c and c:FindFirstChildOfClass('Tool')
		        local cd = tool and tool:FindFirstChild('ShootingCooldown')
		        if not cd or tool:FindFirstChild('GunClientAutomatic') or tool:FindFirstChild('GunClientAutomaticShotgun') then return end
		        local now = os.clock()
		        if now < RF.nextAt then return end
		        RF.nextAt = now + (tonumber(cd.Value) or 0.3) + 0.065
		        -- while the mouse is held the tool already counts as activated, so a second Activate() was ignored (that is
		        -- why the double barrel only shot once): release it first, then press again
		        pcall(function() tool:Deactivate() end)
		        pcall(function() tool:Activate() end)
		    end))
		    mods:AddToggle('rage_rapid_fire', { Text = 'rapid fire', Default = false, Tooltip = 'Hold left click and semi-auto guns keep firing as fast as the game allows, no spam clicking needed.' })
		    library.Toggles.rage_rapid_fire:OnChanged(function(V) RF.on = V end)
		end

		-- ============================================================
		-- rage: kill aura / sentry mode
		-- ============================================================
		do
		    local Players    = game:GetService('Players')
		    local RunService = game:GetService('RunService')
		    local lp         = Players.LocalPlayer

		    local R = {
		        Aura = false,   AuraDist = 250, AuraPart = 'UpperTorso', AuraWhitelist = {},
		        Sentry = false, SentryPart = 'UpperTorso', SentryTargets = {},
		    }
		    _RG._Rage = R

		    local PartList = { 'Head', 'UpperTorso', 'LowerTorso', 'HumanoidRootPart', 'LeftUpperArm', 'RightUpperArm', 'LeftLowerArm', 'RightLowerArm', 'LeftUpperLeg', 'RightUpperLeg', 'LeftFoot', 'RightFoot' }

		    -- same keybind scheme as fly / esp: with a key bound the toggle only arms it and the key switches it
		    local function Armed(toggle, key)
		        local kv = key.Value
		        local hasKey = kv ~= nil and kv ~= '...' and kv ~= 'None'
		        if hasKey then return toggle.Value and key:GetState() end
		        return toggle.Value
		    end

		    local GunInfo = LPH_NO_VIRTUALIZE(function()
		        local char = lp.Character
		        local hum = char and char:FindFirstChildOfClass('Humanoid')
		        if not hum or hum.Health <= 0 then return nil end
		        local tool = char:FindFirstChildOfClass('Tool')
		        if not tool or not tool:FindFirstChild('ShootingCooldown') then return nil end   -- only guns have this
		        local range = _RG._GunRange(tool)
		        local root = char:FindFirstChild('HumanoidRootPart')
		        if not root then return nil end
		        return char, tool, root, range
		    end)

		    local Valid = LPH_NO_VIRTUALIZE(function(player, maxDist, range, root)
		        local char = player.Character
		        local hrp = char and char:FindFirstChild('HumanoidRootPart')
		        local hum = char and char:FindFirstChildOfClass('Humanoid')
		        if not hrp or not hum or hum.Health <= 0 then return nil end
		        local dist = (hrp.Position - root.Position).Magnitude
		        if dist > _RG._SafeRange(range) or (maxDist and dist > maxDist) then return nil end
		        -- built in: knocked bodies and spawn protection can't be hurt, so they are never shot at
		        local be = char:FindFirstChild('BodyEffects')
		        local ko = be and be:FindFirstChild('K.O')
		        if (ko and ko.Value == true) or char:FindFirstChildOfClass('ForceField') then return nil end
		        -- the legit tab checks (knocked / grabbed / wall / whitelist) apply here too; its max distance does not
		        local passes = _RG._TA_PassesChecks
		        if passes and not passes(player, char, hrp, true) then return nil end
		        return char, dist
		    end)

		    -- each mode keeps its current target until that target is no longer valid (dead / knocked / out of range /
		    -- behind a wall / whitelisted) and only then looks for a new one, so it finishes one player before the next
		    local focusSentry, focusAura = nil, nil
		    local acquireAcc = 0

		    RunService.Heartbeat:Connect(_RG._Safe('kill aura', function(dt)
		        if not (R.Aura or R.Sentry) then focusSentry, focusAura = nil, nil; _RG._SentryFocus, _RG._AuraFocus = nil, nil; return end
		        -- no shooting while we are busy stomping or shopping
		        if os.clock() - (_RG._StompAllActive or 0) < 0.5 or os.clock() - (_RG._GrabActive or 0) < 0.5 or os.clock() < (_RG._BuyUntil or 0) then return end

		        local char, tool, root, range = GunInfo()
		        if not char then _RG._SentryFocus, _RG._AuraFocus = nil, nil; return end

		        -- looking for a fresh target (loops over every player + wall raycasts) is limited to 10x a second;
		        -- keeping the current target valid is checked every frame
		        acquireAcc = acquireAcc + dt
		        local mayAcquire = acquireAcc >= 0.1
		        if mayAcquire then acquireAcc = 0 end

		        local targetChar, part

		        if R.Sentry then
		            local pl = focusSentry
		            if pl and not (pl.Parent and R.SentryTargets[pl.Name] and Valid(pl, nil, range, root)) then pl = nil end
		            if not pl and mayAcquire then
		                local best = math.huge
		                for name in pairs(R.SentryTargets) do
		                    local cand = Players:FindFirstChild(name)
		                    if cand and cand ~= lp then
		                        local c, d = Valid(cand, nil, range, root)
		                        if c and d < best then best = d; pl = cand end
		                    end
		                end
		            end
		            focusSentry = pl
		            if pl then targetChar, part = pl.Character, R.SentryPart end
		        else
		            focusSentry = nil
		        end

		        if not targetChar and R.Aura then
		            local pl = focusAura
		            if pl and not (pl.Parent and not R.AuraWhitelist[pl.Name] and Valid(pl, R.AuraDist, range, root)) then pl = nil end
		            if not pl and mayAcquire then
		                local best = math.huge
		                for _, cand in ipairs(Players:GetPlayers()) do
		                    if cand ~= lp and not R.AuraWhitelist[cand.Name] then
		                        local c, d = Valid(cand, R.AuraDist, range, root)
		                        if c and d < best then best = d; pl = cand end
		                    end
		                end
		            end
		            focusAura = pl
		            if pl then targetChar, part = pl.Character, R.AuraPart end
		        elseif targetChar then
		            focusAura = nil
		        end

		        _RG._SentryFocus, _RG._AuraFocus = R.Sentry and focusSentry or nil, R.Aura and focusAura or nil
		        if targetChar then
		            _RG._Forced = { char = targetChar, part = part, t = os.clock() }
		            if _RG._TryHookGun then _RG._TryHookGun() end
		            -- activate then deactivate every frame: the tool is "released" again each time, so the gun's own
		            -- cooldown is the only thing limiting the fire rate
		            local tp = targetChar:FindFirstChild(part) or targetChar:FindFirstChild('HumanoidRootPart')
		            local from = (_RG._CSyncActive and _RG._CSyncPos) or root.Position
		            if tp and _RG._FireGate(os.clock(), true) and (not _RG._VoidFireOk or _RG._VoidFireOk(os.clock())) and (not _RG._ShotReady or _RG._ShotReady(os.clock()))
		                and not _RG._LOS(from, tp.Position, targetChar) and _RG._FireGate(os.clock()) then
		                _RG._Pull(tool)
		            end
		        end
		    end))

		    local function PlayerNames()
		        local names = {}
		        for _, p in ipairs(Players:GetPlayers()) do
		            if p ~= lp then names[#names + 1] = p.Name end
		        end
		        return names
		    end

		    -- ---------- kill aura ----------
		    local ka = _RG.tabs.rage:AddRightGroupbox('kill aura')
		    local UpdateAura
		    local KAToggle = ka:AddToggle('rage_kill_aura', { Text = 'kill aura', Default = false })
		    KAToggle:AddKeyPicker('rage_kill_aura_key', {
		        Default = 'None', SyncToggleState = false, Mode = 'Toggle', Text = 'kill aura', NoUI = false,
		        Callback = function() UpdateAura() end,
		    })
		    UpdateAura = function()
		        R.Aura = Armed(library.Toggles.rage_kill_aura, library.Options.rage_kill_aura_key) and true or false
		        if R.Aura and _RG._TryHookGun then task.spawn(_RG._TryHookGun) end
		    end
		    KAToggle:OnChanged(UpdateAura)

		    ka:AddSlider('rage_hit_chance', { Text = 'hit chance', Default = 85, Min = 0, Max = 100, Rounding = 0, Suffix = '%', Tooltip = 'Kill aura and sentry miss this often on purpose, a few studs to the side, so your accuracy looks human.' })
		    library.Options.rage_hit_chance:OnChanged(function(V) R.HitChance = V end)
		    ka:AddToggle('rage_kill_aura_reload', { Text = 'auto reload', Default = false, Tooltip = 'Reloads your gun the moment it runs dry while kill aura is on.' })
		    library.Toggles.rage_kill_aura_reload:OnChanged(function(V) R.AuraReload = V end)
		    ka:AddSlider('rage_kill_aura_dist', { Text = 'distance', Default = 250, Min = 10, Max = 1000, Rounding = 0 })
		    library.Options.rage_kill_aura_dist:OnChanged(function(V) R.AuraDist = V end)
		    ka:AddDropdown('rage_kill_aura_part', { Text = 'hit part', Values = PartList, Default = 'UpperTorso' })
		    library.Options.rage_kill_aura_part:OnChanged(function(V) R.AuraPart = V end)
		    ka:AddDropdown('rage_kill_aura_whitelist', {
		        Text = 'whitelist', Values = PlayerNames(), Multi = true, AllowNull = true, Default = {},
		    })
		    library.Options.rage_kill_aura_whitelist:OnChanged(function(V) R.AuraWhitelist = V or {} end)

		    -- ---------- sentry mode ----------
		    local sm = _RG.tabs.rage:AddRightGroupbox('sentry mode')
		    local UpdateSentry
		    local SMToggle = sm:AddToggle('rage_sentry', { Text = 'sentry mode', Default = false })
		    SMToggle:AddKeyPicker('rage_sentry_key', {
		        Default = 'None', SyncToggleState = false, Mode = 'Toggle', Text = 'sentry mode', NoUI = false,
		        Callback = function() UpdateSentry() end,
		    })
		    UpdateSentry = function()
		        R.Sentry = Armed(library.Toggles.rage_sentry, library.Options.rage_sentry_key) and true or false
		        if R.Sentry and _RG._TryHookGun then task.spawn(_RG._TryHookGun) end
		    end
		    SMToggle:OnChanged(UpdateSentry)

		    sm:AddToggle('rage_sentry_reload', { Text = 'auto reload', Default = false, Tooltip = 'Reloads your gun the moment it runs dry while sentry mode is on.' })
		    library.Toggles.rage_sentry_reload:OnChanged(function(V) R.SentryReload = V end)
		    sm:AddDropdown('rage_sentry_part', { Text = 'hit part', Values = PartList, Default = 'UpperTorso' })
		    library.Options.rage_sentry_part:OnChanged(function(V) R.SentryPart = V end)
		    sm:AddDropdown('rage_sentry_targets', {
		        Text = 'targets', Values = PlayerNames(), Multi = true, AllowNull = true, Default = {},
		    })
		    library.Options.rage_sentry_targets:OnChanged(function(V) R.SentryTargets = V or {} end)

		    -- keep both player lists current
		    local function RefreshLists()
		        task.wait(0.1)
		        local names = PlayerNames()
		        library.Options.rage_kill_aura_whitelist:SetValues(names)
		        library.Options.rage_sentry_targets:SetValues(names)
		        library.Options.rage_kill_aura_whitelist:SetValue(library.Options.rage_kill_aura_whitelist.Value or {})
		        library.Options.rage_sentry_targets:SetValue(library.Options.rage_sentry_targets.Value or {})
		    end
		    Players.PlayerAdded:Connect(RefreshLists)
		    Players.PlayerRemoving:Connect(RefreshLists)
		end

		-- ============================================================
		-- csync controller: buy > stomp (all / after kill) > void spam > strafe target
		-- (one loop decides what the replicated position is, the client is always put back to its real position)
		-- ============================================================
		do
		    local Players    = game:GetService('Players')
		    local RunService = game:GetService('RunService')
		    local lp         = Players.LocalPlayer

		    local ST = { Enabled = false, Distance = 8, Speed = 2, Angle = 0, Prediction = 1, Height = 6, SpamVoid = false }
		    _RG._Strafe = ST
		    _RG._CSyncActive = false     -- strafe position is currently the replicated one (used to shift shots)
		    _RG._CSyncPos = nil
		    _RG._IndicatorPos = nil      -- whatever is currently replicated (buy / stomp / void / strafe), for the indicator
		    _RG._StompAllActive = 0      -- os.clock() of the last frame spent on a knocked player
		    _RG._BuyUntil = 0
		    _RG._StompDelay = 0.05

		    local pendingCF, pendingRoot
		    local pendingApplied, pendingVel     -- the csync cframe we set, and the real velocity at that moment
		    local pendingStepped = false         -- true when it was applied before the physics step
		    local pendingExact = false           -- shopping / stomping: put the client back exactly, ignore what the physics did

		    local pingItem
		    pcall(function() pingItem = game:GetService('Stats').Network.ServerStatsItem['Data Ping'] end)
		    local lastTarget, lastTp, lastT, vel = nil, nil, 0, Vector3.zero
		    local leadSm = nil
		    local smoothCenter, lastPos = nil, nil
		    local stompTarget, stompScan = nil, 0
		    local blacklist = setmetatable({}, { __mode = 'k' })     -- bodies that did not die after being stomped for a while

		    local IsKnocked = LPH_NO_VIRTUALIZE(function(char)
		        local be = char and char:FindFirstChild('BodyEffects')
		        local ko = be and be:FindFirstChild('K.O')
		        local dead = be and be:FindFirstChild('Dead')
		        return ko ~= nil and ko.Value == true and not (dead and dead.Value == true)
		    end)

		    local FindStompTarget = LPH_NO_VIRTUALIZE(function(root)
		        local best, bestD = nil, math.huge
		        local wl = _RG._TAChecks and _RG._TAChecks.Whitelist or {}
		        for _, pl in ipairs(Players:GetPlayers()) do
		            local c = pl ~= lp and pl.Character
		            local r = c and c:FindFirstChild('HumanoidRootPart')
		            local hm = c and c:FindFirstChildOfClass('Humanoid')
		            if r and hm and hm.Health > 0 and (blacklist[c] or 0) < os.clock()
		                and not wl[pl.Name] and IsKnocked(c) and not c:FindFirstChildOfClass('ForceField')
		                and not ((_RG._TAChecks.CrewCheck or _RG._TAChecks.FriendCheck) and _RG._TA_IsFriendly(pl)) then
		                local d = (r.Position - root.Position).Magnitude
		                if d < bestD then best, bestD = c, d end
		            end
		        end
		        return best
		    end)

		    -- holding the mouse button means a shot is about to go out: be at the real position for it
		    game:GetService('UserInputService').InputBegan:Connect(function(input)
		        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		            _RG._DesyncPauseUntil = os.clock() + 0.4
		            if _RG._CSyncActive then _RG._CSyncShotUntil = os.clock() + 0.3 end
		        end
		    end)

		    -- body centre of a knocked player (the torso follows the ragdoll, the root part can stay behind)
		    local BodyPart = LPH_NO_VIRTUALIZE(function(c)
		        return c:FindFirstChild('UpperTorso') or c:FindFirstChild('Torso') or c:FindFirstChild('HumanoidRootPart')
		    end)

		    local attachSince, attachedTo = 0, nil
		    -- buying and stomping are real teleports that stay put for the whole action and then return: sending the
		    -- position for one frame and snapping back (csync) was not reliable enough for the server to register them
		    local returnCF = nil
		    local lastOffset = Vector3.new(8, 0, 0)
		    local postStompUntil, wasStomping = 0, false     -- hide in the void for a moment after a stomp
		    local grabSent, grabSince, grabBlockedUntil = 0, nil, 0
		    -- quick teleport: csync glued above the locked target, one shot once the server has us there, then straight back
		    local QT = { Enabled = false, Height = 6, Gap = 0.6, phase = 'idle', start = 0, shot = false, shotAt = 0, nextAt = 0, backUntil = 0 }
		    _RG._QT = QT

		    -- two timings, chosen with the "csync mode" dropdown (desync box):
		    --  * client normal   (default): runs on Heartbeat, AFTER the physics step. the character's physics only ever run at
		    --                      the real position, so walking / jumping / falling on the client are completely untouched.
		    --                      the server sometimes gets the real position instead of the csync one (less reliable).
		    --  * server reliable: runs on Stepped, right BEFORE the physics step, so the csync position is in place for the
		    --                      physics step and the network send. most reliable for the server, but the physics step runs
		    --                      at the csync spot, which can make the client feel off (floating, spinning, no jumping).
		    -- reliable timing is on when the dropdown says so, or for a moment around every shot while strafing
		    -- every csync feature used to force "server reliable" timing. that runs YOUR character's physics at the fake spot
		    -- (the void, a shop pad, above a target) and then guesses your real movement back, which is what made you shake,
		    -- float and fly badly. now everything uses the clean timing: physics always runs where you really are, the fake
		    -- spot is only swapped in after physics for the network send and put back before the frame is drawn.
		    -- "server reliable" is still there in the csync mode dropdown if you ever want it.
		    local Reliable = function(now) return _RG._CSyncReliable == true end
		    -- things that must happen while the fake spot is in place (shots from above a target): run right after it is set
		    _RG._PostCSync = _RG._PostCSync or {}
		    _RG._ShotReady = function(now)
		        if not _RG._CSyncActive or _RG._CSyncReliable then return true end
		        if now >= (_RG._CSyncShotUntil or 0) then _RG._CSyncShotStart = now end
		        _RG._CSyncShotUntil = now + 0.3
		        return now - (_RG._CSyncShotStart or now) >= 0.07
		    end
		    local Tick
		    Tick = LPH_NO_VIRTUALIZE(function(dt)
		        -- fly / velocity speed run from here so they always happen BEFORE the replicated position is chosen
		        -- (separate connections run in an unpredictable order, which froze the client while flying)
		        if _RG._MoveStep then _RG._MoveStep(dt) end

		        local VS = _RG._VoidSpam
		        local SA = _RG._StompAll
		        local TA = _RG._TargetAim
		        local now = os.clock()
		        local lock = TA and TA.LockedTarget
		        local lockKnocked = lock ~= nil and lock.Parent ~= nil and IsKnocked(lock)
		        local buying = now < _RG._BuyUntil and _RG._BuyPos ~= nil
		        -- after a quick teleport trip we are back home for a moment before any stomp / grab trip starts
		        local stompAfter = TA and TA.StompAfter and lockKnocked and now >= QT.backUntil
		        -- grab after: csync onto the knocked lock, grab it with the game's own "Grabbing" call, come back carrying it
		        local myChar = lp.Character
		        local wantGrab = TA and TA.GrabAfter and lockKnocked and now >= grabBlockedUntil and now >= QT.backUntil
		            and not (myChar and myChar:FindFirstChild('GRABBING_CONSTRAINT')) and not lock:FindFirstChild('GRABBING_CONSTRAINT')
		        local wantStrafe = ST.Enabled
		        local wantVoid = VS and VS.Enabled
		        local wantStomp = (SA and SA.Enabled) or stompAfter
		        -- auto stomp (standing on a knocked player) also counts as stomping for the "void after stomp" hide-away
		        local autoStomping = now - (_RG._AutoStompAt or 0) < 0.5
		        if wasStomping and not (autoStomping or now - (_RG._StompAllActive or 0) < 0.15) then
		            wasStomping = false
		            postStompUntil = now + (_RG._VoidAfterStomp or 2)
		        elseif autoStomping or now - (_RG._StompAllActive or 0) < 0.15 then
		            wasStomping = true
		        end
		        local hiding = now < postStompUntil or now < (_RG._ForceHideUntil or 0)
		        -- reload in void: while the held gun reloads the replicated position is in the void, over everything else
		        local reloadVoid = false
		        if _RG._ReloadVoid then
		            local c0 = lp.Character
		            local be0 = c0 and c0:FindFirstChild('BodyEffects')
		            local rl0 = be0 and be0:FindFirstChild('Reload')
		            reloadVoid = rl0 ~= nil and rl0.Value == true
		        end
		        if not wantGrab then grabSince = nil end

		        -- quick teleport: starts a trip when the lock is up, alive, out of the void and our gun has a shell ready
		        local lockRoot = lock and lock.Parent and lock:FindFirstChild('HumanoidRootPart')
		        local lockHum = lock and lock.Parent and lock:FindFirstChildOfClass('Humanoid')
		        local qtTool = myChar and myChar:FindFirstChildOfClass('Tool')
		        local qtAmmo = qtTool and qtTool:FindFirstChild('Ammo')
		        local myBE = myChar and myChar:FindFirstChild('BodyEffects')
		        local myReload = myBE and myBE:FindFirstChild('Reload')
		        local fh = workspace.FallenPartsDestroyHeight
		        if fh == nil or fh ~= fh or fh < -3000 then fh = -3000 end
		        local qtReady = QT.Enabled and TA ~= nil and TA.Enabled and lockRoot ~= nil and lockHum ~= nil and lockHum.Health > 0
		            and not lockKnocked and lockRoot.Position.Y > fh + 300
		            and qtTool ~= nil and qtTool:FindFirstChild('ShootingCooldown') ~= nil and qtAmmo ~= nil and qtAmmo.Value > 0
		            and not (myReload and myReload.Value == true)
		        if QT.phase == 'trip' and not qtReady then
		            QT.phase, QT.backUntil = 'idle', now + 0.15
		        end
		        if QT.phase == 'idle' and qtReady and now >= QT.nextAt and not buying then
		            QT.phase, QT.start, QT.shot = 'trip', now, false
		        end
		        local wantQT = QT.phase == 'trip'
		        -- the ragebot decides the replicated position itself while it runs (void, above a target, on a body)
		        local RBs = _RG._RB
		        local rbWant = RBs and RBs.Running and RBs.Want or nil
		        local rbExact = false
		        if rbWant then wantQT = false end

		        if not (wantStrafe or wantVoid or wantStomp or wantGrab or wantQT or rbWant or buying or returnCF or hiding or reloadVoid or (_RG._Panic and _RG._Panic.Enabled)) then
		            _RG._CSyncActive, _RG._IndicatorPos, lastTarget = false, nil, nil
		            -- nothing wants the replicated position any more, so nothing is hiding either. The flag used to stay on from
		            -- the last hiding frame (reload in void, after a stomp, eating) and _VoidFireOk then refused every automatic
		            -- shot, so auto fire, kill aura and sentry just stopped until you respawned
		            _RG._Hiding = false
		            _RG._StrafeLive = false
		            return
		        end
		        if pendingCF then return end

		        local char = lp.Character
		        local root = char and char:FindFirstChild('HumanoidRootPart')
		        local hum = char and char:FindFirstChildOfClass('Humanoid')
		        if not root or not hum or hum.Health <= 0 then
		            _RG._Hiding = false
		            _RG._StrafeLive = false
		            _RG._CSyncActive, _RG._IndicatorPos = false, nil
		            returnCF = nil
		            return
		        end

		        -- hide when hurt: below the chosen health the replicated position stays in the void until we are healed up
		        do
		            local P = _RG._Panic
		            if P and P.Enabled then
		                local frac = hum.Health / math.max(hum.MaxHealth, 1)
		                if frac < P.Pct / 100 then P.Hidden = true elseif frac >= 0.95 then P.Hidden = false end
		                if P.Hidden then hiding = true end
		            elseif P then
		                P.Hidden = false
		            end
		        end

		        _RG._Hiding = hiding or reloadVoid or (_RG._ForceHideUntil or 0) > now

		        -- strafe position (computed every frame so the prediction / smoothing stay continuous)
		        local strafePos
		        ST.SpamVoid = false
		        -- a knocked target is not strafed: we stay normal (or go stomp it) and strafe again once it is back up
		        if wantStrafe and not lockKnocked then
		            local troot = lock and lock.Parent and lock:FindFirstChild('HumanoidRootPart')
		            if troot then
		                local tp = troot.Position
		                if lastTarget ~= lock then
		                    lastTarget, lastTp, vel, smoothCenter, leadSm = lock, nil, Vector3.zero, nil, nil
		                end
		                local v = troot.AssemblyLinearVelocity
		                -- a target that moves by cframe (another strafer) reports ~0, so the speed is also measured from how far
		                -- it moved since the last frame, and the bigger of the two is used
		                if lastTp and now - lastT >= 1 / 240 then
		                    local dv = (tp - lastTp) / (now - lastT)
		                    if dv.Magnitude > v.Magnitude then v = dv end
		                end
		                if v.Magnitude > 700 then v = Vector3.zero end              -- only a real teleport is thrown away
		                -- fast targets need a quick response, slow ones a steady centre
		                vel = vel:Lerp(v, math.clamp(0.3 + v.Magnitude / 120, 0.3, 0.85))
		                lastTp, lastT = tp, now

		                local ping = 0.05
		                if pingItem then
		                    local ok, ms = pcall(pingItem.GetValue, pingItem)
		                    if ok and ms then ping = ms / 1000 end
		                end
		                -- no smoothing on the centre itself (it only added lag behind the target); the velocity is smoothed
		                local T = math.clamp(ping * 2, 0.05, 0.6) * (ST.Prediction or 1)
		                local rp = _RG._TA_Resolved and _RG._TA_Resolved(lock)
		                if rp then tp = rp end
		                local center = tp
		                if not rp then
		                    center = tp + (_RG._TA_Velocity and _RG._TA_Velocity(lock, troot) or vel) * T
		                end

		                -- glued right above the target. it stops while reloading or without a gun in hand
		                local be = char:FindFirstChild('BodyEffects')
		                local rl = be and be:FindFirstChild('Reload')
		                local tool = char:FindFirstChildOfClass('Tool')
		                local stopFollow = (rl ~= nil and rl.Value == true) or not (tool and tool:FindFirstChild('ShootingCooldown'))

		                if not stopFollow then
		                    local h = ST.Height
		                    strafePos = center + Vector3.new(0, h, 0)
		                    -- something solid in the way (a roof): come down until the line to the target is clear
		                    if _RG._LOS and _RG._LOS(strafePos, tp, lock) then
		                        for _, k in ipairs({ 0.7, 0.5, 0.3 }) do
		                            local cand = center + Vector3.new(0, h * k, 0)
		                            if not _RG._LOS(cand, tp, lock) then strafePos = cand break end
		                        end
		                    end
		                end
		                if strafePos then lastPos = strafePos end
		                ST.Center = center
		            else
		                lastTarget = nil
		            end
		        end

		        _RG._StrafeLive = strafePos ~= nil or ST.SpamVoid
		        local holding = now < (_RG._DesyncPauseUntil or 0)     -- just fired a shot
		        local cf, indicator, hold, glue
		        _RG._CSyncActive = false

		        -- 0. reloading with "reload in void" on: nothing else may move us out of the void
		        if reloadVoid then
		            local p = _RG._VoidPos(root.Position)
		            cf = root.CFrame.Rotation + p
		            indicator = p
		        end

		        -- 1. shopping trip (auto buy / buy buttons)
		        if buying and not cf then
		            cf = root.CFrame.Rotation + _RG._BuyPos
		            indicator = _RG._BuyPos
		        end

		        -- 1a. ragebot: comes before everything but shopping
		        if not cf and rbWant then
		            local p, exact = RBs.PosFor(rbWant, root)
		            if p then
		                cf = root.CFrame.Rotation + p
		                indicator = p
		                rbExact = exact == true
		            end
		        end

		        -- 1b. grab after: right next to the knocked lock, grab sent every 0.35s until the game says we carry them
		        if not cf and wantGrab then
		            local sroot = BodyPart(lock)
		            if sroot then
		                local p = sroot.Position + Vector3.new(0, 2.6, 0)
		                cf = root.CFrame.Rotation + p
		                indicator = p
		                _RG._GrabActive = now
		                grabSince = grabSince or now
		                if now - grabSent >= 0.35 and now - grabSince >= 0.05 then
		                    grabSent = now
		                    local ev = game:GetService('ReplicatedStorage'):FindFirstChild('MainEvent')
		                    if ev then ev:FireServer('Grabbing', false) end
		                end
		                -- still not carrying them after a while (someone else has them, or they got up): leave it for a bit
		                if now - grabSince > 2 then grabBlockedUntil, grabSince = now + 3, nil end
		            end
		        end

		        -- 2. stomp: nearest knocked player (stomp all), or the locked target once it is knocked (stomp after)
		        if not cf and wantStomp then
		            if stompAfter then
		                stompTarget = lock
		            else
		                if stompTarget and not (stompTarget.Parent and IsKnocked(stompTarget)) then stompTarget = nil end
		                if not stompTarget and now - stompScan > 0.1 then
		                    stompScan = now
		                    stompTarget = FindStompTarget(root)
		                end
		            end
		            local sroot = stompTarget and BodyPart(stompTarget)
		            if sroot then
		                -- glued to the body: recomputed every frame from the torso, standing right on top of it
		                local p = sroot.Position + Vector3.new(0, 2.6, 0)
		                cf = root.CFrame.Rotation + p
		                indicator = p
		                if attachedTo ~= stompTarget or now - (_RG._StompAllActive or 0) > 0.3 then
		                    attachedTo, attachSince = stompTarget, now      -- just arrived on this body
		                end
		                _RG._StompAllActive = now
		                _RG._StompAttachSince = attachSince
		                _RG._StompTargetChar = stompTarget
		                -- stomped for a while and still not dead (already stomped / not stompable): give up on it for a bit
		                if now - attachSince > 1.5 and not stompAfter then
		                    blacklist[stompTarget] = now + 4
		                    stompTarget, attachedTo = nil, nil
		                end
		            elseif SA and SA.Enabled then
		                -- stomp all with nobody to stomp: keep hopping around the void so nobody can target us
		                local p = _RG._VoidPos(root.Position)
		                cf = root.CFrame.Rotation + p
		                indicator = p
		            end
		        end

		        -- 2a. quick teleport: glued right above the target (lower if a roof is in the way), real cframe, csync only
		        if not cf and wantQT and lockRoot then
		            local tp = lockRoot.Position
		            local rp = _RG._TA_Resolved and _RG._TA_Resolved(lock)
		            if rp then tp = rp end
		            local above = tp + Vector3.new(0, QT.Height, 0)
		            if _RG._LOS and _RG._LOS(above, tp, lock) then
		                for _, k in ipairs({ 0.6, 0.3 }) do
		                    local cand = tp + Vector3.new(0, QT.Height * k, 0)
		                    if not _RG._LOS(cand, tp, lock) then above = cand break end
		                end
		            end
		            cf = root.CFrame.Rotation + above
		            indicator = above
		        end

		        -- 2b. just finished a stomp: hide in the void for a few seconds (even while the mouse is held down)
		        if not cf and hiding then
		            local p = _RG._VoidPos(root.Position)
		            cf = root.CFrame.Rotation + p
		            indicator = p
		        end

		        -- 3. void spam: random spots all over the void
		        if not cf and wantVoid and _RG._VoidPhase(now) then
		            local p = _RG._VoidPos(root.Position)
		            cf = root.CFrame.Rotation + p
		            indicator = p
		        end

		        -- 3b. random spam: the void half of its cycle
		        if not cf and ST.SpamVoid then
		            local p = _RG._VoidPos(root.Position)
		            cf = root.CFrame.Rotation + p
		            indicator = p
		        end

		        -- 4. strafe target: really teleported on top of the locked target, looking straight down (client side too)
		        if not cf and strafePos then
		            cf = CFrame.lookAt(strafePos, strafePos - Vector3.yAxis, Vector3.zAxis)
		            indicator = strafePos
		            glue = true
		        end

		        if glue then
		            -- no csync here: the client itself sits on the target every frame, nothing to put back
		            root.CFrame = cf
		            root.AssemblyLinearVelocity = Vector3.zero
		            root.AssemblyAngularVelocity = Vector3.zero
		            _RG._IndicatorPos, _RG._IndicatorCF = indicator, cf
		        elseif hold then

		            -- real teleport that stays for the whole action; remember where we really were
		            if not returnCF then returnCF = root.CFrame end
		            root.CFrame = cf
		            _RG._IndicatorPos, _RG._IndicatorCF = indicator, cf
		        elseif returnCF then
		            -- the action is over: back to where we were, then carry on normally next frame
		            root.CFrame = returnCF
		            returnCF = nil
		            _RG._IndicatorPos = nil
		        elseif cf then
		            pendingCF, pendingRoot = root.CFrame, root
		            pendingApplied, pendingVel = cf, root.AssemblyLinearVelocity
		            pendingStepped = Reliable(now)
		            pendingExact = buying or rbExact or (now - (_RG._StompAllActive or 0) < 0.05) or (now - (_RG._GrabActive or 0) < 0.05)
		            root.CFrame = cf
		            _RG._IndicatorPos, _RG._IndicatorCF = indicator, cf
		        else
		            _RG._IndicatorPos = nil
		        end
		    end)
		    -- quick teleport shooting: waits until the server has had time to put us above the target (ping plus a bit, never
		    -- instant), pulls the trigger once from there, stays a moment so the shot leaves from that spot, then ends the trip
		    table.insert(_RG._PostCSync, _RG._Safe('quick teleport', function()
		        if QT.phase ~= 'trip' then return end
		        local now = os.clock()
		        local ping = 0.08
		        if pingItem then
		            local ok, ms = pcall(pingItem.GetValue, pingItem)
		            if ok and ms then ping = ms / 1000 end
		        end
		        local settle = math.clamp(ping * 1.2 + 0.05, 0.1, 0.5)
		        local c = lp.Character
		        local tool = c and c:FindFirstChildOfClass('Tool')
		        if not QT.shot then
		            if now - QT.start >= settle and tool then
		                if _RG._TryHookGun then _RG._TryHookGun() end
		                _RG._Pull(tool)
		                QT.shot, QT.shotAt = true, now
		            end
		        elseif now - QT.shotAt >= 0.12 then
		            -- automatic guns are held down by _Pull: let go here so nothing fires once we are back home
		            if tool and tool:FindFirstChild('GunClientAutomatic') then pcall(function() tool:Deactivate() end) end
		            local cd = tool and tool:FindFirstChild('ShootingCooldown')
		            QT.phase, QT.backUntil = 'idle', now + 0.15
		            QT.nextAt = now + math.max(QT.Gap, cd and (tonumber(cd.Value) or 0) + 0.1 or 0)
		        end
		        if QT.phase == 'trip' and now - QT.start > 1.5 then
		            QT.phase, QT.backUntil, QT.nextAt = 'idle', now + 0.15, now + QT.Gap
		        end
		    end))

		    local SafeTick = _RG._Safe('strafe', function(dt) Tick(dt) end)
		    RunService.Stepped:Connect(LPH_NO_VIRTUALIZE(function(_, dt)
		        if Reliable(os.clock()) then SafeTick(dt) end
		    end))
		    RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
		        if not Reliable(os.clock()) then SafeTick(dt) end
		        -- now the fake spot (if any) is in place: shots that have to leave from there go out here
		        for _, fn in ipairs(_RG._PostCSync) do pcall(fn) end
		    end))

		    -- always runs (also after everything was switched off), so the client can never be left sitting elsewhere
		    -- with "server reliable" timing the physics step runs at the csync spot (often the void, no floor), so gravity,
		    -- landing and jumping never happen at the real position. they are worked out here instead: without this the
		    -- vertical speed was frozen every frame, which is what made jumps floaty and slow (the astronaut feeling)
		    local vertParams = RaycastParams.new()
		    vertParams.FilterType = Enum.RaycastFilterType.Exclude
		    vertParams.IgnoreWater = true
		    local function Vertical(r, basePos, vy, dt)
		        local char = r.Parent
		        local hum = char and char:FindFirstChildOfClass('Humanoid')
		        local g = workspace.Gravity
		        local stand = (hum and hum.HipHeight or 2) + r.Size.Y / 2
		        local ign = workspace:FindFirstChild('Ignored')
		        vertParams.FilterDescendantsInstances = ign and { char, ign } or { char }
		        local hit = workspace:Raycast(basePos, Vector3.new(0, -(stand + 4), 0), vertParams)
		        local floorY = hit and (hit.Position.Y + stand) or nil
		        if floorY and basePos.Y - floorY <= 0.35 and vy <= 0.5 then
		            if hum and hum.Jump then
		                local jv = hum.UseJumpPower and hum.JumpPower or math.sqrt(2 * g * hum.JumpHeight)
		                return basePos.Y + jv * dt, jv
		            end
		            return floorY, 0
		        end
		        vy = math.max(vy - g * dt, -250)
		        local y = basePos.Y + vy * dt
		        if floorY and y < floorY then y, vy = floorY, 0 end
		        return y, vy
		    end

		    RunService:BindToRenderStep('fz_strafe_restore', Enum.RenderPriority.First.Value, LPH_NO_VIRTUALIZE(function(dt)
		        dt = math.clamp(dt or 1 / 60, 1 / 240, 0.1)
		        if pendingCF then
		            local r = pendingRoot
		            if r and r.Parent and not pendingStepped then
		                -- client normal mode: physics already ran at the real position, just put it back
		                r.CFrame = pendingCF
		            elseif r and r.Parent and pendingExact then
		                -- a shopping / stomping trip: no walking is carried over (bumping into whatever stands at the pad
		                -- nudged the client around), but gravity and landing still happen at the real position
		                local p = pendingCF.Position
		                local y, vy = Vertical(r, p, pendingVel.Y, dt)
		                r.CFrame = pendingCF.Rotation + Vector3.new(p.X, y, p.Z)
		                r.AssemblyLinearVelocity = Vector3.new(pendingVel.X, vy, pendingVel.Z)
		            elseif r and r.Parent then
		                -- the physics step ran with the root at the csync position. whatever the player did during it
		                -- (walking, turning) is carried over onto the real position, otherwise the client is frozen.
		                -- only the horizontal part is carried: falling at a csync spot with no floor (the void) must not
		                -- leak into the real position. the horizontal velocity is left alone (resetting it every frame made
		                -- the character crawl and drift on its own); only the vertical speed is put back so it cannot build up.
		                local cur = r.CFrame
		                local d = cur.Position - pendingApplied.Position
		                local rot = (cur.Rotation * pendingApplied.Rotation:Inverse()) * pendingCF.Rotation
		                -- only what the player could really have walked in one step is carried over: whatever the csync spot
		                -- pushed the character by (the target's body, a wall) must never end up on the real position
		                local dm = Vector3.new(d.X, 0, d.Z)
		                if dm.Magnitude > 1.5 then dm = dm.Unit * 1.5 end
		                local p = pendingCF.Position + dm
		                local y, vy = Vertical(r, p, pendingVel.Y, dt)
		                r.CFrame = rot + Vector3.new(p.X, y, p.Z)
		                local v = r.AssemblyLinearVelocity
		                r.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
		            end
		            pendingCF, pendingRoot, pendingApplied, pendingVel = nil, nil, nil, nil
		        end
		    end))

		    local function Armed(toggle, key)
		        local kv = key.Value
		        local hasKey = kv ~= nil and kv ~= '...' and kv ~= 'None'
		        if hasKey then return toggle.Value and key:GetState() end
		        return toggle.Value
		    end

		    local box = _RG._TA_Box
		    box:AddToggle('target_no_spread', { Text = 'no spread (shotguns)', Default = true, Tooltip = 'Turns the shotgun pattern so most pellets land on your target. Up close they all hit, further out you still get at least one.' })
		    library.Toggles.target_no_spread:OnChanged(function(V) _RG._TANoSpread = V end)
		    box:AddToggle('target_resolver', { Text = 'spam resolver', Default = false })
		    library.Toggles.target_resolver:OnChanged(function(V) if _RG._TA_Resolver then _RG._TA_Resolver.Enabled = V end end)
		    box:AddToggle('target_auto_switch', { Text = 'auto switch', Default = false, Tooltip = 'When your target dies, leaves or goes down, the lock jumps to whoever is closest to your cursor.' })
		    library.Toggles.target_auto_switch:OnChanged(function(V) if _RG._TargetAim then _RG._TargetAim.AutoSwitch = V end end)
		    box:AddToggle('target_smart_part', { Text = 'smart hit part', Default = false, Tooltip = 'If the part you picked is behind cover, it shoots whatever part of them is still showing.' })
		    library.Toggles.target_smart_part:OnChanged(function(V) _RG._SmartPart = V end)
		    box:AddToggle('target_reload_void', { Text = 'reload in void', Default = false })
		    library.Toggles.target_reload_void:OnChanged(function(V) _RG._ReloadVoid = V end)

		    -- watch the locked target (the camera goes back to you when the lock is released)
		    local viewLocked = false
		    box:AddToggle('target_view', { Text = 'view locked target', Default = false })
		    library.Toggles.target_view:OnChanged(function(V)
		        viewLocked = V
		        if not V then
		            local cam = workspace.CurrentCamera
		            local h = lp.Character and lp.Character:FindFirstChildOfClass('Humanoid')
		            if cam and h then cam.CameraSubject = h end
		        end
		    end)
		    RunService.RenderStepped:Connect(LPH_NO_VIRTUALIZE(function()
		        if not viewLocked then return end
		        local cam = workspace.CurrentCamera
		        if not cam then return end
		        local lock = _RG._TargetAim and _RG._TargetAim.LockedTarget
		        local subject = lock and lock.Parent and lock:FindFirstChildOfClass('Humanoid')
		        subject = subject or (lp.Character and lp.Character:FindFirstChildOfClass('Humanoid'))
		        if subject and cam.CameraSubject ~= subject then cam.CameraSubject = subject end
		    end))

		    box:AddToggle('target_wait_respawn', { Text = 'wait for respawn', Default = true, Tooltip = 'When your target dies you wait in the void while they respawn, then they get locked again as soon as their spawn protection is gone.' })
		    library.Toggles.target_wait_respawn:OnChanged(function(V)
		        if _RG._TargetAim then
		            _RG._TargetAim.WaitRespawn = V
		            if not V then _RG._TargetAim.WaitFor = nil end
		        end
		    end)
		    box:AddToggle('target_auto_reload', { Text = 'auto reload', Default = false, Tooltip = 'Reloads your gun the moment it runs dry while you have someone locked.' })
		    library.Toggles.target_auto_reload:OnChanged(function(V) if _RG._TargetAim then _RG._TargetAim.AutoReload = V end end)

		    box:AddToggle('target_quick_tp', { Text = 'quick teleport', Default = false, Tooltip = 'Pops above your target for a split second (only the server sees it, you stay put), shoots once it has landed there, then comes back. With stomp or grab after on, it comes back first and then goes to finish them.' })
		    library.Toggles.target_quick_tp:OnChanged(function(V)
		        QT.Enabled = V
		        if not V then QT.phase = 'idle' end
		        if V and _RG._TryHookGun then task.spawn(_RG._TryHookGun) end
		    end)
		    box:AddSlider('target_quick_tp_height', { Text = 'height above them', Default = 6, Min = 2, Max = 20, Rounding = 0 })
		    library.Options.target_quick_tp_height:OnChanged(function(V) QT.Height = V end)
		    box:AddSlider('target_quick_tp_gap', { Text = 'time between trips', Default = 0.6, Min = 0.2, Max = 3, Rounding = 2, Increment = 0.05, Suffix = 's' })
		    library.Options.target_quick_tp_gap:OnChanged(function(V) QT.Gap = V end)

		    box:AddToggle('target_grab_after', { Text = 'grab after', Default = false, Tooltip = 'When your target gets knocked, you pop over to them, pick them up and come straight back carrying them. Wins over stomp after if both are on.' })
		    library.Toggles.target_grab_after:OnChanged(function(V)
		        if _RG._TargetAim then _RG._TargetAim.GrabAfter = V end
		    end)

		    -- when the locked target gets knocked: csync onto their body, stomp, and come back
		    box:AddToggle('target_stomp_after', { Text = 'stomp after', Default = false })
		    library.Toggles.target_stomp_after:OnChanged(function(V)
		        if _RG._TargetAim then _RG._TargetAim.StompAfter = V end
		    end)

		    -- csync timing, see the comment above the controller
		    _RG._DesyncBox:AddDropdown('misc_csync_mode', {
		        Text = 'csync mode', Values = { 'client normal', 'server reliable' }, Default = 'client normal',
		    })
		    library.Options.misc_csync_mode:OnChanged(function(V) _RG._CSyncReliable = (V == 'server reliable') end)

		    -- how much of the moving-target lead is used (shots and strafe). 0 = aim exactly where the target is seen
		    box:AddSlider('target_prediction', { Text = 'prediction', Default = 100, Min = 0, Max = 100, Rounding = 0 })
		    library.Options.target_prediction:OnChanged(function(V)
		        ST.Prediction = V / 100
		        if _RG._TargetAim then _RG._TargetAim.Prediction = V / 100 end
		    end)
		end

		-- ============================================================
		-- misc: miscellaneous (auto stomp / stomp all)
		-- ============================================================
		do
		    local Players           = game:GetService('Players')
		    local RunService        = game:GetService('RunService')
		    local ReplicatedStorage = game:GetService('ReplicatedStorage')
		    local lp                = Players.LocalPlayer

		    local SA = { Enabled = false }
		    _RG._StompAll = SA
		    local AUTO = { Enabled = false, Animation = false }

		    -- plays the game's own stomp (animation, 0.75s wind up, then the remote) by firing its stomp button
		    local function GameStomp()
		        local pg = lp:FindFirstChildOfClass('PlayerGui')
		        local btn = pg and pg:FindFirstChild('MainScreenGui')
		        btn = btn and btn:FindFirstChild('MobileLayout')
		        btn = btn and btn:FindFirstChild('Stomp')
		        if btn and type(getconnections) == 'function' then
		            return (pcall(function()
		                for _, c in ipairs(getconnections(btn.Activated)) do c:Fire() end
		            end))
		        end
		        return false
		    end

		    local mainEvent
		    local function RemoteStomp()
		        mainEvent = mainEvent or ReplicatedStorage:FindFirstChild('MainEvent')
		        if mainEvent then mainEvent:FireServer('Stomp') end
		    end

		    local pingStat
		    pcall(function() pingStat = game:GetService('Stats').Network.ServerStatsItem['Data Ping'] end)
		    local function Ping()
		        if pingStat then
		            local ok, ms = pcall(pingStat.GetValue, pingStat)
		            if ok and ms then return ms / 1000 end
		        end
		        return 0.08
		    end

		    local lastStomp, lastScan, standing = 0, 0, false
		    RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
		        local now = os.clock()
		        local delay = _RG._StompDelay or 0.1

		        -- csync stomping (stomp all / stomp after): the controller has us on a knocked player right now
		        if now - (_RG._StompAllActive or 0) < 0.25 then
		            -- send the stomp from the very first frame on the body and keep sending it every `delay` seconds: the
		            -- ones that arrive before the server has our position are simply ignored, the first one after it counts
		            if now - lastStomp >= delay then
		                lastStomp = now
		                RemoteStomp()
		            end
		            return
		        end

		        if not AUTO.Enabled then standing = false; return end
		        local char = lp.Character
		        local root = char and (char:FindFirstChild('LowerTorso') or char:FindFirstChild('HumanoidRootPart'))
		        local hum = char and char:FindFirstChildOfClass('Humanoid')
		        if not root or not hum or hum.Health <= 0 then standing = false; return end

		        if now - lastScan >= 0.03 then      -- checked about every other frame so the stomp starts the moment you land on them
		            lastScan = now
		            local params = RaycastParams.new()
		            params.FilterType = Enum.RaycastFilterType.Exclude
		            params.FilterDescendantsInstances = { char }
		            local hit = workspace:Raycast(root.Position, Vector3.new(0, -6, 0), params)
		            local model = hit and hit.Instance:FindFirstAncestorOfClass('Model')
		            local be = model and model:FindFirstChild('BodyEffects')
		            local ko = be and be:FindFirstChild('K.O')
		            standing = ko ~= nil and ko.Value == true
		            -- the ray straight down misses when you are a little off the body: also count any knocked player whose
		            -- torso is right under or next to your feet
		            if not standing then
		                for _, pl in ipairs(Players:GetPlayers()) do
		                    local c = pl ~= lp and pl.Character
		                    local t = c and (c:FindFirstChild('UpperTorso') or c:FindFirstChild('HumanoidRootPart'))

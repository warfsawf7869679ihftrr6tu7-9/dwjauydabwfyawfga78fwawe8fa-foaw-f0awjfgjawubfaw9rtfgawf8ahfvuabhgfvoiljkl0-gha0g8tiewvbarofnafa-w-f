		-- hit core: one health watcher shared by notify hit / damage numbers / hit chams / hit skeleton
		-- ============================================================
		do
		    local Players          = game:GetService('Players')
		    local UserInputService = game:GetService('UserInputService')
		    local lp               = Players.LocalPlayer

		    local HitCore = { consumers = {}, active = false }
		    _RG._HitCore = HitCore

		    local watched = {}   -- [player] = { charConn, hpConn }
		    local pending = {}   -- [player] = damage accumulated this burst

		    -- best guess at which body part took the hit
		    local GuessPart = LPH_NO_VIRTUALIZE(function(char)
		        local rec = _RG._LastTAPart
		        if rec and rec.char == char and (os.clock() - rec.t) < 0.8 then
		            local p = char:FindFirstChild(rec.name)
		            if p then return p end
		        end
		        local cam = workspace.CurrentCamera
		        if cam then
		            local m = UserInputService:GetMouseLocation()
		            local ray = cam:ViewportPointToRay(m.X, m.Y)
		            local params = RaycastParams.new()
		            params.FilterType = Enum.RaycastFilterType.Include
		            params.FilterDescendantsInstances = { char }
		            local res = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
		            if res and res.Instance then return res.Instance end
		        end
		        return char:FindFirstChild('UpperTorso') or char:FindFirstChild('Torso') or char:FindFirstChild('HumanoidRootPart')
		    end)

		    local Emit = LPH_NO_VIRTUALIZE(function(player, char, dmg, headshot)
		        local lchar = lp.Character
		        local weapon = lchar and lchar:GetAttribute('LocalLastFiredGun')
		        if not weapon then
		            local tool = lchar and lchar:FindFirstChildOfClass('Tool')
		            weapon = tool and tool.Name or 'weapon'
		        end
		        local part = (headshot and char:FindFirstChild('Head')) or GuessPart(char)
		        local ev = {
		            player = player, char = char, dmg = dmg, part = part,
		            partName = part and part.Name or 'UpperTorso', weapon = tostring(weapon),
		        }
		        for _, fn in pairs(HitCore.consumers) do
		            pcall(fn, ev)
		        end
		    end)

		    -- the server sends MainEvent:FireClient("HitMarker", isHeadshot) when one of OUR shots really hit something.
		    -- health drops are only used to find out who / how much; an event is only produced when a hit marker arrives,
		    -- so shooting walls or other people taking damage from somewhere else no longer counts.
		    local recent = {}   -- [player] = { dmg, t, char, used }
		    local function OnDamage(player, char, delta)
		        if not HitCore.active then return end
		        local now = os.clock()
		        local r = recent[player]
		        if r and not r.used and now - r.t < 0.1 then
		            r.dmg = r.dmg + delta
		            r.t = now
		        else
		            recent[player] = { dmg = delta, t = now, char = char }
		        end
		    end

		    local function OnHitMarker(headshot)
		        local t0 = os.clock()
		        task.delay(0.12, function()      -- the health change can replicate a few frames after the marker
		            if not HitCore.active then return end
		            local best, bt = nil, -1
		            for pl, r in pairs(recent) do
		                if not r.used and r.t >= t0 - 0.5 and r.t <= t0 + 0.3 and r.t > bt then best, bt = pl, r.t end
		            end
		            if best then
		                local r = recent[best]
		                r.used = true
		                if r.char and r.char.Parent then Emit(best, r.char, r.dmg, headshot) end
		            end
		        end)
		    end

		    local function Watch(player)
		        if player == lp or watched[player] then return end
		        local rec = {}
		        watched[player] = rec
		        local function Hook(char)
		            if rec.hpConn then rec.hpConn:Disconnect(); rec.hpConn = nil end
		            local hum = char:WaitForChild('Humanoid', 10)
		            if not hum or not watched[player] then return end
		            local last = hum.Health
		            rec.hpConn = hum.HealthChanged:Connect(function(h)
		                local d = last - h
		                last = h
		                if d > 0.5 then OnDamage(player, char, d) end
		            end)
		        end
		        rec.charConn = player.CharacterAdded:Connect(Hook)
		        if player.Character then task.spawn(Hook, player.Character) end
		    end

		    local function Unwatch(player)
		        local rec = watched[player]
		        if not rec then return end
		        if rec.charConn then rec.charConn:Disconnect() end
		        if rec.hpConn then rec.hpConn:Disconnect() end
		        watched[player] = nil
		        recent[player] = nil
		    end

		    local addedConn, removingConn, markerConn
		    local function Refresh()
		        local any = next(HitCore.consumers) ~= nil
		        if any == HitCore.active then return end
		        HitCore.active = any
		        if any then
		            for _, p in ipairs(Players:GetPlayers()) do Watch(p) end
		            addedConn    = Players.PlayerAdded:Connect(Watch)
		            removingConn = Players.PlayerRemoving:Connect(Unwatch)
		            local ev = game:GetService('ReplicatedStorage'):FindFirstChild('MainEvent')
		            if ev then
		                markerConn = ev.OnClientEvent:Connect(function(a1, a2)
		                    if a1 == 'HitMarker' then OnHitMarker(a2 == true) end
		                end)
		            end
		        else
		            if addedConn then addedConn:Disconnect(); addedConn = nil end
		            if removingConn then removingConn:Disconnect(); removingConn = nil end
		            if markerConn then markerConn:Disconnect(); markerConn = nil end
		            for p in pairs(watched) do Unwatch(p) end
		        end
		    end

		    -- HitCore.Set('name', fn) turns a consumer on, HitCore.Set('name', nil) turns it off
		    function HitCore.Set(name, fn)
		        HitCore.consumers[name] = fn
		        Refresh()
		    end
		end


	})
	new("Frame", { Position = UDim2.fromOffset(9, 28), Size = UDim2.new(1, -18, 0, 1), BackgroundColor3 = theme.line, Parent = body })

	local gw, gh = width - 20 - 2, 52 - 2
	local _, graph = boxed({
		parent = body, pos = UDim2.fromOffset(10, 36), size = UDim2.fromOffset(width - 20, 52), radius = 6,
		top = theme.list_top, bot = theme.list_bot, border = theme.list_border,
	})
	graph.ClipsDescendants = true
	for i = 1, 3 do
		new("Frame", { Position = UDim2.fromOffset(0, math.floor(gh * i / 4)), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = theme.line, BackgroundTransparency = 0.5, Parent = graph })
	end

	local samples = 48
	local history = {}
	for i = 1, samples do history[i] = 0 end
	local segments = {}
	for i = 1, samples - 1 do
		segments[i] = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(2, 2), BackgroundColor3 = theme.acc_top, ZIndex = 2, Parent = graph })
	end
	local dot = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = theme.acc_top, ZIndex = 3, Parent = graph }, { corner(3) })

	local last_pos, last_time
	local current_speed; current_speed = LPH_NO_VIRTUALIZE(function()
		local char = lp.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then
			last_pos = nil
			return 0
		end
		local pos, now = root.Position, os.clock()
		local speed = 0
		if last_pos and now > last_time then
			local d = pos - last_pos
			speed = Vector3.new(d.X, 0, d.Z).Magnitude / (now - last_time)
		end
		last_pos, last_time = pos, now
		return speed
	end)

	local top = 20
	local smooth = 0
	local timer = 0
	owned(run.RenderStepped):Connect(LPH_NO_VIRTUALIZE(function(dt)
		if not outer.Visible then return end
		timer += dt
		if timer < 0.06 then return end
		timer = 0

		smooth += (current_speed() - smooth) * 0.5
		table.remove(history, 1)
		table.insert(history, smooth)
		value_text.Text = math.floor(smooth + 0.5) .. " sps"

		local peak = 0
		for _, v in ipairs(history) do peak = math.max(peak, v) end
		top += (math.max(20, peak * 1.2) - top) * 0.15

		local function point(i) return Vector2.new((i - 1) / (samples - 1) * gw, gh - 3 - clamp(history[i] / top, 0, 1) * (gh - 6)) end
		for i = 1, samples - 1 do
			local a, b = point(i), point(i + 1)
			local mid = (a + b) / 2
			segments[i].Position = UDim2.fromOffset(mid.X, mid.Y)
			segments[i].Size = UDim2.fromOffset((b - a).Magnitude + 1, 2)
			segments[i].Rotation = math.deg(math.atan2(b.Y - a.Y, b.X - a.X))
		end
		local last = point(samples)
		dot.Position = UDim2.fromOffset(last.X - 1, last.Y)
	end))

	outer.Visible = false
	speed_graph = outer
end


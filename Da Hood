		-- ============================================================
		-- WIREFRAME SYSTEM
		-- ============================================================
		do
		    local AssetService = game:GetService('AssetService')
		    local playerGui    = game:GetService('Players').LocalPlayer.PlayerGui

		    local WIRE_SKIP = { HumanoidRootPart = true }
		    local BLOCK_MESH_ID = "rbxassetid://139682108"
		    local SUBDIVISIONS  = 6

		    local _wmMeshCache = {}
		    local _wmFailCount = {}

		    local function _wmPosKey(v)
		        return math.floor(v.X*1000+0.5)..","..math.floor(v.Y*1000+0.5)..","..math.floor(v.Z*1000+0.5)
		    end

		    local function _wmExtractEdges(em)
		        local edgeMap, edgeList = {}, {}
		        local minX, minY, minZ =  math.huge,  math.huge,  math.huge
		        local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
		        local posCache = {}
		        local faces = em:GetFaces()
		        if type(faces) ~= "table" then return nil end
		        for _, faceId in ipairs(faces) do
		            if #edgeList > 30000 then break end
		            local verts = em:GetFaceVertices(faceId)
		            if type(verts) ~= "table" or #verts < 3 then continue end
		            local pts = {}
		            for i, vid in ipairs(verts) do
		                if not posCache[vid] then posCache[vid] = em:GetPosition(vid) end
		                pts[i] = posCache[vid]
		            end
		            local n = (pts[2]-pts[1]):Cross(pts[3]-pts[1])
		            if n.Magnitude < 1e-6 then continue end
		            local normal = n.Unit
		            for i = 1, #pts do
		                local a = pts[i]
		                local b = pts[i % #pts + 1]
		                minX=math.min(minX,a.X,b.X) minY=math.min(minY,a.Y,b.Y) minZ=math.min(minZ,a.Z,b.Z)
		                maxX=math.max(maxX,a.X,b.X) maxY=math.max(maxY,a.Y,b.Y) maxZ=math.max(maxZ,a.Z,b.Z)
		                local ka, kb = _wmPosKey(a), _wmPosKey(b)
		                local key = ka < kb and ka.."|"..kb or kb.."|"..ka
		                local ex  = edgeMap[key]
		                if not ex then
		                    local e = {A=a, B=b, Normal=normal, Dot=nil}
		                    edgeMap[key] = e
		                    edgeList[#edgeList+1] = e
		                else
		                    local d = ex.Normal:Dot(normal)
		                    if ex.Dot == nil or d < ex.Dot then ex.Dot = d end
		                end
		            end
		        end
		        if #edgeList == 0 then return nil end
		        local shared, nearFlat = 0, 0
		        for _, e in ipairs(edgeList) do
		            if e.Dot ~= nil then
		                shared += 1
		                if e.Dot >= 0.9063 and e.Dot < 0.9976 then nearFlat += 1 end
		            end
		        end
		        local allEdges = shared == 0 or (nearFlat/shared) >= 0.18
		        local lines = {}
		        for _, e in ipairs(edgeList) do
		            if #lines >= 15000 then break end
		            if allEdges or e.Dot == nil or e.Dot < 0.9063 then
		                lines[#lines+1] = {e.A, e.B}
		            end
		        end
		        if #lines == 0 then return nil end
		        return {
		            Lines  = lines,
		            Bounds = Vector3.new(maxX-minX, maxY-minY, maxZ-minZ),
		            Center = Vector3.new((minX+maxX)*0.5, (minY+maxY)*0.5, (minZ+maxZ)*0.5)
		        }
		    end

		    local function _wmBuildBoxWireframe(size)
		        local sx, sy, sz = size.X*0.5, size.Y*0.5, size.Z*0.5
		        local N = SUBDIVISIONS
		        local pts = {}
		        local function addLine(a,b) pts[#pts+1]=a; pts[#pts+1]=b end
		        local faces2 = {
		            {"Z", sz,"X","Y",sx,sy},{"Z",-sz,"X","Y",sx,sy},
		            {"X", sx,"Z","Y",sz,sy},{"X",-sx,"Z","Y",sz,sy},
		            {"Y", sy,"X","Z",sx,sz},{"Y",-sy,"X","Z",sx,sz},
		        }
		        for _, face in ipairs(faces2) do
		            local fixedAxis,fixedVal,uAxis,vAxis,uRange,vRange = table.unpack(face)
		            for i = 0, N do
		                local v = -vRange+(2*vRange*i/N)
		                local p1={[fixedAxis]=fixedVal,[uAxis]=-uRange,[vAxis]=v}
		                local p2={[fixedAxis]=fixedVal,[uAxis]= uRange,[vAxis]=v}
		                addLine(Vector3.new(p1.X or 0,p1.Y or 0,p1.Z or 0),Vector3.new(p2.X or 0,p2.Y or 0,p2.Z or 0))
		            end
		            for i = 0, N do
		                local u = -uRange+(2*uRange*i/N)
		                local p1={[fixedAxis]=fixedVal,[uAxis]=u,[vAxis]=-vRange}
		                local p2={[fixedAxis]=fixedVal,[uAxis]=u,[vAxis]= vRange}
		                addLine(Vector3.new(p1.X or 0,p1.Y or 0,p1.Z or 0),Vector3.new(p2.X or 0,p2.Y or 0,p2.Z or 0))
		            end
		            for i = 0, N-1 do
		                for j = 0, N-1 do
		                    local u0=-uRange+(2*uRange*i/N); local u1=-uRange+(2*uRange*(i+1)/N)
		                    local v0=-vRange+(2*vRange*j/N); local v1=-vRange+(2*vRange*(j+1)/N)
		                    local p1={[fixedAxis]=fixedVal,[uAxis]=u0,[vAxis]=v0}
		                    local p2={[fixedAxis]=fixedVal,[uAxis]=u1,[vAxis]=v1}
		                    addLine(Vector3.new(p1.X or 0,p1.Y or 0,p1.Z or 0),Vector3.new(p2.X or 0,p2.Y or 0,p2.Z or 0))
		                end
		            end
		        end
		        return pts
		    end

		    local function _wmGetMeshId(part)
		        if part:IsA("MeshPart") then
		            local id = part.MeshId
		            if id == "" then id = tostring(part.MeshContent) end
		            return id ~= "" and id or nil
		        end
		        local sm = part:FindFirstChildOfClass("SpecialMesh")
		        if sm and sm.MeshId ~= "" then return sm.MeshId end
		        return nil
		    end

		    local function _wmFetchMesh(part)
		        local meshId = _wmGetMeshId(part)
		        if not meshId then return false end
		        if _wmMeshCache[meshId] ~= nil then return _wmMeshCache[meshId] end
		        if (_wmFailCount[meshId] or 0) >= 3 then return false end
		        _wmMeshCache[meshId] = false
		        task.spawn(function()
		            local ok, em = pcall(function()
		                local id = typeof(meshId) == "Content" and meshId or Content.fromUri(meshId)
		                return AssetService:CreateEditableMeshAsync(id)
		            end)
		            if not ok or not em then
		                _wmFailCount[meshId] = (_wmFailCount[meshId] or 0) + 1
		                _wmMeshCache[meshId] = nil
		                return
		            end
		            local data = _wmExtractEdges(em)
		            em:Destroy()
		            _wmMeshCache[meshId] = data or false
		        end)
		        return nil
		    end

		    local function _wmMeshPoints(data, part)
		        local sm     = part:FindFirstChildOfClass("SpecialMesh")
		        local scale  = sm and sm.Scale  or nil
		        local offset = sm and sm.Offset or Vector3.zero
		        local b, c   = data.Bounds, data.Center
		        local sx = scale and scale.X or (math.abs(b.X)>0.0001 and part.Size.X/b.X or 1)
		        local sy = scale and scale.Y or (math.abs(b.Y)>0.0001 and part.Size.Y/b.Y or 1)
		        local sz = scale and scale.Z or (math.abs(b.Z)>0.0001 and part.Size.Z/b.Z or 1)
		        local pts = table.create(#data.Lines*2)
		        for _, ln in ipairs(data.Lines) do
		            local a = ln[1]-c; local bb = ln[2]-c
		            pts[#pts+1] = Vector3.new(a.X*sx, a.Y*sy, a.Z*sz) + offset
		            pts[#pts+1] = Vector3.new(bb.X*sx, bb.Y*sy, bb.Z*sz) + offset
		        end
		        return pts
		    end

		    local function _wmEnsureMesh(part)
		        if part:IsA("MeshPart") then return end
		        if part:FindFirstChildOfClass("SpecialMesh") then return end
		        if part:IsA("UnionOperation") then return end
		        -- only add a fallback mesh for plain rectangular Parts
		        if not part:IsA("Part") then return end
		        local sm = Instance.new("SpecialMesh")
		        sm.MeshType  = Enum.MeshType.FileMesh
		        sm.MeshId    = BLOCK_MESH_ID
		        sm.Scale     = Vector3.new(part.Size.X/2, part.Size.Y/2, part.Size.Z/2)
		        sm.TextureId = ""
		        sm.Parent    = part
		    end

		    -- ── SELF WIREFRAME ──────────────────────────────────────
		    _RG._SelfWireEnabled = false
		    _RG._SelfWireColor   = Color3.fromRGB(255, 255, 255)
		    _RG._SelfWireAdorns  = {}
		    _RG._SelfWireHBConn  = nil

		    local function _SelfWireRemovePart(part)
		        local e = _RG._SelfWireAdorns[part]
		        if not e then return end
		        pcall(function() e.adorn:Destroy() end)
		        _RG._SelfWireAdorns[part] = nil
		    end

		    local SELF_WIRE_BODY = {
		        ["Head"]=true,["Torso"]=true,["UpperTorso"]=true,["LowerTorso"]=true,
		        ["Left Arm"]=true,["Right Arm"]=true,["Left Leg"]=true,["Right Leg"]=true,
		        ["LeftUpperArm"]=true,["RightUpperArm"]=true,
		        ["LeftLowerArm"]=true,["RightLowerArm"]=true,
		        ["LeftHand"]=true,["RightHand"]=true,
		        ["LeftUpperLeg"]=true,["RightUpperLeg"]=true,
		        ["LeftLowerLeg"]=true,["RightLowerLeg"]=true,
		        ["LeftFoot"]=true,["RightFoot"]=true,
		    }

		    local function _SelfWireAddPart(part)
		        if _RG._SelfWireAdorns[part] then return end
		        if WIRE_SKIP[part.Name] then return end
		        if not part:IsA("BasePart") then return end
		        if not SELF_WIRE_BODY[part.Name] then return end  -- skip accessories/tools
		        _wmEnsureMesh(part)
		        pcall(function()
		            part.Transparency = 1
		            part.CastShadow   = false
		        end)
		        local adorn = Instance.new("WireframeHandleAdornment")
		        adorn.Name        = "__SelfCW"
		        adorn.ZIndex      = 10
		        adorn.Thickness   = 1
		        adorn.AlwaysOnTop = true
		        adorn.Color3      = _RG._SelfWireColor
		        adorn.Transparency= 0
		        adorn.Adornee     = part
		        adorn.Parent      = playerGui
		        _RG._SelfWireAdorns[part] = {
		            adorn=adorn, lastData=nil, lastSize=nil, lastScale=nil, lastOffset=nil
		        }
		        part.Destroying:Connect(function() _SelfWireRemovePart(part) end)
		    end

		    local function _SelfWireUpdatePart(part, e)
		        local adorn = e.adorn
		        if adorn.Color3 ~= _RG._SelfWireColor then adorn.Color3 = _RG._SelfWireColor end
		        local data = _wmFetchMesh(part)
		        if data == nil or data == false then
		            if part.Size ~= e.lastSize then
		                adorn:Clear()
		                adorn:AddLines(_wmBuildBoxWireframe(part.Size))
		                e.lastSize = part.Size
		            end
		            return
		        end
		        local sm     = part:FindFirstChildOfClass("SpecialMesh")
		        local scale  = sm and sm.Scale  or nil
		        local offset = sm and sm.Offset or nil
		        if data ~= e.lastData or part.Size ~= e.lastSize or scale ~= e.lastScale or offset ~= e.lastOffset then
		            adorn:Clear()
		            adorn:AddLines(_wmMeshPoints(data, part))
		            e.lastData=data; e.lastSize=part.Size; e.lastScale=scale; e.lastOffset=offset
		        end
		    end

		    local function _SelfWireApply(char)
		        for part in pairs(_RG._SelfWireAdorns) do _SelfWireRemovePart(part) end
		        _RG._SelfWireAdorns = {}
		        if _RG._SelfWireHBConn then _RG._SelfWireHBConn:Disconnect(); _RG._SelfWireHBConn = nil end

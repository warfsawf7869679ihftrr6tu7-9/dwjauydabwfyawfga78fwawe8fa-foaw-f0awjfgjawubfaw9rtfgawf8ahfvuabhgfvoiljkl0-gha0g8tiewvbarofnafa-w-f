		            end
		        end)
		    end
		    if _lpChar2 then _HookCharForToolWire(_lpChar2) end
		    game:GetService('Players').LocalPlayer.CharacterAdded:Connect(function(char)
		        _HookCharForToolWire(char)
		    end)

		    -- UI
		    local ToolWireToggle = _RG.visuals_self:AddToggle('tool_wireframe', {
		        Text    = 'tool wireframe',
		        Default = false,
		    })
		    ToolWireToggle:AddColorPicker('tool_wire_color', {

		        Entry = function(name)
		            if not live[name] then Scan() end
		            return live[name]
		        end,
		        Has = Has,
		        Money = Money,
		        IsBusy = function() return B.Busy end,
		        SetBusy = function(v) B.Busy = v end,
		    }

		    if not found then
		        library:Notify('auto buy: shop not found yet, the item list will fill in once the map has loaded', 4)
		    end
		end


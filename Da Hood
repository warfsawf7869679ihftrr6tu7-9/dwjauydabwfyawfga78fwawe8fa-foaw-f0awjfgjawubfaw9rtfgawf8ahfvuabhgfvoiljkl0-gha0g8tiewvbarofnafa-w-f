	        Obj.Tri1.Visible = true;

	        local _ESPPlayers2 = get_genv().ESP and get_genv().ESP.Settings and get_genv().ESP.Settings.Players;
	        local _FontName2   = (_ESPPlayers2 and _ESPPlayers2.Font) or "Tahoma";
	        local _FontSize2   = (_ESPPlayers2 and _ESPPlayers2.FontSize) or 13;

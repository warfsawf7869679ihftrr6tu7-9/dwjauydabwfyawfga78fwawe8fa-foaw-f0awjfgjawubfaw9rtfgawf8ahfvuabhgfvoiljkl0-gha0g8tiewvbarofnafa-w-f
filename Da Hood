		local radius = siren and siren:FindFirstChild("Radius")
		if not radius then
			task.delay(5, function() if TR.on and not radiusConn then watchDefault() end end)
			return
		end
		radiusConn = radius.ChildAdded:Connect(function(c)
			if not TR.on then return end
			local mine = c.Name == "BULLET_RAYS" and c:GetAttribute("OwnerCharacter") == lp.Name
			if not mine and c.Name ~= "BULLET_RAYS" and c:IsA("BasePart") then
				-- skin trails have no owner tag, but they start at the muzzle, so anything appearing right by us is ours
				local r = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
				mine = r ~= nil and (c.Position - r.Position).Magnitude < 12
			end
			if not mine then return end
			hideFx(c)

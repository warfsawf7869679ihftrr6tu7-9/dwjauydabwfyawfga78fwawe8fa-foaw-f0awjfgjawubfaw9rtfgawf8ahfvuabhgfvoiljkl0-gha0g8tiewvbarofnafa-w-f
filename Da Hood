		    local AS = { Enabled = false, Method = 'reset' }
		    _RG._AntiStomp = AS
		    local wasKnocked, flingUntil, flingDir = false, 0, Vector3.zero
		    local knockedSince, lastChar, graceUntil = nil, nil, 0
		    local lastFlingT = os.clock()

		    RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
		        if not AS.Enabled then wasKnocked = false; knockedSince = nil; flingUntil = 0; return end
		        local char = lp.Character
		        if not char then wasKnocked = false; knockedSince = nil; flingUntil = 0; return end
		        local now = os.clock()
		        -- ignore the first seconds of a new life, the knocked value isn't reliable while the character loads in
		        if char ~= lastChar then
		            lastChar = char
		            graceUntil = now + 3
		            wasKnocked, knockedSince, flingUntil = false, nil, 0
		        end
		        local be = char:FindFirstChild('BodyEffects')
		        local ko = be and be:FindFirstChild('K.O')
		        local hum  = char:FindFirstChildOfClass('Humanoid')
		        local root = char:FindFirstChild('HumanoidRootPart')
		        local knocked = now > graceUntil and ko ~= nil and ko.Value == true
		        -- must stay knocked for a moment before anything happens, and stops the instant we get back up
		        if knocked then
		            knockedSince = knockedSince or now
		            if now - knockedSince < 0.1 then knocked = false end
		        else
		            knockedSince = nil
		            flingUntil = 0
		        end

		        if knocked and not wasKnocked then
		            wasKnocked = true
		            if AS.Method == 'reset' then
		                if hum then pcall(function() hum.Health = 0 end) end
		                pcall(function() char:BreakJoints() end)
		            else
		                local a = math.random() * math.pi * 2
		                flingDir = Vector3.new(math.cos(a), 0, math.sin(a))
		                flingUntil = os.clock() + 0.4
		            end
		        elseif not knocked then
		            wasKnocked = false
		        end

		        -- fling: while knocked, carry ourselves far away from whoever is about to stomp us. this moves the root
		        -- by cframe for the duration (about 700 studs); the old version wrote velocity, which got stored while the
		        -- game had us ragdolled and then threw us into the void the moment we stood up.
		        if AS.Method == 'fling' and knocked and root and os.clock() < flingUntil then
		            local step = math.min(os.clock() - lastFlingT, 0.1)
		            root.CFrame = root.CFrame + flingDir * (1400 * step) + Vector3.new(0, 90 * step, 0)
		        end
		        lastFlingT = os.clock()
		    end))

		    local as = _RG.tabs.misc:AddRightGroupbox('anti stomp')
		    as:AddToggle('misc_anti_stomp', { Text = 'anti stomp', Default = false })
		    library.Toggles.misc_anti_stomp:OnChanged(function(V) AS.Enabled = V end)
		    as:AddDropdown('misc_anti_stomp_method', {
		        Text = 'anti stomp method', Values = { 'fling', 'reset' }, Default = 'reset',
		    })
		    library.Options.misc_anti_stomp_method:OnChanged(function(V) AS.Method = V end)
		end


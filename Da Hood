-- Search: finds any row (and section title, including rows inside the >> menus), opens it and lights it up for a second
do
	local bar, bar_fill = boxed({
		parent = inner, pos = UDim2.fromOffset(170 - ox, 23 - oy), size = UDim2.new(1, -(170 - ox) - 9, 0, 28), radius = 7,
	})
	bar.ZIndex = 5
	local mag = icon(bar_fill, "search", 14, theme.icon_dim, UDim2.fromOffset(9, 6))
	local box = new("TextBox", {
		Position = UDim2.fromOffset(31, 0), Size = UDim2.new(1, -60, 1, 0), BackgroundTransparency = 1, Text = "", PlaceholderText = "Search features...",
		PlaceholderColor3 = theme.text_off, TextColor3 = theme.text_on, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, Parent = bar_fill,
	})
	local clear = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -7, 0.5, 0), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Visible = false, Parent = bar_fill,
	})
	local clear_icon = icon(clear, "x", 12, theme.icon_dim, UDim2.fromOffset(3, 3))
	clear.MouseEnter:Connect(LPH_NO_VIRTUALIZE(function() set_icon(clear_icon, theme.text_bright, 0.1) end))
	clear.MouseLeave:Connect(LPH_NO_VIRTUALIZE(function() set_icon(clear_icon, theme.icon_dim, 0.1) end))

	local list_box, list_fill = boxed({
		parent = inner, pos = UDim2.fromOffset(170 - ox, 23 - oy + 31), size = UDim2.new(1, -(170 - ox) - 9, 0, 40), radius = 8,
		top = theme.popup_top, bot = theme.popup_bot, border = theme.popup_border,
	})
	list_box.ZIndex = 70
	list_box.Visible = false
	list_box.Active = true
	local rows_holder = new("Frame", { Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8), BackgroundTransparency = 1, Parent = list_fill }, {
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local empty = new("TextLabel", {
		Size = UDim2.fromScale(1, 1), Text = "Nothing found", TextColor3 = theme.text_off, Visible = false, Parent = list_fill,
	})

	local found, picked = {}, 1
	local row_buttons = {}

	local hide_list; hide_list = LPH_NO_VIRTUALIZE(function()
		list_box.Visible = false
	end)

	local path_of; path_of = LPH_NO_VIRTUALIZE(function(entry)
		local parts, s = {}, entry.sec
		while s and not s.page do
			if not s.host then return nil end
			table.insert(parts, 1, s.host.name)
			s = s.host.sec
		end
		if not s or not s.page then return nil end
		local page = s.page
		local out = {}
		if page.owner and page.owner.name then out[#out + 1] = page.owner.name end
		if page.name then out[#out + 1] = page.name end
		if s.title and s.title ~= entry.name then out[#out + 1] = s.title end
		for _, p in ipairs(parts) do out[#out + 1] = p end
		return table.concat(out, "  >  ")
	end)

	local flash; flash = LPH_NO_VIRTUALIZE(function(entry)
		local row = entry.row
		if not (row and row.Parent) then return end
		local target, mark
		for _, d in ipairs(row:GetDescendants()) do
			if not target and d:IsA("TextLabel") and d.Text == entry.name then target = d end
			if not mark and d:GetAttribute("mark") then mark = d:FindFirstChildWhichIsA("Frame") end
		end
		local was = target and target.TextColor3
		if target then tween(target, { TextColor3 = theme.text_on }, 0.12) end
		if mark then set_icon(mark, theme.text_on, 0.12) end
		task.delay(1, function()
			if target and target.Parent and was then tween(target, { TextColor3 = was }, 0.3) end
			if mark and mark.Parent then set_icon(mark, theme.text, 0.3) end
		end)
	end)

	local go; go = LPH_NO_VIRTUALIZE(function(entry)
		hide_list()
		close_popup()
		close_panel()
		local chain, s = {}, entry.sec
		while s and not s.page do
			if not s.host then return end
			table.insert(chain, 1, s)
			s = s.host.sec
		end
		if not s then return end
		local root = s
		local first_row = chain[1] and chain[1].host.row or entry.row
		task.spawn(function()
			local page = root.page
			if page.select and current_page ~= page then
				page.select()
				task.wait(0.22)
			else
				task.wait()
			end
			if root.folded and root.fold_toggle then
				root.fold_toggle()
				task.wait(0.1)
			end
			if root.select_tab then
				root.select_tab()
				task.wait(0.05)
			end
			local column = root.column
			if column and first_row and first_row.Parent then
				local y = first_row.AbsolutePosition.Y - column.AbsolutePosition.Y + column.CanvasPosition.Y
				local limit = math.max(0, column.AbsoluteCanvasSize.Y - column.AbsoluteSize.Y)
				tween(column, { CanvasPosition = Vector2.new(0, clamp(y - 50, 0, limit)) }, 0.25)
				task.wait(0.3)
			end
			for _, panel in ipairs(chain) do
				if panel.host.show then panel.host.show() end
				task.wait(0.1)
			end
			flash(entry)
		end)
	end)

	local paint_rows; paint_rows = LPH_NO_VIRTUALIZE(function()
		for i, b in ipairs(row_buttons) do
			tween(b, { BackgroundTransparency = i == picked and 0.82 or 1 }, 0.08)
		end
	end)

	local refresh; refresh = LPH_NO_VIRTUALIZE(function()
		for _, b in ipairs(row_buttons) do b:Destroy() end
		table.clear(row_buttons)
		table.clear(found)
		picked = 1
		local query = box.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
		clear.Visible = box.Text ~= ""
		if query == "" then
			hide_list()
			return
		end
		local words = {}
		for w in query:gmatch("%S+") do words[#words + 1] = w end
		local scored = {}
		for _, entry in ipairs(library.search_index) do
			if entry.row.Parent and entry.row.Visible then
				local path = path_of(entry)
				if path then
					local name = entry.name:lower()
					local hay = name .. " " .. path:lower()
					local all, in_name = true, true
					for _, w in ipairs(words) do
						if not hay:find(w, 1, true) then all = false break end
						if not name:find(w, 1, true) then in_name = false end
					end
					if all then
						local first = name:find(words[1], 1, true)
						local score = (in_name and 0 or 1000) + (first == 1 and 0 or 30) + (first or 40) + #name * 0.05
						scored[#scored + 1] = { entry = entry, path = path, score = score }
					end
				end
			end
		end
		table.sort(scored, function(a, b) return a.score < b.score end)
		for i = 1, math.min(#scored, 8) do found[i] = scored[i] end
		local shown = #found
		empty.Visible = shown == 0
		rows_holder.Visible = shown > 0
		list_box.Size = UDim2.new(1, -(170 - ox) - 9, 0, math.max(shown, 1) * 38 + (shown > 1 and (shown - 1) * 2 or 0) + 8 + (shown == 0 and 8 or 0))
		for i, item in ipairs(found) do
			local b = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = gray(255), BackgroundTransparency = 1, LayoutOrder = i, Parent = rows_holder,
			}, { corner(6) })
			new("TextLabel", {
				Position = UDim2.fromOffset(10, 3), Size = UDim2.new(1, -20, 0, 18), Text = item.entry.name, FontFace = font(true), TextColor3 = theme.text_bright,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
			})
			new("TextLabel", {
				Position = UDim2.fromOffset(10, 20), Size = UDim2.new(1, -20, 0, 14), Text = item.path, TextSize = 11, TextColor3 = theme.text_off,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
			})
			b.MouseEnter:Connect(function()
				picked = i
				paint_rows()
			end)
			b.MouseButton1Click:Connect(function()
				box.Text = ""
				go(item.entry)
			end)
			row_buttons[i] = b
		end
		list_box.Visible = true
		paint_rows()
	end)

	box:GetPropertyChangedSignal("Text"):Connect(refresh)
	box.Focused:Connect(LPH_NO_VIRTUALIZE(function()
		tween(bar, { BackgroundColor3 = theme.acc_bot }, 0.12)
		set_icon(mag, theme.acc_top, 0.12)
		if box.Text ~= "" then refresh() end
	end))
	box.FocusLost:Connect(LPH_NO_VIRTUALIZE(function(enter)
		tween(bar, { BackgroundColor3 = theme.ctrl_border }, 0.12)
		set_icon(mag, theme.icon_dim, 0.12)
		if enter and found[picked] then
			local entry = found[picked].entry
			box.Text = ""
			go(entry)
		end
	end))
	clear.MouseButton1Click:Connect(LPH_NO_VIRTUALIZE(function()
		box.Text = ""
		box:CaptureFocus()
	end))
	owned(uis.InputBegan):Connect(LPH_NO_VIRTUALIZE(function(input)
		if not list_box.Visible then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local m = mouse()
			if not (inside(list_box, m) or inside(bar, m)) then hide_list() end
		elseif box:IsFocused() then
			if input.KeyCode == Enum.KeyCode.Down then
				picked = math.min(picked + 1, #found)
				paint_rows()
			elseif input.KeyCode == Enum.KeyCode.Up then
				picked = math.max(picked - 1, 1)
				paint_rows()
			elseif input.KeyCode == Enum.KeyCode.Escape then
				box.Text = ""
				box:ReleaseFocus()
			end
		end
	end))
	table.insert(repaints, LPH_NO_VIRTUALIZE(function()
		set_icon(mag, box:IsFocused() and theme.acc_top or theme.icon_dim)
	end))
end

local track_position; track_position = LPH_NO_VIRTUALIZE(function(frame, flag)
	local pack; pack = function(p) return { p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset } end
	register(flag, pack(frame.Position), function(v)
		if type(v) == "table" and #v == 4 then
			frame.Position = UDim2.new(v[1], v[2], v[3], v[4])
			library.flags[flag] = v
		end
	end)
	return function(started)
		if not started then library.flags[flag] = pack(frame.Position) end
	end
end)


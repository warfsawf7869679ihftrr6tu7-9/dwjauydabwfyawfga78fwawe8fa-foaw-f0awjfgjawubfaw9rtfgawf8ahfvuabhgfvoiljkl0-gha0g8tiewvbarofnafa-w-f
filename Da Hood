		    _RG._DesyncActive = false
		    _RG._DesyncServerPos = nil

		    local savedRate
		    local dsfs, busy, lastChar = 0, false, nil

		    local function Restore()
		        local char = lp.Character
		        local hrp = char and char:FindFirstChild('HumanoidRootPart')
		        if hrp then pcall(sethiddenproperty, hrp, 'PhysicsRepRootPart', hrp) end
		        if savedRate ~= nil then pcall(setfflag, 'S2PhysicsSenderRate', savedRate); savedRate = nil end
		        _RG._DesyncServerPos = nil
		        busy, dsfs, lastChar = false, 0, nil
		    end

		    RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
		        if not DS.Enabled then return end
		        local char = lp.Character
		        local hrp = char and char:FindFirstChild('HumanoidRootPart')
		        if not hrp then return end
		        if char ~= lastChar then
		            lastChar = char
		            dsfs, busy = 0, false
		            _RG._DesyncServerPos = hrp.Position
		        end
		        if busy then return end

		        -- just fired: stay fully synced for a moment. shooting while the server has a stale position for you is
		        -- what produced the invalid shots
		        if os.clock() < (_RG._DesyncPauseUntil or 0) then
		            pcall(sethiddenproperty, hrp, 'PhysicsRepRootPart', hrp)
		            _RG._DesyncServerPos = hrp.Position
		            return
		        end

		        if dsfs <= 0 then
		            -- let go of the rep root for a moment, then latch back on; the server keeps the position from the latch
		            busy = true
		            pcall(sethiddenproperty, hrp, 'PhysicsRepRootPart', nil)
		            task.delay(0.1, function()
		                if hrp.Parent then
		                    pcall(sethiddenproperty, hrp, 'PhysicsRepRootPart', hrp)
		                    _RG._DesyncServerPos = hrp.Position
		                end
		                busy = false
		                dsfs = 20
		            end)
		        else
		            dsfs = dsfs - 1
		            pcall(sethiddenproperty, hrp, 'PhysicsRepRootPart', hrp)
		        end
		    end))

		    local function Armed(toggle, key)
		        local kv = key.Value
		        local hasKey = kv ~= nil and kv ~= '...' and kv ~= 'None'
		        if hasKey then return toggle.Value and key:GetState() end
		        return toggle.Value
		    end

		    local UpdateDesync
		    local ds = _RG.tabs.misc:AddLeftGroupbox('desync')
		    _RG._DesyncBox = ds
		    local DSToggle = ds:AddToggle('misc_rep_desync', { Text = 'rep desync', Default = false })
		    DSToggle:AddKeyPicker('misc_rep_desync_key', {
		        Default = 'None', SyncToggleState = false, Mode = 'Toggle', Text = 'rep desync', NoUI = false,
		        Callback = function() UpdateDesync() end,
		    })
		    UpdateDesync = function()
		        local on = Armed(library.Toggles.misc_rep_desync, library.Options.misc_rep_desync_key) and true or false
		        if on == DS.Enabled then return end
		        DS.Enabled = on
		        _RG._DesyncActive = on
		        if on then
		            if savedRate == nil then
		                local ok, v = pcall(getfflag, 'S2PhysicsSenderRate')
		                savedRate = (ok and v ~= nil and v ~= '') and v or 15
		            end
		            pcall(setfflag, 'S2PhysicsSenderRate', 1000)
		        else
		            Restore()
		        end
		    end
		    DSToggle:OnChanged(UpdateDesync)
		end


	local outer, body = hud_card(UDim2.new(0.5, 0, 1, -110), Vector2.new(0.5, 1), UDim2.fromOffset(width, height), "pos_target")
	local BOX = 66
	local mid_x, mid_r = 12 + BOX + 18, width - 12 - BOX - 18
	local mid_w = mid_r - mid_x
	local ARMOR_MAX = 130

	-- the game's own weapon icons (ReplicatedStorage.SkinModules.Icon), read once
	local ICONS
	local icon_for = LPH_NO_VIRTUALIZE(function(tool)
		if ICONS == nil then
			ICONS = false
			pcall(function()
				local m = game:GetService("ReplicatedStorage"):FindFirstChild("SkinModules")
				m = m and m:FindFirstChild("Icon")
				if m then ICONS = require(m) end
			end)
		end
		local id = type(ICONS) == "table" and ICONS[tool.Name] or nil
		if id then return id end
		local tex = tool.TextureId
		return (tex ~= nil and tex ~= "") and tex or nil
	end)

	local slots = {}
	local weapon_box; weapon_box = LPH_NO_VIRTUALIZE(function(x, y)
		local border, inner = boxed({
			parent = body, pos = UDim2.fromOffset(x, y), size = UDim2.fromOffset(BOX, BOX), radius = 8,
			top = theme.val_top, bot = theme.val_bot, border = theme.val_border,
		})
		inner.ClipsDescendants = true
		local img = new("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.92, 0.92),
			BackgroundTransparency = 1, Image = "", ScaleType = Enum.ScaleType.Fit, ZIndex = 3, Parent = inner,
		})
		local none = icon(inner, "ban", 24, theme.icon_dim, UDim2.new(0.5, -12, 0.5, -12))
		return { border = border, img = img, none = none, name = nil }
	end)
	slots[1] = weapon_box(12, 14)
	slots[2] = weapon_box(12, 90)
	slots[3] = weapon_box(width - 12 - BOX, 14)
	slots[4] = weapon_box(width - 12 - BOX, 90)

	local name_text = new("TextLabel", {
		Position = UDim2.fromOffset(mid_x, 16), Size = UDim2.fromOffset(mid_w, 20), Text = "None", TextSize = 15, FontFace = font(true),
		TextColor3 = theme.text_bright, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = body,
	})
	local stats_text = new("TextLabel", {
		Position = UDim2.fromOffset(mid_x, 38), Size = UDim2.fromOffset(mid_w, 14), Text = "", TextSize = 11, RichText = true,
		TextColor3 = theme.text_off, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = body,
	})

	local bar; bar = LPH_NO_VIRTUALIZE(function(y, label)
		new("TextLabel", {
			Position = UDim2.fromOffset(mid_x, y), Size = UDim2.fromOffset(100, 14), Text = label, TextSize = 11,
			TextColor3 = theme.text_off, TextXAlignment = Enum.TextXAlignment.Left, Parent = body,
		})
		local value = new("TextLabel", {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromOffset(mid_r, y), Size = UDim2.fromOffset(150, 14), Text = "-", TextSize = 11,
			FontFace = font(true), RichText = true, TextColor3 = theme.text_bright, TextXAlignment = Enum.TextXAlignment.Right, Parent = body,
		})

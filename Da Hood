		})
		view.Ambient = Color3.fromRGB(190, 190, 190)
		view.LightColor = Color3.fromRGB(255, 255, 255)
		view.LightDirection = Vector3.new(0.3, -0.5, -1)
		camera = Instance.new("Camera")
		camera.FieldOfView = 50
		camera.CFrame = CFrame.new()
		camera.Parent = view
		view.CurrentCamera = camera

		model = Instance.new("Model")
		model.Name = "logo"
		model.Parent = view

		local piece; piece = function(shape)
			local p = Instance.new("Part")
			p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
			p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			if shape then p.Shape = shape end
			p.Parent = model
			return p
		end

		local radius, bite_radius = 0.5, 0.4
		local bite = Vector2.new(0.2, 0.2)

		local smooth = pcall(function()
			local upright = CFrame.Angles(0, math.rad(90), 0)
			local disc = piece(Enum.PartType.Cylinder)
			disc.Size, disc.CFrame = Vector3.new(0.16, radius * 2, radius * 2), upright
			local cutter = piece(Enum.PartType.Cylinder)
			cutter.Size, cutter.CFrame = Vector3.new(0.6, bite_radius * 2, bite_radius * 2), CFrame.new(bite.X, bite.Y, 0) * upright

			local crescent = game:GetService("GeometryService"):SubtractAsync(disc, { cutter })[1]
			disc:Destroy()
			cutter:Destroy()
			crescent.Anchored, crescent.CanCollide, crescent.CanTouch, crescent.CanQuery, crescent.CastShadow = true, false, false, false, false
			crescent.UsePartColor = true
			crescent.Parent = model
			table.insert(pieces, { part = crescent, size = crescent.Size, offset = crescent.CFrame })
		end)


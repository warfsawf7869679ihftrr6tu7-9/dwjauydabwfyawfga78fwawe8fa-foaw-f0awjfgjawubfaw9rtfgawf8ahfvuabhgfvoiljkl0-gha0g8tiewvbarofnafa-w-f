		    _RG._Movement = MV

		    local flyForce, flyOwnerRoot, flyStunned = nil, nil, false
		    local flyPos = nil
		    local noclipParts, noclipConn, noclipChar = {}, nil, nil

		    local GetParts = LPH_NO_VIRTUALIZE(function()
		        local char = lp.Character
		        if not char then return nil end
		        local hum  = char:FindFirstChildOfClass('Humanoid')
		        local root = char:FindFirstChild('HumanoidRootPart')
		        if not hum or not root or hum.Health <= 0 then return nil end
		        return char, hum, root
		    end)

		    -- ---------- fly: flies where the camera looks (cframe stepping, nothing is written to velocity) ----------
		    local FlyStop = LPH_NO_VIRTUALIZE(function(hum)
		        if flyForce then pcall(function() flyForce:Destroy() end); flyForce = nil end
		        flyOwnerRoot = nil
		        flyPos = nil
		        if flyStunned then
		            flyStunned = false
		            if hum then pcall(function() hum.PlatformStand = false end) end
		        end
		    end)

		    local FlyStep = LPH_NO_VIRTUALIZE(function(hum, root, dt)
		        if not flyStunned then
		            flyStunned = true
		            hum.PlatformStand = true
		        end
		        -- cancel gravity with a force (not a velocity) so you hover instead of building up fall speed
		        if not flyForce or flyForce.Parent ~= root or flyOwnerRoot ~= root then
		            if flyForce then pcall(function() flyForce:Destroy() end) end
		            local att = root:FindFirstChild('RootAttachment') or root:FindFirstChildWhichIsA('Attachment')
		            if not att then return end
		            flyForce = Instance.new('VectorForce')
		            flyForce.Name = 'RootForce'
		            flyForce.Attachment0 = att
		            flyForce.ApplyAtCenterOfMass = true
		            flyForce.RelativeTo = Enum.ActuatorRelativeTo.World
		            flyForce.Force = Vector3.zero
		            flyForce.Parent = root
		            flyOwnerRoot = root
		        end
		        flyForce.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)

		        local cam = workspace.CurrentCamera
		        if not cam then return end
		        local cf = cam.CFrame
		        local look, right = cf.LookVector, cf.RightVector

		        local dir = Vector3.zero
		        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + look end
		        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - look end
		        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
		        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
		        if dir.Magnitude < 0.01 then dir = hum.MoveDirection end   -- touch / gamepad

		        -- keep our own position: whatever physics did to the root since last frame (leftover momentum, bumps)
		        -- is discarded, so standing still really stays still. only resync if something else moved us far away.
		        local pos = flyPos
		        if not pos or (root.Position - pos).Magnitude > 30 then pos = root.Position end
		        if dir.Magnitude > 0.01 then

	local preview_frames = {}       -- [weapon] = { center, look, dist }: worked out once from the plain gun, shared by all its skins
	local frame_for = LPH_NO_VIRTUALIZE(function(weapon, root)
		local f = preview_frames[weapon]
		if f then return f end
		local cf, size = root.CFrame, root.Size
		-- world size of the plain gun: look at it from its thinnest side so the whole gun is seen flat, side on
		local ext = (cf.XVector * size.X):Abs() + (cf.YVector * size.Y):Abs() + (cf.ZVector * size.Z):Abs()
		local look = ext.X < ext.Z and Vector3.xAxis or Vector3.zAxis
		local wide = look == Vector3.xAxis and ext.Z or ext.X
		f = { center = cf.Position, look = look, wide = wide, tall = ext.Y, depth = math.min(ext.X, ext.Z), fov = 20 }
		preview_frames[weapon] = f
		return f
	end)
	local preview = LPH_NO_VIRTUALIZE(function(parent, weapon, skin)
		local data = skin and SKINS[weapon] and SKINS[weapon][skin]
		local base_src = weapon == "[Knife]" and KNIVES and KNIVES:FindFirstChild("Default") or (GUNMODELS and GUNMODELS:FindFirstChild(weapon))
		if not base_src then return false end
		local ok = pcall(function()
			local model = Instance.new("Model")
			local base = base_src:Clone()
			base.Parent = model
			local root = base:IsA("Model") and base.PrimaryPart or base
			local frame = frame_for(weapon, root)
			if type(data) == "table" then
				local src = (weapon == "[Knife]" and KNIVES and KNIVES:FindFirstChild(skin)) or (typeof(data.TextureID) == "Instance" and data.TextureID) or nil
				local offset = typeof(data.CFrame) == "CFrame" and data.CFrame or CFrame.identity
				if src then
					-- the gun stays where it is and the skin mesh goes on it at its offset, exactly like on the real tool,
					-- so every skin of this weapon sits in the same spot in its tile
					local m = src:Clone()
					local target = root.CFrame * offset
					for _, d in ipairs(m:GetDescendants()) do
						if d:IsA("BasePart") then d.CFrame = target * m.CFrame:ToObjectSpace(d.CFrame) end
					end
					m.CFrame = target
					root.Transparency = 1
					m.Parent = model
				elseif type(data.TextureID) == "string" and root:IsA("MeshPart") then
					root.TextureID = data.TextureID
				end
			end
			-- zoomed so the gun fills its picture (same tile size as before, just a bigger gun in it): its length fits the
			-- width and its height fits the height, whichever is tighter, with a small margin. a narrow lens keeps it flat
			-- anti-aliasing by hand: Roblox draws viewports with no edge smoothing, so the gun is drawn 4 times with the camera
			-- nudged by a quarter pixel in a rotated grid, and the layers are stacked at 1, 1/2, 1/3, 1/4 opacity so the result
			-- is their average. edges that were hard stair steps come out smooth (the same idea as real 4x supersampling)
			local tv = math.tan(math.rad(frame.fov / 2))
			local JITTER = { Vector2.new(0.125, 0.375), Vector2.new(-0.375, 0.125), Vector2.new(0.375, -0.125), Vector2.new(-0.125, -0.375) }
			local cams = {}
			for i = 1, #JITTER do
				local vp = Instance.new("ViewportFrame")
				vp.BackgroundTransparency, vp.BorderSizePixel, vp.Size, vp.ZIndex = 1, 0, UDim2.fromScale(1, 1), 3
				vp.Ambient, vp.LightColor, vp.LightDirection = Color3.fromRGB(210, 210, 210), Color3.new(1, 1, 1), Vector3.new(-0.3, -1, -0.5)
				vp.ImageTransparency = 1 - 1 / i
				local m = i == 1 and model or model:Clone()
				m.Parent = vp
				local cam = Instance.new("Camera")
				cam.FieldOfView = frame.fov
				cam.Parent = vp
				vp.CurrentCamera = cam
				vp.Parent = parent
				cams[i] = cam
			end
			-- zoomed so the gun fills its picture: its length fits the width and its height fits the height, whichever is
			-- tighter, with a small margin. worked out again whenever the picture changes size (making the menu smaller or
			-- bigger), so the gun always shrinks and grows with the tile instead of staying one size
			local place = function()
				local px = parent.AbsoluteSize
				if px.X <= 0 or px.Y <= 0 then px = Vector2.new(120, 66) end
				local aspect = px.X / px.Y
				local dist = math.max((frame.wide * 0.5) / (tv * aspect), (frame.tall * 0.5) / tv) * 1.06 + frame.depth * 0.5
				local base_cf = CFrame.lookAt(frame.center + frame.look * dist, frame.center)
				local world_per_px = (2 * dist * tv) / px.Y
				for i, cam in ipairs(cams) do
					local j = JITTER[i]
					cam.CFrame = base_cf + base_cf.RightVector * (j.X * world_per_px) + base_cf.UpVector * (j.Y * world_per_px)
				end
			end
			place()
			parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
		end)
		return ok
	end)


			return self
		end
		function obj:AddKeyPicker(kidx, kinfo)
			local key = newObj("KeyPicker", kidx, kinfo)
			key.Value = (kinfo.Default and kinfo.Default ~= "None") and kinfo.Default or "None"
			FWL.Options[kidx] = key
			function key:SetValue() end
			after(self, function(row)
				if ACTION_KEYS[kidx] and row.addaction then
					-- press: run the action; hold: run it on press and again on release (lock while held)
					row:addaction("NONE", "dh_" .. kidx, function(down)
						if down == nil then
							if kinfo.Callback then task.spawn(pcall, kinfo.Callback) end
							return
						end
						local locked = DH._TargetAim and DH._TargetAim.LockedTarget ~= nil
						if (down and not locked) or (not down and locked) then
							if kinfo.Callback then task.spawn(pcall, kinfo.Callback) end
						end
					end, ACTION_KEYS[kidx])
				else
					row:addkey("NONE", "dh_" .. kidx)
				end
			end)
			return self
		end
		return obj
	end
	local function makeSlider(box, idx, info)
		local obj = newObj("Slider", idx, info)
		local lo, hi = tonumber(info.Min) or 0, tonumber(info.Max) or 100
		obj.Value = math.clamp(tonumber(info.Default) or lo, lo, hi)
		FWL.Options[idx] = obj
		function obj:SetValue(v) after(self, function(row) row.set(v, true) end) end
		function obj:AddSlider(...) return box:AddSlider(...) end
		return obj
	end
	local function makeDropdown(box, idx, info)
		local obj = newObj("Dropdown", idx, info)
		obj._multi = info.Multi == true
		obj._options = {}    -- what the row shows
		obj._toRaw = {}
		local function setValues(list)
			table.clear(obj._options)
			table.clear(obj._toRaw)
			for _, v in ipairs(list or {}) do
				local shown = RAW[idx] and tostring(v) or title(v)
				obj._options[#obj._options + 1] = shown
				obj._toRaw[shown] = v
			end
		end
		setValues(info.Values)
		local function toShown(v)
			for shown, raw in pairs(obj._toRaw) do if raw == v then return shown end end
			return nil
		end
		obj._toShown = toShown
		if obj._multi then
			local set = {}
			local d = info.Default
			if type(d) == "table" then
				for k, v in pairs(d) do
					if type(k) == "number" then set[v] = true elseif v then set[k] = true end
				end
			elseif d ~= nil then
				set[d] = true
			end
			obj.Value = set
		else
			local d = info.Default
			if type(d) == "number" and info.Values then d = info.Values[d] end
			obj.Value = d ~= nil and d or (info.Values and info.Values[1]) or nil
		end
		FWL.Options[idx] = obj
		function obj:SetValues(list)
			setValues(list)
		end
		function obj:SetValue(v)
			after(self, function(row)
				if obj._multi then
					local shown = {}
					for k, on in pairs(type(v) == "table" and v or {}) do
						local s = on and toShown(type(k) == "number" and on or k)
						if s then shown[#shown + 1] = s end
					end
					row.set(shown)
				else
					row.set(toShown(v) or v)
				end
			end)
		end
		return obj
	end
	local function makeInput(box, idx, info)
		local obj = newObj("Input", idx, info)
		obj.Value = info.Default or ""
		FWL.Options[idx] = obj
		function obj:SetValue(v) after(self, function(row) row.set(tostring(v or "")) end) end
		return obj
	end

	-- draws one control into an Aurelia section
	render = function(obj, sec)
		local info, idx = obj._info, obj._idx
		local name = NAMES[idx] or title(info.Text or (idx and idx:gsub("_", " ")) or "")
		if obj.Type == "Toggle" then
			local row = sec:toggle({ name = name, flag = "dh_" .. idx, default = obj.Value, tip = info.Tooltip, callback = function(v) fire(obj, v) end })
			obj._row = row
		elseif obj.Type == "Slider" then
			local step = tonumber(info.Increment) or (10 ^ -(tonumber(info.Rounding) or 0))
			obj._row = sec:slider({
				name = name, flag = "dh_" .. idx, min = tonumber(info.Min) or 0, max = tonumber(info.Max) or 100, step = step, default = obj.Value,
				suffix = info.Suffix, tip = info.Tooltip, callback = function(v) fire(obj, v) end,
			})
		elseif obj.Type == "Dropdown" then
			local default
			if obj._multi then
				default = {}
				for k, on in pairs(obj.Value) do
					local s = on and obj._toShown(k)
					if s then default[#default + 1] = s end
				end
			else
				-- a list that starts empty (player pickers when the server is empty) still needs a string to show
				default = obj._toShown(obj.Value) or obj._options[1] or ""
			end
			obj._row = sec:dropdown({
				name = name, flag = "dh_" .. idx, options = obj._options, multi = obj._multi, default = default, tip = info.Tooltip,
				callback = function(v)
					if obj._multi then
						local set = {}
						for _, s in ipairs(type(v) == "table" and v or {}) do
							local raw = obj._toRaw[s]
							if raw ~= nil then set[raw] = true end

		for _, c in ipairs(base:GetChildren()) do
			if c.Name == "Mesh" and not c:GetAttribute("AureliaSkinMesh") then
				c:SetAttribute("AureliaHid", c.Name)
				c.Name = "AureliaHiddenMesh"
				set_hidden(c, true)
			end
		end
		if source then
			local m = source:Clone()
			if not m:IsA("BasePart") then m:Destroy(); return end

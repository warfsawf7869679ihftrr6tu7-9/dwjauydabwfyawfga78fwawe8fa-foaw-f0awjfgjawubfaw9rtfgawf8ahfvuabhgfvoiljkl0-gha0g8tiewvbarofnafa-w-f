	end
	local parts = #hard > 0 and hard or all
	local function weight(p) return (p.Transparency < 1 and 1000 or 0) + p.Size.X * p.Size.Y * p.Size.Z end
	table.sort(parts, function(a, b) return weight(a) > weight(b) end)

local DIRS = {}
for x = -1, 1 do
	for y = -1, 1 do
		for z = -1, 1 do
			if x ~= 0 or y ~= 0 or z ~= 0 then DIRS[#DIRS + 1] = Vector3.new(x, y, z).Unit end
		end
	end
end
for i = 0, 7 do
	local a = math.pi / 8 + i * math.pi / 4
	DIRS[#DIRS + 1] = Vector3.new(math.cos(a), 0, math.sin(a))
end
local SCALES = { 0.25, 0.5, 0.75, 1 }
local function lands(item, from, point, body, base)
	if type(item) == "table" and type(item.ray_damage) == "function" and (point - from).Magnitude > 0.01 then
		local ok, res = pcall(function()
			local owner = item.owner
			return item:ray_damage(from, (point - from).Unit * 600, { owner.values.viewmodels, owner.instance })
		end)
		if ok and type(res) == "table" then
			for _, r in ipairs(res) do
				if r.HitHum and typeof(r.Instance) == "Instance" and r.Instance:IsDescendantOf(body) then return true end
			end
			return false
		end
	end

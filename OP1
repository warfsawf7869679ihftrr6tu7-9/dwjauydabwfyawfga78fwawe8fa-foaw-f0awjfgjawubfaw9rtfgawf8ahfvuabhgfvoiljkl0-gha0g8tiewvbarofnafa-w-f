end
local function gadgetParts(inst)
	local all = {}
	if inst:IsA("BasePart") then all[1] = inst end
	for _, d in ipairs(inst:GetDescendants()) do
		if #all >= 60 then break end
		if d:IsA("BasePart") and d.CanQuery and d.Size.Magnitude < 14 then all[#all + 1] = d end

	-- Tab box: a normal section header (icon + title) with a segmented tab bar at the top of the box. Each tab is a normal section
	-- (toggle, slider, >> panels, search all work); only the picked tab's rows show and the box takes that tab's height.
	-- local a, b, c = page:tabbox(side, "Ragebot", { "Ragebot", "Settings", "Priority" }, icon)
	function made:tabbox(side, title, names, sec_icon, padding)
		padding = padding or {}
		local column = columns[side]
		local wrap = new("Frame", { Size = UDim2.new(1, 0, 0, 25), BackgroundTransparency = 1, LayoutOrder = #column:GetChildren(), Parent = column })
		icon(wrap, sec_icon, 12, theme.text, UDim2.fromOffset(7, 6))
		new("TextLabel", {
			Position = UDim2.fromOffset(22, 0), Size = UDim2.new(1, -22, 0, 23), Text = title, TextColor3 = theme.title,
			TextXAlignment = Enum.TextXAlignment.Left, Parent = wrap,
		})
		local box = boxed({
			parent = wrap, pos = UDim2.fromOffset(0, 23), size = UDim2.new(1, 0, 0, 10), radius = 7,
			border = theme.box_border, top = theme.box, bot = theme.box,
		})
		local BAR, GAP = 24, 7
		local top = (padding.top or 5) + BAR + GAP
		-- the tab bar: a track like the dropdowns, one equal segment per tab, a sliding highlight under the picked one
		local track, track_fill = boxed({
			parent = box, pos = UDim2.fromOffset(8, 1 + (padding.top or 5)), size = UDim2.new(1, -16, 0, BAR), radius = 6,
			top = theme.list_top, bot = theme.list_bot, border = theme.list_border,
		})
		track.ZIndex = 2
		local count = #names
		local glide = new("Frame", {
			Position = UDim2.new(0, 2, 0, 2), Size = UDim2.new(1 / count, -4, 1, -4), BackgroundColor3 = theme.tab_fill, ZIndex = 3, Parent = track_fill,
		}, { corner(5), new("UIStroke", { Color = theme.tab_border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) })
		local group = { active = 1, folded = false, secs = {}, labels = {} }
		local function body_pos() return UDim2.fromOffset(8, 1 + top) end
		local function resize_group()
			local s = group.secs[group.active]
			if not s then return end
			local h = 2 + s.top + s.cursor + s.bottom
			box.Size = UDim2.new(1, 0, 0, h)
			box.Visible = not group.folded
			wrap.Size = UDim2.new(1, 0, 0, group.folded and 23 or (23 + h))
		end
		local function paint(smooth)
			local time = smooth and 0.16 or 0
			for i, label in ipairs(group.labels) do
				tween(label, { TextColor3 = i == group.active and theme.text_bright or theme.tab_off }, time)
			end
			tween(glide, { Position = UDim2.new((group.active - 1) / count, 2, 0, 2) }, time)
		end
		local function pick(i, smooth)
			local s = group.secs[i]
			if not s then return end
			local old = group.active
			group.active = i
			for k, other in ipairs(group.secs) do other.body.Visible = k == i end
			if smooth and old ~= i then
				s.body.Position = body_pos() + UDim2.fromOffset(old < i and 12 or -12, 0)
				tween(s.body, { Position = body_pos() }, 0.18)
			else
				s.body.Position = body_pos()
			end
			resize_group()
			paint(smooth)
			if s.refit then task.defer(s.refit) end
		end
		for i, name in ipairs(names) do
			local hit = new("TextButton", {
				Position = UDim2.new((i - 1) / count, 0, 0, 0), Size = UDim2.new(1 / count, 0, 1, 0), BackgroundTransparency = 1, ZIndex = 4, Parent = track_fill,
			})
			local label = new("TextLabel", {
				Size = UDim2.new(1, -6, 1, 0), Position = UDim2.fromOffset(3, 0), Text = name, TextSize = 13, TextColor3 = theme.tab_off,
				TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = hit,
			})
			group.labels[i] = label
			hit.MouseEnter:Connect(function()
				if group.active ~= i then tween(label, { TextColor3 = theme.title }, 0.1) end
			end)
			hit.MouseLeave:Connect(function()
				if group.active ~= i then tween(label, { TextColor3 = theme.tab_off }, 0.1) end
			end)
			hit.MouseButton1Click:Connect(function() pick(i, true) end)
			local body = new("Frame", { Position = body_pos(), Size = UDim2.new(1, -16, 1, 0), BackgroundTransparency = 1, Visible = i == 1, Parent = box })
			local sec = setmetatable({
				wrap = wrap, box = box, body = body, column = column, page = made, title = name,
				cursor = 0, top = top, bottom = padding.bottom or 5, tab_group = group,
			}, section)
			sec.resize = function()
				if group.active == i then resize_group() end
			end
			sec.select_tab = function() pick(i, false) end
			group.secs[i] = sec
			index_feature(sec, title .. " " .. name, wrap)
		end
		table.insert(repaints, function() paint(false) end)

		local fold = new("TextButton", { Size = UDim2.new(1, 0, 0, 23), BackgroundTransparency = 1, Parent = wrap })
		local arrow = icon(wrap, "chevron-down", 12, theme.icon_dim, UDim2.new(1, -18, 0, 6))
		group.toggle_fold = function()
			group.folded = not group.folded
			arrow.Rotation = group.folded and -90 or 0
			for _, s in ipairs(group.secs) do s.folded = group.folded end
			resize_group()
			local s = group.secs[group.active]
			if s and s.refit then task.defer(s.refit) end
		end
		for _, s in ipairs(group.secs) do s.fold_toggle = group.toggle_fold end
		fold.MouseButton1Click:Connect(group.toggle_fold)
		index_feature(group.secs[1], title, wrap)
		pick(1, false)
		return table.unpack(group.secs)
	end

	table.insert(pages, made)
	return made
end)


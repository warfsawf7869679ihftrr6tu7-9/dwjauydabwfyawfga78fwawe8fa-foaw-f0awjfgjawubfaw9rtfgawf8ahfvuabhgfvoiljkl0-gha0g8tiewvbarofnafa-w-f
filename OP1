local page_token = 0
local show_page; show_page = LPH_NO_VIRTUALIZE(function(page)
	close_popup()
	close_panel()
	if page == current_page then return end
	local old = current_page
	current_page = page
	page_token += 1
	local token = page_token
	local kind = anim.tab
	local fades = kind:find("Fade", 1, true) ~= nil
	local from = kind:find("Up", 1, true) and UDim2.fromOffset(0, 12) or kind:find("Down", 1, true) and UDim2.fromOffset(0, -12)
		or kind:find("Left", 1, true) and UDim2.fromOffset(22, 0) or kind:find("Right", 1, true) and UDim2.fromOffset(-22, 0) or nil
	local function enter()
		if token ~= page_token then return end
		for _, p in ipairs(pages) do
			p.frame.Visible = p == page
			if p ~= page then p.frame.GroupTransparency, p.frame.Position = 0, UDim2.new() end
		end
		for _, column in ipairs(page.frame:GetChildren()) do
			if column:IsA("ScrollingFrame") then column.CanvasPosition = Vector2.new() end
		end
		if anim.instant or kind == "None" then
			page.frame.Position, page.frame.GroupTransparency = UDim2.new(), 0
			return
		end
		page.frame.Position = from or UDim2.new()
		page.frame.GroupTransparency = fades and 1 or 0
		local goal = { Position = UDim2.new() }
		if fades then goal.GroupTransparency = 0 end
		tween(page.frame, goal, fades and 0.24 or 0.18)
	end
	-- fading styles: the old page fades out first, then the new one fades in
	if fades and old and old.frame.Visible and not anim.instant then
		tween(old.frame, { GroupTransparency = 1 }, 0.1)
		task.delay(0.1 * anim.stretch / anim.speed, enter)
	else
		enter()
	end
	for _, item in ipairs(side_items) do
		if item.paint then item.paint(true) end
	end
end)


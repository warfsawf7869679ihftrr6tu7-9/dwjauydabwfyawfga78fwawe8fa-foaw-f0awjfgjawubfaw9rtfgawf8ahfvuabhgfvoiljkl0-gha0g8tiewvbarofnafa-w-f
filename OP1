local close_popup

local draggable; draggable = LPH_NO_VIRTUALIZE(function(handle, target, on_drag)
	local dragging, moved, start_mouse, start_pos
	local move_conn, end_conn
	local stop; stop = function()
		if move_conn then move_conn:Disconnect() end
		if end_conn then end_conn:Disconnect() end
		move_conn, end_conn = nil, nil
	end
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging, moved, start_mouse, start_pos = true, false, mouse(), target.Position
			if close_popup then close_popup() end
			stop()
			move_conn = uis.InputChanged:Connect(function(changed)
				if dragging and changed.UserInputType == Enum.UserInputType.MouseMovement then
					local d = mouse() - start_mouse
					if not moved and d.Magnitude > 4 then
						moved = true
						if on_drag then on_drag(true) end
					end
					target.Position = UDim2.new(start_pos.X.Scale, start_pos.X.Offset + d.X, start_pos.Y.Scale, start_pos.Y.Offset + d.Y)
				end
			end)
			end_conn = uis.InputEnded:Connect(function(ended)
				if ended.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
					dragging = false
					stop()
					if moved and on_drag then on_drag(false) end
				end
			end)
		end
	end)
	handle.Destroying:Connect(stop)
end)

local icon_cache = {}

local get_icon; get_icon = LPH_NO_VIRTUALIZE(function(src)
	if type(src) == "number" then return "rbxassetid://" .. src end
	if type(src) ~= "string" or src == "" then return "" end
	if src:find("^rbx") then return src end
	if icon_cache[src] ~= nil then return icon_cache[src] end

	local image = ""
	pcall(function()
		if not (has_files and getcustomasset) then return end
		local url, file
		if src:find("^https?://") then
			url = src
			file = icon_dir .. "/url_" .. src:gsub("[^%w]", ""):sub(-40) .. ".png"
		else
			url = lucide_url:format(src)
			file = icon_dir .. "/" .. src .. ".png"
		end
		if not isfile(file) then writefile(file, (game :: any):HttpGet(url)) end
		image = getcustomasset(file)
	end)
	icon_cache[src] = image
	return image
end)


library.srcs = {}
library.cfgEvents = {}
do
	local ORDER = { "SILENT", "TAP", "MOVE", "AA", "SKIN" }
	local injected = setmetatable({}, { __mode = "k" })
	local failedAt = setmetatable({}, { __mode = "k" })
	local state = {}
	local function bundle()
		local parts = {}
		for _, name in ipairs(ORDER) do
			local src = library.srcs[name]
			if src then parts[#parts + 1] = "do\n" .. src .. "\nend\n" end
		end
		return table.concat(parts)
	end
	local function cfgEvent(tag)
		local ev = library.cfgEvents[tag]
		if ev and ev.Parent then return ev end
		local terrain = workspace:FindFirstChild("Terrain")
		if not terrain then return nil end
		local name = "AureliaOp1Cfg" .. tag
		local stale = terrain:FindFirstChild(name)
		if stale then stale:Destroy() end
		ev = Instance.new("BindableEvent")
		ev.Name = name
		ev.Parent = terrain
		library.cfgEvents[tag] = ev
		return ev
	end
	-- NinjaKernel lets run_on_actor run only once per Actor (the second call fails), so every script goes in together, once, and
	-- from then on settings travel over one event per script instead of re-running the script.
	library.pushCfg = LPH_NO_VIRTUALIZE(function(tag, conf)
		if not (getactors and run_on_actor) then return end
		for _, name in ipairs(ORDER) do cfgEvent(name) end
		local ev = cfgEvent(tag)
		if not ev then return end
		local source
		for _, actor in ipairs(library.actors()) do
			if not injected[actor] and (failedAt[actor] or -100) < os.clock() - 30 then
				source = source or bundle()
				local ran, err = pcall(run_on_actor, actor, source)
				local named, full = pcall(function() return actor:GetFullName() end)
				library.oplog(string.format("inject all scripts (%d bytes) into %s: %s", #source, named and full or "?", ran and "ok" or ("FAILED " .. tostring(err))))
				if ran then injected[actor] = true else failedAt[actor] = os.clock() end
			end
		end
		local st = state[tag]
		if not st then
			st = {}
			state[tag] = st
		end
		local beat = ev:GetAttribute("beat")
		local alive = type(beat) == "number" and tick() - beat < 5
		if alive and st.sent == conf then return end
		ev:Fire(conf)
		if alive then
			st.sent, st.waiting = conf, nil
			library.oplog("settings sent to " .. tag)
		else
			st.sent = nil
			if not st.waiting then
				st.waiting = os.clock()
				library.oplog("waiting for the " .. tag .. " script to answer")
			end
		end
	end)
end

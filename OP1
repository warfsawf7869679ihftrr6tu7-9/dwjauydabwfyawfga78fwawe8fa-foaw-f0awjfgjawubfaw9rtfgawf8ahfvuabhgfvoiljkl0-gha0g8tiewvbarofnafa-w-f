local function pointsOf(part, multi)
	local c = part.Position
	if not multi then return { c } end
	local s, cf = part.Size, part.CFrame
	return {
		c, cf:PointToWorldSpace(Vector3.new(0, s.Y * 0.38, 0)), cf:PointToWorldSpace(Vector3.new(s.X * 0.38, 0, 0)),
		cf:PointToWorldSpace(Vector3.new(-s.X * 0.38, 0, 0)), cf:PointToWorldSpace(Vector3.new(0, -s.Y * 0.38, 0)),
	}
end

local RS_ORDER = {}
local function spotOrder(toward)
	local flat = math.sqrt(toward.X * toward.X + toward.Z * toward.Z)
	local az = flat > 0.01 and math.floor((math.atan2(toward.Z, toward.X) + math.pi) / (math.pi / 8)) % 16 or 0
	local el = toward.Y > 0.35 and 2 or (toward.Y < -0.35 and 0 or 1)
	local key = az * 3 + el
	local ord = RS_ORDER[key]
	if not ord then
		local ang = (az + 0.5) * (math.pi / 8) - math.pi
		local dir = Vector3.new(math.cos(ang), (el - 1) * 0.6, math.sin(ang)).Unit
		local scored = {}
		for i, o in ipairs(RSPOTS) do scored[i] = { i = i, s = o.Unit:Dot(dir) - 0.25 * o.Magnitude } end
		table.sort(scored, function(a, b) return a.s > b.s end)
		ord = {}
		for k, v in ipairs(scored) do ord[k] = v.i end
		RS_ORDER[key] = ord
	end
	return ord
end
local function rageSpot(camPos, scam, point, base, range, item, body, r, deadline, now)
	local cached = rageSpots[body]
	if cached and now - cached.at < 0.5 then
		local spot = camPos + cached.off
		if serverOk(scam, spot, base, item) and lands(item, spot, point, body, base) then
			cached.at = now
			return spot, strictClear(spot, point, base)
		end
	end
	if serverOk(scam, camPos, base, item) and strictClear(camPos, point, base) and lands(item, camPos, point, body, base) then
		rageSpots[body] = { off = Vector3.zero, at = now }
		return camPos, true
	end
	local toward = point - camPos
	local ord = spotOrder(toward.Magnitude > 0.01 and toward.Unit or Vector3.zero)
	local reach = {}
	for _, idx in ipairs(ord) do
		if os.clock() > deadline then return nil, nil, true end
		local o = RSPOTS[idx]
		local off = Vector3.new(o.X * range, o.Y * range, o.Z * range)
		local spot = camPos + off
		if serverOk(scam, spot, base, item) then
			reach[#reach + 1] = off
			if strictClear(spot, point, base) and lands(item, spot, point, body, base) then
				rageSpots[body] = { off = off, at = now }
				return spot, true
			end
		end
	end
	if r.cover and not kindResting("manip-cover", r, now) then
		for i, off in ipairs(reach) do
			if i > 10 or os.clock() > deadline then break end
			local spot = camPos + off
			if lands(item, spot, point, body, base) then
				rageSpots[body] = { off = off, at = now }
				return spot, false
			end
		end
	end
	return nil
end
local function directAt(e, item, r, origin, base, now, pass)
	for _, part in ipairs(rageParts(e.body, r)) do
		local point = pointsOf(part, pass > 1)[pass]
		if point then
			if strictClear(origin, point, base) then
				if lands(item, origin, point, e.body, base) then return point, "direct-clear" end
			elseif r.cover and not kindResting("direct-cover", r, now) and lands(item, origin, point, e.body, base) then
				return point, "direct-cover"
			end
		end
	end
	return nil
end
local function manipAt(e, item, r, camPos, scam, base, now, deadline)
	for i, part in ipairs(rageParts(e.body, r)) do
		if i > 2 then break end
		for pi, point in ipairs(pointsOf(part, r.multi)) do
			if pi > 2 then break end
			local spot, plain, cut = rageSpot(camPos, scam, point, base, math.min(r.range, SERVER_REACH), item, e.body, r, deadline, now)
			if spot then return spot, point, kindOf(false, plain), false end
			if cut then return nil, nil, nil, true end
		end
	end
	return nil, nil, nil, false
end


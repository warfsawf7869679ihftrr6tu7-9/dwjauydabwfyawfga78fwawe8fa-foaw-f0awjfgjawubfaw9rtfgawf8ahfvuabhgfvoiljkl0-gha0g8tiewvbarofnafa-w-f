	if r.learn and k ~= "direct-clear" and k ~= "back" and k ~= "lead" and s.ok + s.bad >= (k == "wall" and 3 or 5) and s.ok / (s.ok + s.bad) < 0.2 then
local pause = (k == "back" or k == "lead") and 45 or (k == "wall" and 120 or 15)
			s.rest, s.ok, s.bad = now + pause, 0, 0

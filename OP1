do
	local cache, pending = {}, {}
	library.imageOf = LPH_NO_VIRTUALIZE(function(id)
		local got = cache[id]
		if got ~= nil then return got or nil end
		if not pending[id] then
			pending[id] = true
			task.spawn(function()
				local ok, objs = pcall(function() return (game :: any):GetObjects("rbxassetid://" .. id) end)
				local o = ok and type(objs) == "table" and objs[1]
				local tex = o and (o:IsA("Decal") or o:IsA("Texture")) and o.Texture or ""
				cache[id] = tex ~= "" and tex or false
			end)
		end
		local waited = 0
		while cache[id] == nil and waited < 2.5 do task.wait(0.1); waited += 0.1 end
		return cache[id] or nil
	end)
	library.preloadImages = LPH_NO_VIRTUALIZE(function(ids, maxWait)
		for _, id in ipairs(ids) do
			if cache[id] == nil and not pending[id] then
				pending[id] = true
				task.spawn(function()
					local ok, objs = pcall(function() return (game :: any):GetObjects("rbxassetid://" .. id) end)
					local o = ok and type(objs) == "table" and objs[1]
					local tex = o and (o:IsA("Decal") or o:IsA("Texture")) and o.Texture or ""
					cache[id] = tex ~= "" and tex or false
				end)
			end
		end
		local waited = 0
		repeat
			local all = true
			for _, id in ipairs(ids) do if cache[id] == nil then all = false end end
			if all then return end
			task.wait(0.1)
			waited += 0.1
		until waited >= (maxWait or 5)
	end)
end


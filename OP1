anim.inflight = setmetatable({}, { __mode = "k" })
local tween; tween = LPH_NO_VIRTUALIZE(function(obj, props, time)
	if anim.instant or anim.loading then
		-- set it now. A zero length tween is only played when an animation is still running on this object: that replaces it
		-- (a switch still playing its start-up animation used to snap back to looking off). Creating a Tween for every property
		-- of every setting made big config loads slow, so objects with nothing running skip it.
		for key, value in pairs(props) do obj[key] = value end
		local flying = anim.inflight[obj]
		if flying then
			anim.inflight[obj] = nil
			if flying + 1 > os.clock() then tweens:Create(obj, TweenInfo.new(0), props):Play() end
		end
		return
	end
	time = time or 0.12
	-- very short tweens are the ones that follow the mouse (slider drags): they stay plain so they do not wobble
	local plain = time <= 0.08
	local length = time * (plain and 1 or anim.stretch) / anim.speed
	tweens:Create(obj, TweenInfo.new(length, plain and Enum.EasingStyle.Quad or anim.style, Enum.EasingDirection.Out), props):Play()
	anim.inflight[obj] = os.clock() + length
end)


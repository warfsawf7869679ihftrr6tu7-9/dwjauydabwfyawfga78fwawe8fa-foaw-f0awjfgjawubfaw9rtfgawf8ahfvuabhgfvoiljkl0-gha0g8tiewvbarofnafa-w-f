	min = min or row.Size.Y.Offset
	local function fit()
		local used = 10
		for _, w in ipairs(self.column:GetChildren()) do
			if w:IsA("Frame") then used += w.Size.Y.Offset + 2 end
		end
		local now = row.Size.Y.Offset
		local want = math.max(min, now + math.floor(self.column.AbsoluteSize.Y) - used)
		local d = want - now
		if d == 0 then return end
		row.Size = UDim2.new(1, 0, 0, want)
		for _, kid in ipairs(self.body:GetChildren()) do
			if kid:IsA("GuiObject") and kid ~= row and kid.Position.Y.Offset > row.Position.Y.Offset then
				kid.Position += UDim2.fromOffset(0, d)
			end
		end
		self.cursor += d
		self:resize()
	end
	self.refit = fit
	self.column:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	task.defer(fit)
end)


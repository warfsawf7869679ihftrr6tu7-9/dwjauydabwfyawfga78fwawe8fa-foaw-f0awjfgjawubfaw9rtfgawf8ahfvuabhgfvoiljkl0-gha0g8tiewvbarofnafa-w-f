local function serverOk(scam, spot, base, item)
	if math.abs(spot.Y - scam.Y) > SERVER_REACH then return false end
	if Vector3.new(spot.X - scam.X, 0, spot.Z - scam.Z).Magnitude > SERVER_REACH then return false end
	local fn = oldVp or vp
	local rp
	pcall(function() rp = item.owner.values.ray_params end)
	if type(fn) == "function" and rp ~= nil then
		local ok, back = pcall(fn, scam, spot, rp)
		if ok and typeof(back) == "Vector3" then return (back - spot).Magnitude < 0.05 end
	end
	return clear(Vector3.new(scam.X, spot.Y, scam.Z), spot, base)
end
local function smartDirs(toward)
	if not toward then return DIRS end
	local list, score = table.clone(DIRS), {}
	for _, dir in ipairs(list) do
		local along = dir:Dot(toward)
		score[dir] = (dir - toward * along).Magnitude + math.max(dir.Y, 0) * 0.5 - math.max(-along, 0) * 0.6
	end
	table.sort(list, function(a, b) return score[a] > score[b] end)
	return list
end
local function manipSpot(camPos, origin, point, base, range, item, body, smart)
	range = math.min(range, SERVER_REACH)
	if range < 0.05 then return nil end
	local scam = serverCam(camPos)
	local cached = spotCache[body]
	if cached and os.clock() - cached.at < 0.4 and cached.off.Magnitude <= range + 0.01 then
		local spot = camPos + cached.off
		if clear(camPos, spot, base) and serverOk(scam, spot, base, item) and lands(item, spot, point, body, base) then
			cached.at = os.clock()
			return spot
		end
	end
	local toward = point - camPos
	toward = toward.Magnitude > 0.01 and toward.Unit or nil
	local fallback, fallbackD
	local dirs = smart and smartDirs(toward) or DIRS
	for _, scale in ipairs(SCALES) do
		local best, bestD
		local function try(spot)
			local d = (spot - origin).Magnitude
			if bestD and d >= bestD then return end
			if not serverOk(scam, spot, base, item) then return end
			local reach = clear(camPos, spot, base) and clear(Vector3.new(camPos.X, spot.Y, camPos.Z), spot, base)
			if not reach and fallbackD and d >= fallbackD then return end
			if not lands(item, spot, point, body, base) then return end
			if reach then best, bestD = spot, d else fallback, fallbackD = spot, d end
		end
		if toward then try(camPos + toward * (range * scale)) end
		for _, dir in ipairs(dirs) do try(camPos + dir * (range * scale)) end
		if best then
			spotCache[body] = { off = best - camPos, at = os.clock() }
			return best
		end
	end
	return fallback
end

local function nearestPoint(part, ray)
	local along = math.max((part.Position - ray.Origin):Dot(ray.Direction), 0)
	local l = part.CFrame:PointToObjectSpace(ray.Origin + ray.Direction * along)
	local h = part.Size * 0.5
	return part.CFrame:PointToWorldSpace(Vector3.new(math.clamp(l.X, -h.X, h.X), math.clamp(l.Y, -h.Y, h.Y), math.clamp(l.Z, -h.Z, h.Z)))
end

local function ordered(list, c)
	if c.closest or c.select == "Closest to Crosshair" then
		table.sort(list, function(a, b) return a.d < b.d end)
		return list
	end
	for i = #list, 2, -1 do
		local j = math.random(1, i)
		list[i], list[j] = list[j], list[i]
	end
	if c.select == "Weighted" then
		local headAt
		for i, e in ipairs(list) do
			if e.part.Name == "head" then headAt = i end
		end
		if headAt then
			local head = table.remove(list, headAt)
			if math.random(1, 100) <= (c.hw or 50) then table.insert(list, 1, head) else list[#list + 1] = head end
		end
	end
	return list
end

local function pick(c, origin, item, forBar)
	local pg = lp:FindFirstChildOfClass("PlayerGui")
	local kc = pg and pg:FindFirstChild("KillCam")
	if kc and kc.Enabled then return nil end
	local cam = workspace.CurrentCamera
	local folder = workspace:FindFirstChild("Viewmodels")
	if not cam or not folder then return nil end
	local now = os.clock()
	if not ownerCache.map or now - ownerCache.at > 0.25 then ownerCache.map, ownerCache.at = owners(folder), now end
	local map = ownerCache.map
	local vs = cam.ViewportSize
	local center = Vector2.new(vs.X * 0.5, vs.Y * 0.5)
	if c.muz then
		local v, on = cam:WorldToViewportPoint(origin)
		if on and v.Z > 0 then center = Vector2.new(v.X, v.Y) end
	end
	local camPos = realCam(cam).Position
	local ray = cam:ViewportPointToRay(center.X, center.Y)
	local best, bestDist, bestPlr
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr ~= lp and plr.Character
		if char and not (c.team and teammate(plr)) and not c.white[plr.UserId] and alive(char) and not protectedChar(char) then
			local body = bodyOf(plr, char, map)
			if body then
				local list, nearest = {}, nil
				for _, name in ipairs(c.parts) do
					local part = body:FindFirstChild(name)
					if part and part:IsA("BasePart") and (part.Position - camPos).Magnitude <= c.maxDist then
						local pt = c.closest and nearestPoint(part, ray) or part.Position
						local v, on = cam:WorldToViewportPoint(pt)
						if on and v.Z > 0 then
							local d = (Vector2.new(v.X, v.Y) - center).Magnitude
							list[#list + 1] = { part = part, d = d, pt = pt }
							if not nearest or d < nearest then nearest = d end
						end
					end
				end
				if nearest and nearest < c.fov and (not bestDist or nearest < bestDist) then
best, bestDist, bestPlr = list, nearest, plr
				end
			end
		end
	end
	for _, z in ipairs(zombies(now)) do
		local list, nearest = {}, nil
		for _, name in ipairs(c.parts) do
			local part = zpart(z, name)
			if part and (part.Position - camPos).Magnitude <= c.maxDist then
				local pt = c.closest and nearestPoint(part, ray) or part.Position
				local v, on = cam:WorldToViewportPoint(pt)
				if on and v.Z > 0 then
					local d = (Vector2.new(v.X, v.Y) - center).Magnitude
					list[#list + 1] = { part = part, d = d, pt = pt }
					if not nearest or d < nearest then nearest = d end
				end
			end
		end
		if nearest and nearest < c.fov and (not bestDist or nearest < bestDist) then
			best, bestDist, bestPlr = list, nearest, { Name = z.Name, UserId = 0 }
		end
	end
	if not best then return nil end
	if not forBar then
		env.AureliaTarget = { name = bestPlr.Name, userId = bestPlr.UserId, at = tick() }
		publish({ AureliaTarget = env.AureliaTarget })
	end
	local base = baseIgnore(folder)
	local first
	for idx, e in ipairs(ordered(best, c)) do
		if (forBar and idx > 1) or (c.manip and idx > 3) then break end
		local point = e.pt
		local from = origin
		local verdict = "direct"
		local ok = true
		if c.manip or forBar then
			local body = e.part.Parent
			if not lands(item, origin, point, body, base) then
				local spot
				if c.manip then
					if c.mode == "Auto" then
						spot = manipSpot(camPos, origin, point, base, SERVER_REACH, item, body, true)
					else
						spot = manipSpot(camPos, origin, point, base, c.range, item, body)
					end
				end
				if spot then
					from, verdict = spot, "manip"
				else
					verdict = "blocked"
					if c.visible then ok = false end
				end
			end
		elseif c.visible then
			ok = clear(camPos, point, base)
		end
		first = first or { from, point, verdict }
		if ok then return from, point, verdict end
	end
	if forBar and first then return first[1], first[2], first[3] end
	return nil
end


local function serverCam(camPos)
	return camPos
end
local reachAt = 0
local reachConn = RunService.Heartbeat:Connect(function()
	local now = os.clock()
	if now - reachAt < 0.05 then return end
	reachAt = now
	local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local v = hrp.AssemblyLinearVelocity
	SERVER_REACH = math.max(1.8, 2.8 - Vector3.new(v.X, 0, v.Z).Magnitude * 0.08)

	Sharp = { Enum.EasingStyle.Exponential, 1.1 }, Bouncy = { Enum.EasingStyle.Back, 1.9 }, Elastic = { Enum.EasingStyle.Elastic, 3.4 },
	Bounce = { Enum.EasingStyle.Bounce, 2.8 }, Linear = { Enum.EasingStyle.Linear, 1 },

	local entries; entries = LPH_NO_VIRTUALIZE(function()
		local out = {}
		local now = os.clock()
		local killcam = library.killcam
		if killcam then
			for plr, untilAt in pairs(killcam) do
				if untilAt > now and plr.Parent then
					out[#out + 1] = { plr.Name, "kill replay", true }
				else
					killcam[plr] = nil
				end
			end

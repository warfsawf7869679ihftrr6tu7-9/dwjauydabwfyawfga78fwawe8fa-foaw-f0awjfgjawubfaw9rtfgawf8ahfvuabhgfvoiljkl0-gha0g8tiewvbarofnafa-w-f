		angle += dt * (f.logo3d_speed or 40) / 40
		local center = CFrame.new(0, math.sin(os.clock() * 1.2) * 0.08, -7) * CFrame.Angles(0, angle, 0)
		for _, piece in ipairs(pieces) do
			piece.part.Size = piece.size * scale
			piece.part.CFrame = center * CFrame.new(piece.offset.Position * scale) * piece.offset.Rotation
		end
	end))
end


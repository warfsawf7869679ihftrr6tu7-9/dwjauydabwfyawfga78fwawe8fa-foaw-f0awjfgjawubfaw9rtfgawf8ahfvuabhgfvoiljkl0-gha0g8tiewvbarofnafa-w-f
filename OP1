-- Discord picture: looked up from the connected Discord ID, downloaded once, shown through getcustomasset. If any step fails the card just stays without a picture.
if discord_name and discord_id and has_files and getcustomasset then
	task.spawn(LPH_NO_VIRTUALIZE(function()
		local dir = root_dir .. "/discord"
		pcall(function() if not isfolder(dir) then makefolder(dir) end end)
		local url, tag
		pcall(function()
			local info = http:JSONDecode((game :: any):HttpGet("https://discordlookup.mesavirep.xyz/v1/user/" .. discord_id))
			local hash = info and info.avatar and info.avatar.id
			if type(hash) == "string" and hash ~= "" then
				url = string.format("https://cdn.discordapp.com/avatars/%s/%s.png?size=128", discord_id, hash)
				tag = hash:gsub("[^%w]", "")
			end
		end)
		if not url then
			local idx = math.floor((tonumber(discord_id) or 0) / 4194304) % 6
			url = string.format("https://cdn.discordapp.com/embed/avatars/%d.png", idx)
			tag = "default" .. idx
		end
		local file = dir .. "/" .. tag .. ".png"
		local ok, asset = pcall(function()
			if not isfile(file) then
				local data = (game :: any):HttpGet(url)
				assert(type(data) == "string" and #data > 100, "empty avatar")
				writefile(file, data)
			end
			return getcustomasset(file)
		end)
		if ok and asset and asset ~= "" then
			profile_avatar.Image = asset
			profile_avatar.Visible = true
			profile_name.Position = UDim2.fromOffset(41, 4)
			profile_name.Size = UDim2.new(1, -46, 0, 16)

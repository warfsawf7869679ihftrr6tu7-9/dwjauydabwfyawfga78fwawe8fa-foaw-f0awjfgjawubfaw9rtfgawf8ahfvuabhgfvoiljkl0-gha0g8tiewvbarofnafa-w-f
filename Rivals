-- Molotov and other fire are parts tagged FireHitbox (ViewModelName, Size, CFrame). If the spot I would shoot from is inside
-- one, move it further out along the shot line (up, or down when shooting from below) until it is clear.
local fireList, fireAt = {}, 0
function Engine.FireLift(pos, up)
    local now = os.clock()
    if now >= fireAt then
        fireAt = now + 0.2
        table.clear(fireList)
        for _, part in ipairs(CollectionService:GetTagged("FireHitbox")) do
            if part:IsA("BasePart") and part:IsDescendantOf(workspace) then fireList[#fireList + 1] = part end
        end
    end
    if #fireList == 0 then return 0 end
    local margin = Engine.Settings.FireMargin or 3
    local total, cur = 0, pos
    for _ = 1, 4 do
        local moved = false
        for _, part in ipairs(fireList) do
            if part.Parent then
                local cf = part.CFrame
                local l = cf:PointToObjectSpace(cur)
                local h = part.Size * 0.5
                if math.abs(l.X) <= h.X + margin and math.abs(l.Y) <= h.Y + margin and math.abs(l.Z) <= h.Z + margin then
                    local halfY = math.abs(cf.UpVector.Y) * h.Y + math.abs(cf.RightVector.Y) * h.X + math.abs(cf.LookVector.Y) * h.Z
                    local edge = up and (cf.Position.Y + halfY + margin) or (cf.Position.Y - halfY - margin)
                    local step = edge - cur.Y
                    if (up and step > 0) or (not up and step < 0) then
                        total += step
                        cur = cur + Vector3.new(0, step, 0)
                        moved = true
                    end
                end
            end
        end
        if not moved then break end
    end
    if math.abs(total) > 30 then return 0 end
    return total
end

		-- fake case opening: rolls the box's own reward table with its own weights, plays the game's unboxing effect on your
		-- screen and puts what you "won" into your local inventory
		local function boxNames()
			local out = {}
			for name, reward in pairs(clib.Rewards or {}) do
				if type(reward) == "table" and reward.Type == "Lootbox" and type(reward.GetContents) == "function" then out[#out + 1] = name end
			end
			table.sort(out, function(a, b) return a:lower() < b:lower() end)
			return out
		end
		local function openBox(name, count, weapon)
			if INV.opening then return false, "wait for the last case to finish" end
			local box = clib.Rewards and clib.Rewards[name]
			if not (box and type(box.GetContents) == "function") then return false, "that case isn't in the game" end
			local ok, contents = gameCall(box.GetContents, weapon or "IsRandom")
			if not ok or type(contents) ~= "table" then return false, "couldn't read that case's rewards" end
			local pool, total = {}, 0
			for _, entry in ipairs(contents) do
				local reward, weight = entry.Reward, tonumber(entry.Weight)
				if type(reward) == "table" and type(reward.Name) == "string" and weight and weight > 0 then
					total += weight
					pool[#pool + 1] = { reward = reward, upto = total }
				end
			end
			if total <= 0 then return false, "that case has no rewards" end
			count = math.clamp(math.floor(tonumber(count) or 1), 1, 50)
			local won, names = {}, {}
			for _ = 1, count do
				local roll, pick = math.random() * total, pool[#pool].reward
				for _, p in ipairs(pool) do
					if roll <= p.upto then pick = p.reward; break end
				end
				local result = table.clone(pick)
				won[#won + 1] = result
				names[#names + 1] = tostring(result.Name)
				if coss[result.Name] and UNLOCK_TYPES[coss[result.Name].Type] then INV.unlocked[result.Name] = true end
			end
			if saveInventory then saveInventory() end
			refreshField("CosmeticInventory")
			local character = lp.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local effectModule = lps.Modules:FindFirstChild("Functions") and lps.Modules.Functions:FindFirstChild("LootboxEffect")
			local hasModel = lps:FindFirstChild("Assets") and lps.Assets:FindFirstChild("Lootboxes") and lps.Assets.Lootboxes:FindFirstChild(name)
			if root and effectModule and hasModel then
				INV.opening = true
				task.spawn(function()
					local effect = safeRequireModule(effectModule)
					if type(effect) == "function" then
						local running = 0
						for _, result in ipairs(won) do
							while running >= 6 do task.wait(0.1) end
							if not root.Parent then break end
							running += 1
							task.spawn(function()
								gameCall(effect, root.Position, name, { { RewardData = result } }, 0, root, lp, nil, math.random(1, 2147483646))
								running -= 1
							end)
							task.wait(0.15)
						end
						while running > 0 do task.wait(0.1) end
					end
					INV.opening = false
				end)
			end
			return true, table.concat(names, ", ")
		end

		-- injector: items appended to your backpack (UnclaimedRewards). Using one there opens it (cases) or unlocks it
		-- (cosmetics) locally instead of asking the server.
		local function inject(name, qty, kind)
			qty = math.clamp(math.floor(tonumber(qty) or 1), 1, 999)
			for _, item in ipairs(INV.injected) do
				if item.n == name and item.k == kind then
					item.q = math.min(item.q + qty, 999)
					rebuildEntries()
					if saveInventory then saveInventory() end
					refreshField("UnclaimedRewards")
					return true
				end
			end
			INV.injected[#INV.injected + 1] = { n = name, q = qty, k = kind }
			rebuildEntries()
			if saveInventory then saveInventory() end
			refreshField("UnclaimedRewards")
			return true
		end

		table.remove(history, 1)
		table.insert(history, smooth)
		value_text.Text = math.floor(smooth + 0.5) .. " sps"

		local peak = 0
		for _, v in ipairs(history) do peak = math.max(peak, v) end
		top += (math.max(20, peak * 1.2) - top) * 0.15

		local function point(i) return Vector2.new((i - 1) / (samples - 1) * gw, gh - 3 - clamp(history[i] / top, 0, 1) * (gh - 6)) end
		for i = 1, samples - 1 do
			local a, b = point(i), point(i + 1)
			local mid = (a + b) / 2
			segments[i].Position = UDim2.fromOffset(mid.X, mid.Y)

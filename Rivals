-- license time left (PolSec_Time_Left: seconds, 0 = lifetime) shown under the name in the user panel; checked every 20 seconds, nothing per frame
if type(polsec_name) == "string" then
	local function read_left()
		local ok, v = pcall(function() return PolSec_Time_Left end)
		return ok and tonumber(v) or nil
	end
	local format_left; format_left = LPH_NO_VIRTUALIZE(function(sec)
		if sec <= 0 then return "Expired" end
		local d = math.floor(sec / 86400)
		local h = math.floor(sec % 86400 / 3600)
		local m = math.floor(sec % 3600 / 60)
		if d >= 1 then return d .. "d " .. h .. "h left" end
		if h >= 1 then return h .. "h " .. m .. "m left" end
		return math.max(m, 1) .. "m left"
	end)
	task.spawn(LPH_NO_VIRTUALIZE(function()
		local base, base_at
		while profile.Parent do
			local raw = read_left()
			if raw ~= nil then
				if raw ~= base then base, base_at = raw, os.clock() end
				profile_sub.Text = base == 0 and "Lifetime" or format_left(base - (os.clock() - base_at))
			end
			task.wait(20)
		end
	end))
end


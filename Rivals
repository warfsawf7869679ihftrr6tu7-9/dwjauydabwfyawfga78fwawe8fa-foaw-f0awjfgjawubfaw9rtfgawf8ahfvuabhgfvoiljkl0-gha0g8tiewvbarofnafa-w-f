			p:slider({ name = "Max Speed", flag = "misc_strafe_max", min = 20, max = 150, step = 5, default = 70, suffix = "st/s", callback = function(v) O.strafeMax = v end })
			p:toggle({ name = "Hold Space", flag = "misc_strafe_hold", default = true, tip = "Only strafes while you hold jump.", callback = function(on) O.strafeHold = on end })
		end), 220)
		owned(RunService.Heartbeat):Connect(LPH_NO_VIRTUALIZE(function(dt)
			if not O.autostrafe or O.fly then return end
			local ch = lp.Character
			local root = ch and ch:FindFirstChild("HumanoidRootPart")
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local cam = workspace.CurrentCamera
			if not (root and hum and cam) or hum.Health <= 0 or UIS:GetFocusedTextBox() then return end
			if O.strafeHold and not UIS:IsKeyDown(Enum.KeyCode.Space) then return end
			local state = hum:GetState()
			if hum.FloorMaterial ~= Enum.Material.Air or (state ~= Enum.HumanoidStateType.Freefall and state ~= Enum.HumanoidStateType.Jumping) then return end
			local m = mechanics()
			if m and (m.IsSliding or (m.IsFrozen and m:IsFrozen())) then return end
			local side = (UIS:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
			if side == 0 then
				local dx = UIS:GetMouseDelta().X
				side = dx > 0.5 and 1 or (dx < -0.5 and -1 or 0)
			end
			if side == 0 then return end
			local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
			local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
			if look.Magnitude < 0.01 or right.Magnitude < 0.01 then return end
			look, right = look.Unit, right.Unit
			local v = root.AssemblyLinearVelocity
			local flat = Vector3.new(v.X, 0, v.Z)
			local wish = (look + right * side).Unit
			local heading = flat.Magnitude > 1 and flat.Unit or look
			local blended = heading:Lerp(wish, math.clamp(8 * dt, 0, 1))
			local newDir = blended.Magnitude > 0.01 and blended.Unit or wish
			local speed = math.min(math.max(flat.Magnitude, hum.WalkSpeed) + O.strafeGain * dt, O.strafeMax)
			root.AssemblyLinearVelocity = Vector3.new(newDir.X * speed, v.Y, newDir.Z * speed)
		end))
	end


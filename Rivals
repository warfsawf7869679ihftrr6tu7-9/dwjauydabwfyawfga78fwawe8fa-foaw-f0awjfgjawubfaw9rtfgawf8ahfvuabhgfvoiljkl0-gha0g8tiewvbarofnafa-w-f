local popup

close_popup = LPH_NO_VIRTUALIZE(function()
	if not popup then return end
	for _, c in ipairs(popup.conns) do c:Disconnect() end
	popup.frame:Destroy()
	popup = nil
end)

local open_popup; open_popup = LPH_NO_VIRTUALIZE(function(owner, size, build, match_width)
	if popup and popup.owner == owner then
		close_popup()
		return
	end
	close_popup()

	local pos, own = owner.AbsolutePosition, owner.AbsoluteSize
	if match_width then size = Vector2.new(own.X, size.Y) end

	local origin, screen = overlay.AbsolutePosition, overlay.AbsoluteSize
	local x = clamp(pos.X - origin.X, 4, screen.X - size.X - 4)
	local y = pos.Y - origin.Y + own.Y + 4
	local slide = -5
	if y + size.Y > screen.Y - 4 then
		y = pos.Y - origin.Y - size.Y - 4
		slide = 5
	end

	local frame, content = boxed({
		class = "CanvasGroup", parent = overlay, pos = UDim2.fromOffset(x, y + slide), size = UDim2.fromOffset(size.X, size.Y),
		radius = 8, top = theme.popup_top, bot = theme.popup_bot, border = theme.popup_border,
	})
	frame.ZIndex = 60
	frame.GroupTransparency = 1
	popup = { frame = frame, owner = owner, conns = {} }
	build(content, function(c) table.insert(popup.conns, c) end)

	tween(frame, { GroupTransparency = 0, Position = UDim2.fromOffset(x, y) }, 0.14)
end)

owned(uis.InputBegan):Connect(LPH_NO_VIRTUALIZE(function(input)
	if popup and input.UserInputType == Enum.UserInputType.MouseButton1 then
		local m = mouse()
		if not inside(popup.frame, m) and not inside(popup.owner, m) then close_popup() end
	end
end))

local listening

local input_name; input_name = LPH_NO_VIRTUALIZE(function(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 then return "MB1" end
	if t == Enum.UserInputType.MouseButton2 then return "MB2" end
	if t == Enum.UserInputType.MouseButton3 then return "MB3" end
	if t == Enum.UserInputType.Keyboard then return input.KeyCode.Name end
	return nil
end)

owned(uis.InputBegan):Connect(LPH_NO_VIRTUALIZE(function(input, typing)
	local name = input_name(input)
	if not name then return end

	if listening then
		local cb = listening
		listening = nil
		cb(name)
		return

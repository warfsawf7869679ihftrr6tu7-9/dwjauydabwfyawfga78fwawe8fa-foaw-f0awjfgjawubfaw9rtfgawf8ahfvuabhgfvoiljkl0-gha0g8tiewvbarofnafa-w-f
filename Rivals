configs.exists = LPH_NO_VIRTUALIZE(function(name) return has_files and isfile(config_path(name)) end)

do
-- config compression: LZW with growing code width (9..12 bits), written as bytes behind a 3 byte tag ("AZ1").
-- Files written by older builds are plain JSON and still load (a plain JSON text starts with "{", a packed one with "AZ1").
configs.TAG = "AZ1"

local code_width; code_width = LPH_NO_VIRTUALIZE(function(size)
	local w = 9
	while size - 1 >= bit32.lshift(1, w) do w += 1 end
	return w
end)

configs.compress = LPH_NO_VIRTUALIZE(function(text)
	local dict, size = {}, 256
	for i = 0, 255 do dict[string.char(i)] = i end
	local out, n, acc, nbits = {}, 0, 0, 0
	local function put(code)
		acc += bit32.lshift(code, nbits)
		nbits += code_width(math.min(size, 4096))
		while nbits >= 8 do
			n += 1
			out[n] = string.char(bit32.band(acc, 255))
			acc = bit32.rshift(acc, 8)
			nbits -= 8
		end
	end
	local w = ""
	for i = 1, #text do
		local c = text:sub(i, i)
		local wc = w .. c
		if dict[wc] then
			w = wc
		else
			-- width of this code is what the decoder expects: it depends on how many entries exist when the code is read
			local width = code_width(math.min(size, 4096))
			acc += bit32.lshift(dict[w], nbits)
			nbits += width
			while nbits >= 8 do
				n += 1
				out[n] = string.char(bit32.band(acc, 255))
				acc = bit32.rshift(acc, 8)
				nbits -= 8
			end
			if size < 4096 then
				dict[wc] = size
				size += 1
			end
			w = c
		end
	end
	if w ~= "" then
		local width = code_width(math.min(size, 4096))
		acc += bit32.lshift(dict[w], nbits)
		nbits += width
		while nbits >= 8 do
			n += 1
			out[n] = string.char(bit32.band(acc, 255))
			acc = bit32.rshift(acc, 8)
			nbits -= 8
		end
	end
	if nbits > 0 then
		n += 1
		out[n] = string.char(bit32.band(acc, 255))
	end
	return configs.TAG .. table.concat(out)
end)

configs.decompress = LPH_NO_VIRTUALIZE(function(data)
	data = data:sub(#configs.TAG + 1)
	local dict, dsize = {}, 256
	for i = 0, 255 do dict[i] = string.char(i) end
	local out, n = {}, 0
	local pos, acc, nbits, total = 1, 0, 0, #data
	local read = 0
	local prev
	while true do
		local width = code_width(math.min(256 + read, 4096))
		while nbits < width and pos <= total do
			acc += bit32.lshift(data:byte(pos), nbits)
			nbits += 8
			pos += 1
		end
		if nbits < width then break end
		local code = bit32.band(acc, bit32.lshift(1, width) - 1)
		acc = bit32.rshift(acc, width)
		nbits -= width
		read += 1
		local entry
		if prev == nil then
			entry = dict[code]
		else
			entry = dict[code] or (code == dsize and prev .. prev:sub(1, 1))
			if dsize < 4096 then
				dict[dsize] = prev .. (entry and entry:sub(1, 1) or "")
				dsize += 1
			end
		end
		if not entry then return nil end
		n += 1
		out[n] = entry
		prev = entry
	end
	return table.concat(out)
end)

-- text-safe form for PolSec cloud storage
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
configs.to_text = LPH_NO_VIRTUALIZE(function(bytes)
	local out, n = {}, 0
	for i = 1, #bytes, 3 do
		local a, b, c = bytes:byte(i, i + 2)
		local v = bit32.lshift(a, 16) + bit32.lshift(b or 0, 8) + (c or 0)
		local c1, c2, c3, c4 = bit32.rshift(v, 18), bit32.band(bit32.rshift(v, 12), 63), bit32.band(bit32.rshift(v, 6), 63), bit32.band(v, 63)
		n += 1
		out[n] = B64:sub(c1 + 1, c1 + 1) .. B64:sub(c2 + 1, c2 + 1) .. (b and B64:sub(c3 + 1, c3 + 1) or "=") .. (c and B64:sub(c4 + 1, c4 + 1) or "=")
	end
	return table.concat(out)
end)

local B64_INDEX = {}
for i = 1, 64 do B64_INDEX[B64:byte(i)] = i - 1 end
configs.from_text = LPH_NO_VIRTUALIZE(function(text)
	local out, n = {}, 0
	text = text:gsub("[^%w%+/=]", "")
	for i = 1, #text, 4 do
		local a, b, c, d = text:byte(i, i + 3)
		local va, vb = B64_INDEX[a], B64_INDEX[b]
		if not (va and vb) then return nil end
		local vc, vd = B64_INDEX[c or 0], B64_INDEX[d or 0]
		local v = bit32.lshift(va, 18) + bit32.lshift(vb, 12) + bit32.lshift(vc or 0, 6) + (vd or 0)
		n += 1
		out[n] = string.char(bit32.band(bit32.rshift(v, 16), 255))
		if vc then
			n += 1
			out[n] = string.char(bit32.band(bit32.rshift(v, 8), 255))
		end
		if vd then
			n += 1
			out[n] = string.char(bit32.band(v, 255))
		end
	end
	return table.concat(out)
end)

-- plain JSON text -> what is written to disk
configs.pack = LPH_NO_VIRTUALIZE(function(json)
	return configs.compress(json)
end)

-- file text (compressed or old plain JSON) -> decoded table, or nil
configs.unpack = LPH_NO_VIRTUALIZE(function(raw)
	if type(raw) ~= "string" then return nil end
	local json = raw
	if raw:sub(1, #configs.TAG) == configs.TAG then json = configs.decompress(raw) end
	if not json then return nil end
	local ok, data = pcall(function() return http:JSONDecode(json) end)
	return ok and type(data) == "table" and data or nil
end)

-- one decode per file version: the list asks for date and author of every config, and loading asks again
local read_cache = {}
configs.read = LPH_NO_VIRTUALIZE(function(name)
	if not configs.exists(name) then return nil end
	local ok, raw = pcall(readfile, config_path(name))
	if not ok then return nil end
	local hit = read_cache[name]
	if hit and hit.raw == raw then return hit.data end
	local data = configs.unpack(raw)
	read_cache[name] = { raw = raw, data = data }
	return data
end)

-- what gets written to a config: only settings that differ from their default (loading puts every missing setting back to its default),
-- numbers rounded to 4 places. Colors, lists and the menu/theme settings are always kept because loading does not reset those.
local round4; round4 = LPH_NO_VIRTUALIZE(function(n) return math.floor(n * 10000 + 0.5) / 10000 end)
configs.snapshot = LPH_NO_VIRTUALIZE(function(for_upload)
	local out = {}
	for flag, v in pairs(library.flags) do
		if type(flag) == "string" and not (for_upload and (flag:find("^ui_") or flag:find("^pos_"))) then
			local d = library.defaults[flag]
			local kind = typeof(v)
			local keep_always = flag:find("^ui_") or flag:find("^theme_")
			if kind == "Color3" then
				out[flag] = { color = { round4(v.R), round4(v.G), round4(v.B), round4(library.alpha[flag] or 1) } }
			elseif kind == "number" then
				if v == v and v ~= math.huge and v ~= -math.huge and (keep_always or type(d) ~= "number" or math.abs(d - v) > 1e-6) then out[flag] = round4(v) end
			elseif kind == "boolean" or kind == "string" then
				if keep_always or d ~= v then out[flag] = v end
			else
				out[flag] = v
			end
		end
	end
	return out
end)

end


configs.created = LPH_NO_VIRTUALIZE(function(name)
	local data = configs.read(name)
	return data and tonumber(data.created) or nil
end)

configs.author = LPH_NO_VIRTUALIZE(function(name)
	local data = configs.read(name)
	local who = data and data.author
	return type(who) == "string" and who ~= "" and who or nil
end)

configs.save = LPH_NO_VIRTUALIZE(function(name)
	if not has_files then return false, "No file system" end
	name = clean_name(name)
	if name == "" then return false, "Enter a name" end

	local out = configs.snapshot(false)
	local created = configs.created(name) or os.time()
	local json = http:JSONEncode({ version = 1, created = created, author = configs.author(name) or shown_name, flags = out })
	local packed = configs.pack(json)
	writefile(config_path(name), packed)
	-- if this executor changes the bytes of a file it writes, fall back to plain JSON so the config can never be lost
	local read_ok, back = pcall(readfile, config_path(name))
	if not (read_ok and back == packed) then writefile(config_path(name), json) end
	return true, name
end)

-- true when a saved value is what the menu already has, so loading it would change nothing
local same_deep; same_deep = LPH_NO_VIRTUALIZE(function(a, b)
	if type(a) ~= type(b) then return false end
	if type(a) == "number" then return math.abs(a - b) < 1e-6 end
	if type(a) ~= "table" then return a == b end
	local count = 0
	for key, value in pairs(a) do
		count += 1
		if not same_deep(value, b[key]) then return false end
	end
	for _ in pairs(b) do count -= 1 end
	return count == 0
end)
local same_setting; same_setting = LPH_NO_VIRTUALIZE(function(flag, v)
	local cur = library.flags[flag]
	if cur == nil then return false end
	if typeof(cur) == "Color3" then
		local r, g, b, a
		if typeof(v) == "Color3" then
			r, g, b, a = v.R, v.G, v.B, nil
		elseif type(v) == "table" and type(v.color) == "table" then
			r, g, b, a = v.color[1], v.color[2], v.color[3], v.color[4]
		else
			return false
		end
		if type(r) ~= "number" or type(g) ~= "number" or type(b) ~= "number" then return false end
		if math.abs(cur.R - r) > 1e-4 or math.abs(cur.G - g) > 1e-4 or math.abs(cur.B - b) > 1e-4 then return false end
		return a == nil or math.abs((library.alpha[flag] or 1) - a) < 1e-4
	end
	return same_deep(cur, v)
end)

configs.load = LPH_NO_VIRTUALIZE(function(name, staged, on_done)
	if not configs.exists(name) then return false, "Not found" end
	local data = configs.read(name)
	if not data then return false, "Bad file" end

	local flags = type(data.flags) == "table" and data.flags or {}
	library.loading = true
	anim.loading = true
	local trace = { "loading " .. tostring(name) .. " at " .. os.date("%H:%M:%S") }
	if has_files then pcall(writefile, root_dir .. "/load_trace.txt", trace[1] .. "\n(not finished)") end
	local function apply(flag, v)
		library.crumb("config setting: " .. tostring(flag))
		local setter = library.setters[flag]
		if not setter then return end
		if same_setting(flag, v) then return end
		-- load trace: the setting about to be applied is written to disk first, so if the game ever freezes during a
		-- load the last line of Aurelia/load_trace.txt names the setting that did it
		trace[#trace + 1] = tostring(flag)
		local began = os.clock()
		if type(v) == "table" and v.color then
			pcall(setter, Color3.new(v.color[1], v.color[2], v.color[3]), v.color[4])
		else
			pcall(setter, v)
		end
		local took = os.clock() - began
		if took > 0.05 then trace[#trace] = string.format("%s  (slow: %.2fs)", tostring(flag), took) end
	end

	local steps = {}
	for flag, default in pairs(library.defaults) do
		if flags[flag] == nil and not flag:find("^ui_") and not flag:find("^theme_") then
			local kind = typeof(default)
			if kind == "boolean" or kind == "number" or kind == "string" or kind == "Color3" then steps[#steps + 1] = { flag, default } end
		end
	end
	for flag, v in pairs(flags) do
		if library.bind_flags[flag] then steps[#steps + 1] = { flag, v } end
	end
	for flag, v in pairs(flags) do
		if not library.bind_flags[flag] then steps[#steps + 1] = { flag, v } end
	end
	local function finish()
		for _, bind in ipairs(library.binds) do
			if bind.turn and bind.state then
				if bind.mode == "hold" then
					if bind.state() then bind.turn(false) end
				elseif bind.mode == "always" and not bind.state() and bind.set_mode then
					bind.set_mode("press")
				end
			end
		end
		library.loading = false
		anim.loading = false
		task.delay(1.2, function()
			for _, redraw in ipairs(library.toggle_syncs or {}) do pcall(redraw) end
		end)
		trace[#trace + 1] = "finished, " .. tostring(#trace - 1) .. " settings changed"

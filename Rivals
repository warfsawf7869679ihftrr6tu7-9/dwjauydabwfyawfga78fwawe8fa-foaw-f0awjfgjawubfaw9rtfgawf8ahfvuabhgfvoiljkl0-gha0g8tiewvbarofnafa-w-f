library.notify = LPH_NO_VIRTUALIZE(function(text, icon_src, title, kind)
	if library.mute_notify then return end
	notif_count += 1
	title = title or setup.title
	local look = notif_kinds[kind]
	if look and not icon_src then icon_src = look[3] end

	local title_w, text_w = text_width(title, 13, true), text_width(text, 13, false)
	local width = clamp(math.ceil(36 + title_w + 9 + text_w + 14), 150, notif_max)

	local slot = new("Frame", { Size = UDim2.fromOffset(width, 0), BackgroundTransparency = 1, LayoutOrder = notif_count, Parent = notif_holder })
	local card, body = boxed({
		class = "CanvasGroup", parent = slot, size = UDim2.fromOffset(width, notif_h), radius = 9,
	})
	card.GroupTransparency = 1

	local style = notif_styles[notif.style] or notif_styles.Slide
	local from_side = notif.x > 0.5 and 1 or -1
	local rest = UDim2.fromOffset(width / 2, notif_h / 2)
	local start = UDim2.fromOffset(width / 2 + (style.dx or 0) * from_side, notif_h / 2 + (style.dy or 0))
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = start
	local card_scale = style.scale and new("UIScale", { Scale = style.scale, Parent = card }) or nil

	local badge = new("Frame", { Position = UDim2.fromOffset(6, 5), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = gray(255), Parent = body }, { corner(11) })
	if look then
		grad(badge, look[1], look[2], nil, true)
	else
		grad(badge, theme.acc_top, theme.acc_bot)
	end
	icon(badge, icon_src or "bell", 12, theme.window, UDim2.fromOffset(5, 5))

	new("TextLabel", {
		Position = UDim2.fromOffset(36, 0), Size = UDim2.new(0, title_w + 4, 1, 0), Text = title, TextSize = 13,
		FontFace = font(true), TextColor3 = theme.text_bright, TextXAlignment = Enum.TextXAlignment.Left, Parent = body,
	})
	new("TextLabel", {
		Position = UDim2.fromOffset(36 + title_w + 9, 0), Size = UDim2.new(1, -(36 + title_w + 9) - 10, 1, 0), Text = text, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = body,
	})

	tween(slot, { Size = UDim2.fromOffset(width, notif_h) }, 0.2)
	local arrive = TweenInfo.new(0.35, style.ease or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	tweens:Create(card, arrive, { Position = rest }):Play()
	if card_scale then tweens:Create(card_scale, arrive, { Scale = 1 }):Play() end
	tween(card, { GroupTransparency = 0 }, 0.25)

	local gone = false
	local function dismiss()
		if gone or not slot.Parent then return end
		gone = true
		tween(card, { GroupTransparency = 1, Position = start }, 0.25)
		if card_scale then tween(card_scale, { Scale = style.scale }, 0.25) end
		task.wait(0.2)
		tween(slot, { Size = UDim2.fromOffset(width, 0) }, 0.2)
		task.wait(0.25)
		slot:Destroy()
	end
	local click_conn
	click_conn = uis.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and menu_open and card.Parent and inside(card, mouse()) then dismiss() end
	end)
	slot.Destroying:Connect(function() click_conn:Disconnect() end)
	task.delay(notif.time, dismiss)
end)


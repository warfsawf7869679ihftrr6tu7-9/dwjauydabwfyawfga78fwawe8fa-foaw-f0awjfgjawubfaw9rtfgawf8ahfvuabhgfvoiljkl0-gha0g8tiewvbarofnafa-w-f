    pcall(function() gun = Engine.parts.context.Inner.ItemBehaviors:EquippedItemAsGun() end)
    local info = gun and gun.IsRaycast and gun.Info
    local dmg = info and tonumber(rawget(info, "ShootDamage"))
    if not dmg or dmg <= 0 then return want end
    local hp = math.max(target.AliveState.Health or 100, 1)
    local base = math.ceil(hp / dmg)
    local d = want
    while d > floorSt do
        if math.ceil(hp / (dmg * dropoffMult(info, d))) <= base then return d end
        d -= 2
    end
    return floorSt
end
function Engine.Standoff(target)

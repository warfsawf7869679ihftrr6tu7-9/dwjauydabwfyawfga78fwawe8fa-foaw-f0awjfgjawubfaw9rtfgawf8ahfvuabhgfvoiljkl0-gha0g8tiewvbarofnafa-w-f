			top = theme.list_top, bot = theme.list_bot, border = theme.list_border,
		})
		track.ZIndex = 2
		local count = #names
		local glide = new("Frame", {
			Position = UDim2.new(0, 2, 0, 2), Size = UDim2.new(1 / count, -4, 1, -4), BackgroundColor3 = theme.tab_fill, ZIndex = 3, Parent = track_fill,
		}, { corner(5), new("UIStroke", { Color = theme.tab_border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) })
		local group = { active = 1, folded = false, secs = {}, labels = {} }
		local function body_pos() return UDim2.fromOffset(8, 1 + top) end
		local function resize_group()

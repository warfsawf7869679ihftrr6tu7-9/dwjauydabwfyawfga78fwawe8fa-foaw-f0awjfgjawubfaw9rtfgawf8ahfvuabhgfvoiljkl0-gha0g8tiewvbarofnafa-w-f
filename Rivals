-- ItemLibrary: guns lose damage with distance (shotgun: full up to 10 studs, a third at 50). Linear in between.
local function dropoffMult(info, dist)
    local m = tonumber(rawget(info, "RaycastDamageDropoffMultiplier"))
    local from = tonumber(rawget(info, "RaycastDamageDropoffStartDistance"))
    local to = tonumber(rawget(info, "RaycastDamageDropoffEndDistance"))
    if not (m and from and to) or to <= from or dist <= from then return 1 end
    if dist >= to then return m end
    return 1 + (m - 1) * (dist - from) / (to - from)
end

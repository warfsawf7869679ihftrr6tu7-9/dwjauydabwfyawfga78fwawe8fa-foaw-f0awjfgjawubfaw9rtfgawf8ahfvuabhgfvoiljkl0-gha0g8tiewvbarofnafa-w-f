	local genv = getgenv()
	if type(genv.Fonts) ~= "table" then genv.Fonts = { Loaded = {} } end
	local store = genv.Fonts
	store.Loaded = store.Loaded or {}
	store.Bold = store.Bold or {}
	library.extra_fonts = {}

	local bold_of; bold_of = LPH_NO_VIRTUALIZE(function(regular)
		local ok, bold = pcall(function() return Font.new(regular.Family, Enum.FontWeight.Bold, regular.Style) end)
		return ok and bold or regular
	end)
	for _, pair in ipairs(BUILTIN) do
		local ok, enum = pcall(LPH_NO_VIRTUALIZE(function() return Enum.Font[pair[2]] end))
		if ok and enum then
			local regular = Font.fromEnum(enum)
			store.Loaded[pair[1]] = store.Loaded[pair[1]] or regular
			store.Bold[pair[1]] = store.Bold[pair[1]] or bold_of(regular)
			table.insert(UI_FONT_CHOICES, pair[1])
			table.insert(library.extra_fonts, pair[1])
		end
	end
	local web_names = {}
	for name in pairs(WEB) do web_names[#web_names + 1] = name end
	table.sort(web_names)
	for _, name in ipairs(web_names) do
		table.insert(UI_FONT_CHOICES, name)
		table.insert(library.extra_fonts, name)
	end

	-- a font dropdown's own list plus every extra font (no doubles, whatever the letter case)
	library.all_fonts = LPH_NO_VIRTUALIZE(function(base)
		local out, seen = {}, {}
		for _, name in ipairs(base) do
			out[#out + 1] = name
			seen[string.lower(name)] = true
		end
		for _, name in ipairs(library.extra_fonts) do
			if not seen[string.lower(name)] then
				out[#out + 1] = name
				seen[string.lower(name)] = true
			end
		end
		return out
	end)

	local load_web; load_web = LPH_NO_VIRTUALIZE(function(name)
		if store.Loaded[name] then return end
		local urls = WEB[name]
		if not (urls and has_files and getcustomasset) then return end
		local dir = root_dir .. "/fonts"
		if not isfolder(dir) then pcall(makefolder, dir) end
		local faces = {}
		for i, url in ipairs(urls) do
			local path = dir .. "/" .. name .. (i == 1 and "" or "-Bold") .. ".ttf"
			if not isfile(path) then
				local ok, data = pcall(function() return (game :: any):HttpGet(url) end)
				if ok and type(data) == "string" and #data > 1000 then pcall(writefile, path, data) end
			end
			if isfile(path) then
				local ok, asset = pcall(getcustomasset, path)
				if ok and asset and asset ~= "" then
					faces[#faces + 1] = { name = i == 1 and "Regular" or "Bold", weight = i == 1 and 400 or 700, style = "normal", assetId = asset }
				end
			end
		end
		if #faces == 0 then return end
		local family = dir .. "/" .. name .. ".font"
		pcall(writefile, family, http:JSONEncode({ name = name, faces = faces }))
		local ok, asset = pcall(getcustomasset, family)
		if not (ok and asset and asset ~= "") then return end
		pcall(function()
			local regular = Font.new(asset, Enum.FontWeight.Regular)
			store.Bold[name] = #faces > 1 and Font.new(asset, Enum.FontWeight.Bold) or regular
			store.Loaded[name] = regular
		end)
	end)
	-- every font is fetched in the background as soon as the script runs (only the first time, then they are on disk)
	if has_files and getcustomasset then
		local at = 0
		for _ = 1, 4 do
			task.spawn(LPH_NO_VIRTUALIZE(function()
				while true do
					at += 1
					local name = web_names[at]
					if not name then break end
					pcall(load_web, name)
				end
			end))
		end
	end

	local was_bold = setmetatable({}, { __mode = "k" })
	local serial = 0
	library.set_font = LPH_NO_VIRTUALIZE(function(name)
		serial += 1
		local mine = serial
		task.spawn(function()
			local picked
			if name ~= "Default" then
				if ESP_ENUMS[name] then
					local regular = Font.fromEnum(ESP_ENUMS[name])
					picked = { regular = regular, bold = bold_of(regular) }
				else
					local loaded
					for _ = 1, 120 do
						loaded = store.Loaded[name]
						if loaded or mine ~= serial then break end
						task.wait(0.5)
					end
					if mine ~= serial then return end
					if loaded then picked = { regular = loaded, bold = store.Bold[name] or loaded } end
				end
				if not picked then
					library.notify(name .. " could not be loaded", "x", "Font")
					return
				end
			end
			local old = { [font(false).Family] = true, [font(true).Family] = true }
			font_override = picked
			for _, d in ipairs(gui:GetDescendants()) do
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					local face = d.FontFace
					if old[face.Family] then
						if was_bold[d] == nil then was_bold[d] = face.Weight.Value >= 600 end
						d.FontFace = font(was_bold[d])
					end
				end
			end
		end)
	end)
end


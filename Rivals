gui.Destroying:Connect(LPH_NO_VIRTUALIZE(function()
	for flag, value in pairs(library.flags) do
		if value == true and not flag:find("^ui_") and not flag:find("^theme_") then
			local setter = library.setters[flag]
			if setter then pcall(setter, false) end
		end
	end
	for _, name in ipairs({ "AureliaViewTarget", "AureliaLegitAim", "AureliaStretch", "aurelia_custom_models", "AureliaAntiAimView", "AureliaDodge", "aurelia_view_player" }) do
		pcall(function() run:UnbindFromRenderStep(name) end)
	end
	for _, key in ipairs({ "AureliaChickenRed", "AureliaGC", "AureliaHackers", "AureliaHitBus", "AureliaLegit", "AureliaManipCheck", "AureliaOnShot", "AureliaRagebot", "AureliaSpoofLevel", "Ragebot" }) do
		pcall(function() getgenv()[key] = nil end)
	end
	local leftovers = {}
	for _, root in ipairs({ host, coregui, lp:FindFirstChild("PlayerGui"), game:GetService("Lighting"), workspace, workspace.CurrentCamera }) do
		if root then
			for _, obj in ipairs(root:GetChildren()) do
				local name = obj.Name
				if obj ~= gui and (name:sub(1, 7) == "Aurelia" or name:sub(1, 8) == "aurelia_") then leftovers[#leftovers + 1] = obj end
			end
		end
	end
	task.delay(0.5, function()
		for _, obj in ipairs(leftovers) do pcall(obj.Destroy, obj) end
	end)
end))


        local want = 0
        if view then
            if view.Name == "Riot Shield" then return 0 end
            want = meleeReach(view) + 8
        else
            local gun = obs:EquippedItemAsGun()
            local info = gun and rawget(gun.Inner, "Info")
            local radius = info and tonumber(rawget(info, "ShootExplosionRadius")) or 0
            if radius > 0 then want = radius + 8 end
            local custom = obs:EquippedItemAsCustom()
            if custom and custom.Name == "Flamethrower" then
                want = math.max(want, (tonumber(rawget(rawget(custom.Inner, "Info") or {}, "Reach")) or 26) + 8)
            end
        end
        if want <= 0 then return 0 end
        want = math.clamp(math.max(S.MeleeStandoff, want), 0, 40)
        return fitStandoff(want, target, math.min(want, S.MeleeStandoff))
    end)
    return ok and v or 0
end

function Engine.Start()
    if Engine.running then return true end
    local parts = {}

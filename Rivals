    Engine.running = false
    if Engine.hb then Engine.hb:Disconnect() Engine.hb = nil end
    Engine.SetEnabled(false)
    local parts = Engine.parts
    Engine.parts = nil
    if parts then
        for _, name in ipairs({ "rage", "glue", "hook", "context", "fighters" }) do
            local p = parts[name]
            if p and p.Destroy then pcall(p.Destroy, p) end
        end
    end
    Engine.Target = nil
end

return Engine


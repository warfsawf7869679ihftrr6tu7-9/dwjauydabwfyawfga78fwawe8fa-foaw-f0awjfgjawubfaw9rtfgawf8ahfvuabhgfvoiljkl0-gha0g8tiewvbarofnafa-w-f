local has_files = not not (writefile and readfile and isfile and isfolder and makefolder and listfiles and delfile)

if has_files then
	local old_dir = isfolder("Solstice") and "Solstice" or "Meridian"
	local first_run = not isfolder(root_dir)

	for _, dir in ipairs({ root_dir, icon_dir, config_root, config_dir, root_dir .. "/themes" }) do
		if not isfolder(dir) then pcall(makefolder, dir) end
	end
	-- autoload.txt in this folder now holds the script copy; an older small one is the autoloaded config name
	pcall(LPH_NO_VIRTUALIZE(function()
		local old_pick = config_dir .. "/autoload.txt"
		if isfile(old_pick) and not isfile(autoload_file) then
			local text = readfile(old_pick)
			if #text < 500 then
				writefile(autoload_file, text)
				delfile(old_pick)
			end
		end
	end))
	if not isfile(autoload_file) and isfile(root_dir .. "/autoload.txt") then
		pcall(LPH_NO_VIRTUALIZE(function()
			writefile(autoload_file, readfile(root_dir .. "/autoload.txt"))
			delfile(root_dir .. "/autoload.txt")
		end))
	end
	local listed, loose = pcall(listfiles, config_root)
	for _, path in ipairs(listed and type(loose) == "table" and loose or {}) do
		local name = tostring(path):match("([^/\\]+)%.json$")
		local target = name and config_dir .. "/" .. name .. ".json"
		if target and isfile(path) and not isfile(target) then
			local read, body = pcall(readfile, path)
			if read and type(body) == "string" and not body:find('"game":"OperationOne"', 1, true) and pcall(writefile, target, body) then pcall(delfile, path) end
		end
	end

	if first_run and old_dir ~= root_dir and isfolder(old_dir) then
		pcall(LPH_NO_VIRTUALIZE(function()
			local rivals_configs = config_root .. "/Rivals"
			if not isfolder(rivals_configs) then makefolder(rivals_configs) end
			for _, sub in ipairs({ "configs", "themes" }) do
				if isfolder(old_dir .. "/" .. sub) then
					local into = sub == "configs" and rivals_configs or root_dir .. "/themes"
					for _, path in ipairs(listfiles(old_dir .. "/" .. sub)) do
						local name = path:match("([^/\\]+)$")
						if name then writefile(into .. "/" .. name, readfile(path)) end
					end
				end
			end
			for from, to in pairs({ ["session.json"] = "session_Rivals.json", ["autoload.txt"] = "autoload_Rivals.txt" }) do
				if isfile(old_dir .. "/" .. from) then writefile(root_dir .. "/" .. to, readfile(old_dir .. "/" .. from)) end
			end
		end))
	end
end


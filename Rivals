		air:toggle({ name = "Auto Strafe", tip = "In the air it curves you the way you turn the mouse (or press A and D) and builds speed. Use it with Bunny Hop.", flag = "misc_autostrafe", callback = LPH_NO_VIRTUALIZE(function(on)

local mineList, mineAt = {}, 0
local function refreshMines(now)
    if now < mineAt then return end
    mineAt = now + 0.25
    table.clear(mineList)
    local myTeam = lpl:GetAttribute("TeamID")
    local myMatch = lpl:GetAttribute("EnvironmentID")
    local me = typeof(Engine.Client) == "CFrame" and Engine.Client.Position or nil
    for _, m in ipairs(CollectionService:GetTagged("SubspaceTripmine")) do
        local hb = m:FindFirstChild("Hitbox")
        if hb and hb:IsA("BasePart") then
            local placedBy, team = m:GetAttribute("PlacedByUserID"), m:GetAttribute("TeamID")
            local match = m:GetAttribute("EnvironmentID")
            local mine = (match == nil or myMatch == nil or match == myMatch) and (me == nil or (hb.Position - me).Magnitude < 1200)
            if mine and placedBy ~= lpl.UserId and not (myTeam ~= nil and team == myTeam) then
                mineList[#mineList + 1] = hb
                if Engine.Settings.AvoidTripmines then
                    pcall(function()
                        if hb.CanTouch then hb.CanTouch = false end
                        for _, d in ipairs(m:GetDescendants()) do
                            if d:IsA("BasePart") and d.CanTouch then d.CanTouch = false end
                        end
                    end)
                end
            end
        end
    end
end

local zones = { at = 0, out = {}, safe = {}, kill = {} }
local function within(part, pos, pad)
    local l = part.CFrame:PointToObjectSpace(pos)
    local h = part.Size * 0.5
    return math.abs(l.X) <= h.X + pad and math.abs(l.Y) <= h.Y + pad and math.abs(l.Z) <= h.Z + pad
end
local function collect(tag, into)
    table.clear(into)
    for _, p in ipairs(CollectionService:GetTagged(tag)) do
        if p:IsA("BasePart") and p:IsDescendantOf(workspace) then into[#into + 1] = p end
    end
end
function Engine.Unsafe(pos)
    local now = os.clock()
    if now >= zones.at then
        zones.at = now + 1
        collect("OutOfBoundsPart", zones.out)
        collect("OutOfBoundsSafePart", zones.safe)
        collect("KillBrick", zones.kill)
    end
    local floor = workspace.FallenPartsDestroyHeight
    if floor == floor and pos.Y < floor + 8 then return true end
    for _, p in ipairs(zones.kill) do
        if p.Parent and within(p, pos, 4) then return true end
    end
    if zones.game == nil then
        local ok, mod = pcall(function() return require(ReplicatedStorage.Modules.GameplayUtility) end)
        zones.game = ok and type(mod) == "table" and mod or false
    end
    if zones.game then
        local ok, part = pcall(zones.game.IsWithinOOBPart, zones.game, pos)
        if ok then
            if part ~= nil then return true end
            for _, p in ipairs(zones.out) do
                if p.Parent and within(p, pos, 4) then return true end
            end
            return false
        end
    end
    for _, p in ipairs(zones.safe) do
        if p.Parent and within(p, pos, 0) then return false end
    end
    for _, p in ipairs(zones.out) do
        if p.Parent and within(p, pos, 4) then return true end
    end
    return false
end

local function nearMine(pos)
    local S = Engine.Settings
    if not S.AvoidTripmines then return false end
    refreshMines(os.clock())
    for _, hb in ipairs(mineList) do
        if hb.Parent and (hb.Position - pos).Magnitude <= hb.Size.Magnitude * 0.5 + S.MineMargin then return true end
    end
    return false
end

-- How far my own melee weapon reaches (nil when I hold no melee weapon).
function Engine.MyReach()
    if not Engine.MeleeMode then return nil end
    local reach = 6
    pcall(function()
        local view = Engine.parts.context.Inner.ItemBehaviors:EquippedItemAsMelee()
        local info = view and view.Info
        if info then reach = math.max(tonumber(rawget(info, "AttackReach")) or 6, tonumber(rawget(info, "HeavyAttackReach")) or 0) end
    end)
    return reach
end
-- A tripmine goes off when something touches its small box, and then hurts everything within 12 studs. The spot I attack
-- from is straight above (or below) the target, so instead of hiding I move further out along that line until every enemy
-- mine is far enough away. With a gun that is the full Keep Away distance; with a melee weapon I only need to stay off the
-- mine's box, and I can never go further than my weapon reaches. Returns nil when no safe spot exists.
function Engine.MineLift(target, up, offset)
    local S = Engine.Settings
    if not S.AvoidTripmines then return 0 end
    refreshMines(os.clock())
    if #mineList == 0 then return 0 end
    local reach = Engine.MyReach()
    local ok, lift = pcall(function()
        local base = target.AliveState.RootPart.Position + Vector3.new(0, 1.5, 0) + (offset or Vector3.zero)
        local dir = up and 1 or -1
        local total = 0
        for _ = 1, 4 do
            local moved = false
            for _, hb in ipairs(mineList) do
                if hb.Parent then
                    local safe = reach and 6.5 or (hb.Size.Magnitude * 0.5 + S.MineMargin)
                    local d = hb.Position - (base + Vector3.new(0, total * dir, 0))
                    local flat = d.X * d.X + d.Z * d.Z
                    if flat + d.Y * d.Y < safe * safe then
                        local extra = (d.Y + math.sqrt(safe * safe - flat) * dir) * dir
                        if extra > 0 then
                            total += extra + 0.25
                            moved = true
                        end
                    end
                end
            end
            if not moved then break end
        end
        return total
    end)
    if not ok then return 0 end
    local cap = reach and math.max(reach - 2, 2) or 45
    if lift > cap then return nil end
    return lift
end
-- Strafe: circle the target instead of sitting still above it. Off while Stick to Target is on. With a melee weapon the
-- circle is pulled in so the target stays inside my reach.
local strafeState = { angle = math.random() * 6.283, dir = 1, flipAt = 0, last = 0 }
function Engine.StrafeOffset(waiting, target)
    local S = Engine.Settings
    if not S.Strafe then return Vector3.zero end
    local now = os.clock()
    local st = strafeState
    local dt = math.clamp(now - st.last, 0, 0.1)
    st.last = now
    -- the circle changes direction at random moments and breathes in and out a little, so nobody can time where I will be
    if now >= st.flipAt then
        st.flipAt = now + 1.2 + math.random() * 2.6
        if math.random() < 0.5 then st.dir = -st.dir end
    end
    st.angle = (st.angle + st.dir * S.StrafeSpeed * math.pi * 2 * dt) % (math.pi * 2)
    local dist, height = S.StrafeDist * (1 + 0.15 * math.sin(now * 1.7)), S.StrafeHeight
    local reach = Engine.MyReach()
    if waiting then
        local keep = target and Engine.Standoff(target) or 0
        if dist < keep then dist = keep end
    elseif reach then
        local limit = math.max(reach - 2, 2)
        local len = math.sqrt(dist * dist + height * height)
        if len > limit then dist, height = dist * limit / len, height * limit / len end
    end
    return Vector3.new(math.cos(st.angle) * dist, height, math.sin(st.angle) * dist)
end
-- Stay on the target between attacks (no trip out to hide and back): when Always On Target is ticked, and always while strafing.
function Engine.Stay()
    local S = Engine.Settings
    return S.AlwaysOn == true or S.Strafe == true
end

-- A voider: an enemy seen out past the position limit in the last few seconds (a hiding ragebot).
local voidSeen = setmetatable({}, { __mode = "k" })
function Engine.IsVoider(target)

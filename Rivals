		if busy then return "Busy" end
		if not force and os.clock() - last_call < 3 then return "Wait a moment" end
		busy, last_call = true, os.clock()
		task.spawn(function()
			local out, err = fetch_all()
			busy = false
			if out then
				entries, loaded = out, true
				render()
				library.notify(#out .. " servers loaded", "server", "Servers")
			else
				library.notify(err, "x", "Servers")
			end
		end)
		return "Loading..."
	end)

	local join; join = LPH_NO_VIRTUALIZE(function(id)
		local ok = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, id, lp) end)
		library.notify(ok and "Joining server..." or "Could not join that server", ok and "server" or "x", "Servers")
		return ok and "Joining" or "Failed"
	end)

	local usable; usable = LPH_NO_VIRTUALIZE(function()
		local out = {}
		for _, e in ipairs(entries) do
			if not e.current and e.playing < e.max then out[#out + 1] = e end
		end
		return out
	end)

	local selected_entry; selected_entry = LPH_NO_VIRTUALIZE(function()
		for _, e in ipairs(entries) do
			if e.id == selected then return e end
		end
	end)

	sec:buttons({
		{ name = "Refresh", tip = "Loads the current server list for this game.", callback = LPH_NO_VIRTUALIZE(function() return refresh() end) },
		{ name = "Join Server", tip = "Joins the server you selected in the list.", callback = LPH_NO_VIRTUALIZE(function()
			local e = selected_entry()
			if not e then library.notify("Select a server first", "x", "Servers") return "Select one" end
			if e.current then library.notify("You are already in that server", "x", "Servers") return "You are here" end
			if e.playing >= e.max then library.notify("That server is full", "x", "Servers") return "Full" end
			return join(e.id)
		end) },
		{ name = "Hop Best Ping", tip = "Joins the server with the lowest ping that has room. Press Refresh first for fresh numbers.", callback = LPH_NO_VIRTUALIZE(function()
			local best
			for _, e in ipairs(usable()) do
				if e.ping and (not best or e.ping < best.ping) then best = e end
			end
			if not best then library.notify(loaded and "No server with a ping reading found" or "Press Refresh first", "x", "Servers") return "No server" end
			return join(best.id)
		end) },
	}, 4)
	sec:buttons({
		{ name = "Hop Random", tip = "Joins a random server that has room.", callback = LPH_NO_VIRTUALIZE(function()
			local list = usable()
			if #list == 0 then library.notify(loaded and "No open servers found" or "Press Refresh first", "x", "Servers") return "No server" end
			return join(list[math.random(#list)].id)
		end) },
		{ name = "Copy Job ID", tip = "Copies the selected server's ID, or your current one if none is selected.", callback = LPH_NO_VIRTUALIZE(function()
			if not setclipboard then return "No clipboard" end
			local e = selected_entry()
			setclipboard(e and e.id or game.JobId)
			return "Copied"
		end) },
		{ name = "Copy Join Script", tip = "Copies a one-line script that joins the selected server (or your current one).", callback = LPH_NO_VIRTUALIZE(function()
			if not setclipboard then return "No clipboard" end
			local e = selected_entry()
			setclipboard(('game:GetService("TeleportService"):TeleportToPlaceInstance(%d, "%s", game.Players.LocalPlayer)'):format(game.PlaceId, e and e.id or game.JobId))
			return "Copied"
		end) },
	})
	sec:stretch(list_row, 140)

	task.spawn(LPH_NO_VIRTUALIZE(function()
		while not loaded do
			task.wait(0.3)
			if servers_tab.frame.Visible and not busy then
				refresh(true)
				break
			end
		end
	end))
end)()


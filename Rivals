		local function hookRewardUse()
			if rewardUse then return end
			local module = lps.Modules:FindFirstChild("Prompts") and lps.Modules.Prompts:FindFirstChild("InspectBackpackReward")
			local class = module and safeRequireModule(module)
			if not (class and type(class.Use) == "function") then return end
			local original = class.Use
			rewardUse = { class = class, original = original }
			class.Use = function(prompt, quantity, ...)
				local item = INV.meta[rawget(prompt, "_reward_data")]
				if not item then return original(prompt, quantity, ...) end
				local n = math.clamp(math.floor(tonumber(quantity) or 1), 1, item.q)
				local ok, why = true, nil
				if item.k == "box" then
					ok, why = openBox(item.n, n)
				elseif item.k == "cosmetic" then
					INV.unlocked[item.n] = true
					refreshField("CosmeticInventory")
				end
				if ok then
					item.q -= n
					rebuildEntries()
					if saveInventory then saveInventory() end
					refreshField("UnclaimedRewards")
					pcall(function() prompt:CloseRequest() end)
				elseif why then
					library.notify(tostring(why), "x", "Inventory")
				end
				return nil
			end
		end

		-- rank charms: the "Season N" charms pick which rank model to keep from the equipped charm's SeasonELO and show
		-- SeasonLeaderboardRank as "#N". Nemesis and Archnemesis share 3600 ELO (Archnemesis = top 200), so those two use a
		-- marker ELO that the hook below turns into the right rank while still showing your own number.
		local seasonLib
		pcall(function() seasonLib = safeRequireModule(rmods:WaitForChild("SeasonLibrary", 10)) end)
		local RANK_MARK = { Nemesis = 3600.25, Archnemesis = 3600.75 }
		local function rankPlace(rank)
			local places = library.flags.cos_rank_places
			local v = type(places) == "table" and rank and places[rank]
			if v == nil then v = library.flags.cos_rank_place end
			local n = tonumber((tostring(v or ""):gsub("[#%s]", "")))
			return n and n >= 1 and math.clamp(math.floor(n), 1, 999999) or nil
		end
		local function rankProfile()
			local p = seasonLib and seasonLib.RankProfiles and seasonLib.RankProfiles.ranks_version1

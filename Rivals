local mv = {}
local function scanHackers(now)
    local tags = Engine.parts and Engine.parts.tags
    if not tags then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lpl then
            local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            local rec = mv[plr]
            if not rec then rec = { fastFor = 0, flagUntil = 0 } mv[plr] = rec end
            if root then
                local p = root.Position
                if math.abs(p.X) >= 4194304 or math.abs(p.Y) >= 4194304 or math.abs(p.Z) >= 4194304 then
                    rec.flagUntil = now + 15
                elseif rec.pos and now > rec.t then
                    local dt = now - rec.t
                    local d = p - rec.pos
                    local flat = Vector3.new(d.X, 0, d.Z).Magnitude
                    if flat > 150 then rec.fastFor = 0
                    elseif flat / dt > 90 then
                        rec.fastFor += dt
                        if rec.fastFor >= 0.5 then rec.flagUntil = now + 15 end
                    else rec.fastFor = 0 end
                end
                rec.pos, rec.t = p, now
            end
            local genv = K.fn("getgenv")
            local found = genv and genv().AureliaHackers
            if type(found) == "table" and found[plr] then rec.flagUntil = now + 15 end
            if now < rec.flagUntil then tags:Add(plr, "Hacker") else tags:Remove(plr, "Hacker") end
        end
    end
end


local spamState = { phase = nil, endsAt = 0, cf = nil }
function Engine.VoidSpamSpot(now)
    local S = Engine.Settings
    if not S.VoidSpam then
        spamState.phase = nil
        return nil
    end
    if not spamState.phase or spamState.endsAt <= now then
        if spamState.phase == "hide" then
            spamState.phase, spamState.endsAt = "attack", now + math.clamp(S.VoidOut, 0.01, 3) + (Engine.Settle or 0)
        else
            spamState.phase, spamState.endsAt = "hide", now + math.clamp(S.VoidIn, 0.05, 5)
            spamState.cf = CFrame.new(math.random(67108864, 134217728), 0, math.random(67108864, 134217728))
        end
    end
    return spamState.phase == "hide" and spamState.cf or nil
end

function Engine.SafeSpot(client)
    local origin = client.Position
    rayParams.FilterDescendantsInstances = { lpl.Character, workspace.CurrentCamera }
    local enemies = {}
    pcall(function()
        for _, st in pairs(Engine.parts.fighters.EnemyByPlayer) do
            if st.Character.State.Alive then enemies[#enemies + 1] = st.Character.State.RootPart.Position end
        end
    end)
    local barriers = CollectionService:GetTagged("Barrier")
    for attempt = 1, 24 do
        local a, r = math.random() * math.pi * 2, math.random(35, 100)
        local hit = workspace:Raycast(origin + Vector3.new(math.cos(a) * r, 50, math.sin(a) * r), Vector3.new(0, -100, 0), rayParams)
        if hit then
            local at = hit.Position + Vector3.new(0, 3, 0)
            local good = not Engine.Unsafe(at) and not nearMine(at)
            if good then
                for _, b in ipairs(barriers) do
                    if b:IsA("BasePart") and within(b, at, 1) then good = false break end
                end
            end
            if good and attempt <= 16 then
                for _, e in ipairs(enemies) do
                    if (e - at).Magnitude < 30 then good = false break end
                end
            end
            if good then return client - origin + at end
        end
    end
    return nil
end

local safeHold = { spot = nil, untilAt = 0 }
function Engine.HoldSafeSpot(client)
    local now = os.clock()
    local spot = safeHold.spot
    if not spot or now >= safeHold.untilAt or (spot.Position - client.Position).Magnitude > 160 or nearMine(spot.Position) then
        spot = Engine.SafeSpot(client)
        safeHold.spot, safeHold.untilAt = spot, now + 1.5
    end
    return spot
end

local trans = { part = nil, env = nil, offset = nil, refreshAt = 0, origin = nil }
local function transValid(part)
    return part ~= nil and part:IsA("BasePart") and part:IsDescendantOf(workspace)
        and CollectionService:HasTag(part, "OutOfBoundsPart") and part:GetAttribute("KillDelay") == 0
end
local function transSpot(part, origin, offset)
    local rel = part.CFrame:PointToObjectSpace(origin)
    local half = part.Size * 0.5
    local hx, hz = math.max(half.X - 2, 0), math.max(half.Z - 2, 0)
    return part.CFrame * CFrame.new(math.clamp(rel.X, -hx, hx), -half.Y + offset, math.clamp(rel.Z, -hz, hz))
end
function Engine.Translocate(client, offset)
    local origin = client.Position
    offset = math.clamp(tonumber(offset) or -5, -20, -3)
    local env = lpl:GetAttribute("EnvironmentID")
    local now = os.clock()
    if trans.env ~= env or trans.offset ~= offset then
        trans.part, trans.env, trans.offset, trans.refreshAt = nil, env, offset, 0
    end
    local part = trans.part
    local fresh = now < trans.refreshAt and trans.origin ~= nil and (origin - trans.origin).Magnitude < 12
    if not (fresh and transValid(part)) then
        local best, bestDist, bestShared = nil, math.huge, math.huge
        for _, p in ipairs(CollectionService:GetTagged("OutOfBoundsPart")) do
            if transValid(p) then
                local partEnv = p:GetAttribute("EnvironmentID")
                if env == nil or partEnv == nil or partEnv == env then
                    local shared = (env ~= nil and partEnv == nil) and 1 or 0
                    local dist = (transSpot(p, origin, offset).Position - origin).Magnitude
                    if p == trans.part then dist = math.max(dist - 4, 0) end
                    if shared < bestShared or (shared == bestShared and dist < bestDist) then
                        best, bestDist, bestShared = p, dist, shared
                    end
                end
            end
        end
        part = best
        trans.part, trans.origin, trans.refreshAt = best, origin, now + 0.25
    end
    if not part then return nil end
    return client + (transSpot(part, origin, offset).Position - origin)
end

-- Hide spots tune themselves (no sliders). Every 0.25 s they look at the enemies: what can reach me through or around a floor
-- (melee reach, explosion radius, flamethrower reach) and whether the target is a voider (a ragebot that glues itself to me,
-- so anywhere inside the map is in its reach).
--   Underground: just deep enough to clear the biggest reach, 8 to 14 studs (hitscan needs a line of sight), never into a
--     kill brick or near the fall-death height, and moved sideways off anyone whose reach/splash would cover me. Against a
--     voider it uses the translocate window instead (ragebots with anti translocate skip players there), if the map has one.
--   Translocate: against a voider it stays inside the window anti translocate checks look at (within 11 studs of the zone's
--     bottom), so their ragebot drops me as a target; against normal players it goes as deep as allowed.
--   Void and Random already sit past the position limit, where neither a ragebot nor a normal player can hit me.
local hideProf = { at = 0, key = nil, reach = 0, splash = false, voider = false, threats = {} }
local function threatReach(st)
    local obs = st.ItemObserver
    local melee = obs:EquippedItemAsMelee()
    if melee then return meleeReach(melee), false end
    local gun = obs:EquippedItemAsGun()
    local info = gun and rawget(gun.Inner, "Info")
    local radius = info and tonumber(rawget(info, "ShootExplosionRadius")) or 0
    if radius > 0 then return radius, true end
    local custom = obs:EquippedItemAsCustom()
    if custom and custom.Name == "Flamethrower" then
        return tonumber(rawget(rawget(custom.Inner, "Info") or {}, "Reach")) or 26, true
    end
    return 0, false
end

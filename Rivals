		end
		local function rankList()
			local out, p = {}, rankProfile()
			for _, name in ipairs(p and p.RanksOrder or {}) do
				local info = p.Ranks[name]
				if name ~= "Unranked" and info then out[#out + 1] = { Name = name, Display = info.DisplayName or name, Image = info.Image or "", ELO = info.RequiredELO or 0 } end
			end
			return out
		end
		local function rankCharm(d, base, rank, place)
			local p = rankProfile()
			local info = p and p.Ranks[rank]
			if not info then return end
			if place == nil then place = rankPlace(rank) end
			d.__key = base .. "#" .. rank
			d.__share = d.__key .. "#" .. (place and tostring(place) or "")
			d.Metadata = table.clone(type(d.Metadata) == "table" and d.Metadata or {})
			if RANK_MARK[rank] then
				d.Metadata.SeasonELO = RANK_MARK[rank] + (place or 0) / 1e7
				d.Metadata.SeasonLeaderboardRank = nil
			else
				d.Metadata.SeasonELO = info.RequiredELO
				d.Metadata.SeasonLeaderboardRank = place
			end
		end
		-- names that come in through Shared Skins: "Season 3#Gold 1#5" = that season's charm, that rank, place 5
		local function cloneShared(name, kind)
			local base, rank, place = name:match("^(Season %d+)#([^#]+)#?(%d*)$")
			if not base then return clonecos(name, kind) end
			local d = clonecos(base, kind)
			local n = tonumber(place)
			if d then rankCharm(d, base, rank, n and math.clamp(math.floor(n), 1, 999999) or false) end
			return d
		end
		if seasonLib then
			pcall(function()
				local cvf = safeRequireModule(lp.PlayerScripts.Modules.CosmeticViewportFrame)
				local orig = type(cvf) == "table" and rawget(cvf, "_SetupSeasonRankCharm")
				if type(orig) ~= "function" then return end
				rawset(cvf, "_SetupSeasonRankCharm", function(self, model, ...)
					local name = type(self) == "table" and self.Name
					local mine
					if type(name) == "string" then
						for _, slot in pairs(equip) do
							local c = slot.Charm
							if type(c) == "table" and c.Name == name and type(c.Metadata) == "table" and c.Metadata.SeasonELO then mine = c break end
						end
					end
					if mine then
						local season = seasonLib.SeasonsByVersion and seasonLib.SeasonsByVersion[tonumber(name:sub(8))]
						if season then
							return seasonLib:FormatSeasonRankCharm(model, season.Name, mine.Metadata.SeasonELO, mine.Metadata.SeasonLeaderboardRank)
						end
					end
					return orig(self, model, ...)
				end)
			end)
		end
		if seasonLib and type(seasonLib.FormatSeasonRankCharm) == "function" then
			local format = seasonLib.FormatSeasonRankCharm
			seasonLib.FormatSeasonRankCharm = function(self, model, season, elo, place, ...)
				if type(elo) == "number" and elo > 3600.2 and elo < 3601 then
					local arch = elo >= 3600.7
					local p = math.floor((elo - (arch and RANK_MARK.Archnemesis or RANK_MARK.Nemesis)) * 1e7 + 0.5)
					local res = table.pack(format(self, model, season, 3600, arch and 1 or nil, ...))
					pcall(function()

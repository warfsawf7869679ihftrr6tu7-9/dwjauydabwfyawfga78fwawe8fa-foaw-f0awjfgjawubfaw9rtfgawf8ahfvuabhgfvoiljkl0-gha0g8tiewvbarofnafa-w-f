				if V.moving and Vector3.new(v.X, 0, v.Z).Magnitude > 1 then table.insert(Flags, "moving") end
				if V.jumping and v.Y > 4 then table.insert(Flags, "jumping") end
				if V.falling and v.Y < -4 then table.insert(Flags, "falling") end
			end

			local fighter = wants_fighter and fighter_of(Player)
			if fighter then
				if V.crouching and try(function() return fighter:Get("IsCrouching") end) then table.insert(Flags, "crouching") end
				if V.invincible and try(function() return fighter.Entity:Get("IsInvincible") end) then table.insert(Flags, "invincible") end

				local item = fighter.EquippedItem
				if item then
					local now = tick()
					if V.aiming and try(function() return item:Get("IsAiming") end) then table.insert(Flags, "aiming") end
					if V.equipping and try(function() return item:IsEquipping() end) then table.insert(Flags, "equipping") end

					local shoot, reload = item._shoot_cooldown, item._reload_cooldown
					if V.shooting and type(shoot) == "number" and shoot ~= math.huge and now < shoot then table.insert(Flags, "shooting") end
					if V.reloading and type(reload) == "number" and reload ~= math.huge and now < reload then table.insert(Flags, "reloading") end

					if V.deflecting then
						local deflecting = try(function()
							return type(item._deflect_cooldown) == "number" and now < item._deflect_cooldown - (item.Info.DeflectCooldown or 0)
